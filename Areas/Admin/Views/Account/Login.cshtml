@model CoffeeShop.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập quản trị";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coffee Blend Admin</title>
    <link rel="stylesheet" href="~/admin/admin.css" />
    <style>
        body { display: grid; min-height: 100vh; place-items: center; padding: 24px; }
        .admin-login { width: min(430px, 100%); }
        .admin-login .panel { padding: 30px; }
        .admin-login .brand { padding: 0 0 24px; }
        .admin-login .eyebrow { margin-top: 18px; }
        .admin-login h1 { margin-bottom: 8px; }
        .admin-login .page-subtitle { margin-bottom: 22px; }
        .admin-login .dialog-form { padding: 0; }
        .admin-login .button { width: 100%; margin-top: 5px; }
        .admin-login .login-error { margin-bottom: 16px; padding: 10px 12px; border-radius: 8px; background: #fff0ee; color: #ad5142; font-size: 11px; }
        .admin-login .login-help { margin-top: 18px; color: var(--muted); font-size: 10px; text-align: center; }
        .admin-login .login-help a { color: var(--coffee); font-weight: 700; }
    </style>
</head>
<body>
<main class="admin-login">
    <section class="panel">
        <a class="brand" asp-area="Admin" asp-controller="Account" asp-action="Login">
            <span class="brand-mark">C</span>
            <span class="brand-copy">Coffee<small>Blend · ADMIN</small></span>
        </a>
        <div class="eyebrow">KHU VỰC QUẢN TRỊ</div>
        <h1>Đăng nhập Admin</h1>
        <p class="page-subtitle">Sử dụng tài khoản quản trị để tiếp tục.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="login-error">@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
        }

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" class="dialog-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <label>Tên đăng nhập
                <input asp-for="Username" autocomplete="username" autofocus required />
            </label>
            <label>Mật khẩu
                <input asp-for="Password" type="password" autocomplete="current-password" required />
            </label>
            <label class="d-flex flex-row align-items-center" style="gap:8px;">
                <input asp-for="RememberMe" type="checkbox" /> Ghi nhớ phiên Admin
            </label>
            <button class="button button-primary" type="submit">Đăng nhập quản trị</button>
        </form>
        <p class="login-help">Tài khoản khách hàng? <a asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập cửa hàng</a></p>
    </section>
</main>
</body>
</html>