@model CoffeeShop.Models.ViewModels.CustomerManagementViewModel
@{
    ViewData["Title"] = "Khách hàng";
}

<div class="welcome-row page-title-row">
    <div>
        <div class="eyebrow">HỆ THỐNG &amp; CRM</div>
        <h1>Khách hàng</h1>
        <p class="page-subtitle">Quản lý hồ sơ, tài khoản và trạng thái thành viên.</p>
    </div>
    <button type="button" class="button button-primary btn-add js-create-customer" data-url="@Url.Action("Create", "KhachHang", new { area = "Admin" })">
        + Thêm khách hàng
    </button>
</div>

<section class="panel table-panel">
    <div class="panel-heading table-card-header customer-list-heading">
        <div>
            <h2>Danh sách khách hàng</h2>
            <p>Tổng cộng @Model.CustomerAccountCount khách hàng; @Model.ActiveCustomerCount đang hoạt động, @Model.LockedCustomerCount đã khóa.</p>
        </div>
    </div>
    <form asp-area="Admin" asp-controller="KhachHang" asp-action="Index" method="get" class="customer-filter-form" role="search">
        <div class="customer-filter-search">
                <input type="search" name="search" value="@Model.Search" class="form-control account-search"
                       placeholder="Tìm tên, tài khoản, email, số điện thoại..." aria-label="Tìm khách hàng" />
        </div>
        <label>Trạng thái
            <select name="status" class="form-control">
                <option value="all" selected="@(Model.Status == "all")">Tất cả</option>
                <option value="active" selected="@(Model.Status == "active")">Hoạt động</option>
                <option value="locked" selected="@(Model.Status == "locked")">Đã khóa</option>
            </select>
        </label>
        <label>Hạng thẻ
            <select name="tier" class="form-control">
                <option value="">Tất cả</option>
                @foreach (var tier in new[] { "Đồng", "Bạc", "Vàng", "Kim Cương" })
                {
                    <option value="@tier" selected="@(Model.Tier == tier)">@tier</option>
                }
            </select>
        </label>
        <label>Nhóm tuổi
            <select name="ageGroup" class="form-control">
                <option value="">Tất cả</option>
                <option value="under18" selected="@(Model.AgeGroup == "under18")">Dưới 18</option>
                <option value="18-24" selected="@(Model.AgeGroup == "18-24")">18–24</option>
                <option value="25-34" selected="@(Model.AgeGroup == "25-34")">25–34</option>
                <option value="35-44" selected="@(Model.AgeGroup == "35-44")">35–44</option>
                <option value="45plus" selected="@(Model.AgeGroup == "45plus")">45 trở lên</option>
                <option value="missing" selected="@(Model.AgeGroup == "missing")">Chưa khai báo</option>
            </select>
        </label>
        <label>Sở thích
            <select name="interest" class="form-control">
                <option value="">Tất cả</option>
                @foreach (var item in Model.InterestOptions)
                {
                    <option value="@item" selected="@(Model.Interest == item)">@item</option>
                }
            </select>
        </label>
        <button type="submit" class="button button-primary">Lọc</button>
        <a asp-action="Index" class="button button-outline">Xóa lọc</a>
    </form>

    <div class="table-scroll">
        <table class="data-table admin-data-table admin-table--customers custom-admin-table" id="customerTable">
            <thead>
                <tr>
                    <th>HỌ VÀ TÊN</th>
                    <th>LIÊN HỆ</th>
                    <th>ĐIỂM</th>
                    <th>HẠNG THẺ</th>
                    <th>SỐ ĐƠN</th>
                    <th>NGÀY THAM GIA</th>
                    <th>TRẠNG THÁI</th>
                    <th>THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    var tierBadgeClass = customer.HangTV switch
                    {
                        "Kim Cương" => "tier-diamond",
                        "Vàng" => "tier-gold",
                        "Bạc" => "tier-silver",
                        _ => "tier-bronze"
                    };
                    <tr class="customer-row" data-url="@Url.Action("Details", "KhachHang", new { area = "Admin", id = customer.MaKH })" tabindex="0" role="button" aria-label="Xem chi tiết khách hàng @customer.HoTen">
                        <td class="customer-name-cell">
                            <strong>@customer.HoTen</strong>
                            <small>@(string.IsNullOrWhiteSpace(customer.TaiKhoan) ? "Khách vãng lai" : customer.TaiKhoan)</small>
                        </td>
                        <td class="customer-contact-cell">
                            <span>@customer.Sdt</span>
                            <small>@(string.IsNullOrWhiteSpace(customer.Email) ? "Chưa có email" : customer.Email)</small>
                        </td>
                        <td class="col-right"><span class="font-weight-bold">@customer.DiemTichLuy</span> pts</td>
                        <td class="col-center"><span class="tier-label @tierBadgeClass">@customer.HangTV</span></td>
                        <td class="col-right"><span class="badge badge-secondary">@customer.TotalOrders đơn</span></td>
                        <td class="col-center">@customer.NgayTao.ToString("dd/MM/yyyy")</td>
                        <td class="col-center">
                            <span class="status @(customer.TrangThai ? "status-success" : "status-muted")">
                                <i></i>@(customer.TrangThai ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td>
                            <div class="table-actions account-actions">
                                <button type="button" class="button button-small button-outline js-edit-customer"
                                        data-url="@Url.Action("Edit", "KhachHang", new { area = "Admin", id = customer.MaKH })">Sửa</button>
                                <form asp-area="Admin" asp-controller="KhachHang" asp-action="ToggleStatus" method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái tài khoản khách hàng @customer.HoTen?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@customer.MaKH" />
                                    <button class="button button-small @(customer.TrangThai ? "button-outline text-danger" : "button-primary")" type="submit">
                                        @(customer.TrangThai ? "Khóa" : "Mở khóa")
                                    </button>
                                </form>
                                <form asp-area="Admin" asp-controller="KhachHang" asp-action="Delete" asp-route-id="@customer.MaKH" method="post"
                                      onsubmit="return confirm('Xóa khách hàng @customer.HoTen? Chỉ khách hàng chưa có lịch sử mới được xóa.');">
                                    @Html.AntiForgeryToken()
                                    <button class="button button-small button-outline text-danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Customers.Any())
                {
                    <tr><td colspan="8" class="text-center py-4 muted-cell">Không tìm thấy khách hàng phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<partial name="_Pagination" model="ViewBag.Pagination" />
<div class="modal fade" id="customerModal" tabindex="-1" role="dialog" aria-hidden="true"></div>
<div class="modal fade" id="customerDetailsModal" tabindex="-1" role="dialog" aria-hidden="true"></div>

@section Scripts {
    <script>
        (function () {
            const modal = $("#customerModal");
            const detailsModal = $("#customerDetailsModal");

            async function loadCustomerForm(url) {
                const response = await fetch(url, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) throw new Error("Không tải được biểu mẫu khách hàng.");
                modal.html(await response.text()).modal("show");
            }

            document.addEventListener("click", async function (event) {
                const row = event.target.closest(".customer-row");
                if (row && !event.target.closest("a, button, form, input, select, textarea")) {
                    try {
                        const response = await fetch(row.dataset.url, {
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        if (!response.ok) throw new Error("Không tải được hồ sơ khách hàng.");
                        detailsModal.html(await response.text()).modal("show");
                    } catch (error) {
                        window.alert(error.message);
                    }
                    return;
                }
                const button = event.target.closest(".js-edit-customer, .js-create-customer");
                if (!button) return;
                try {
                    await loadCustomerForm(button.dataset.url);
                } catch (error) {
                    window.alert(error.message);
                }
            });

            document.addEventListener("keydown", function (event) {
                const row = event.target.closest(".customer-row");
                if (!row || event.target.closest("a, button, form, input, select, textarea")) return;
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    row.click();
                }
            });

            $(document).on("submit", ".customer-edit-form", async function (event) {
                event.preventDefault();
                const form = event.currentTarget;
                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.disabled = true;
                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) throw new Error("Không thể lưu khách hàng. Vui lòng thử lại.");
                    if ((response.headers.get("content-type") || "").includes("application/json")) {
                        modal.modal("hide");
                        window.location.reload();
                        return;
                    }
                    modal.html(await response.text()).modal("show");
                } catch (error) {
                    window.alert(error.message);
                    submitButton.disabled = false;
                }
            });

            modal.on("hidden.bs.modal", function () { modal.empty(); });
            detailsModal.on("hidden.bs.modal", function () { detailsModal.empty(); });
        })();
    </script>
}
