@model CoffeeShop.Models.Entities.Order
@{ ViewData["Title"] = $"Chi tiết đơn hàng #{Model.MaHD}"; }
<div class="welcome-row page-title-row"><div><div class="eyebrow">ĐƠN HÀNG</div><h1>Chi tiết đơn hàng #@Model.MaHD</h1><p class="page-subtitle">Đặt lúc @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</p></div><a asp-action="Index" class="button button-outline"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a></div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Thông tin nhận hàng</h2><p>Thông tin cơ bản của khách hàng.</p></div></div><div class="order-detail-info mt-4"><p><strong>Người nhận:</strong> @Model.HoTenNguoiNhan</p><p><strong>Số điện thoại:</strong> @Model.SdtNguoiNhan</p><p><strong>Địa chỉ:</strong> @Model.DiaChiGiao</p>@if (!string.IsNullOrWhiteSpace(Model.GhiChu)) { <p><strong>Ghi chú:</strong> @Model.GhiChu</p> }</div></section><section class="panel"><div class="panel-heading"><div><h2>Tổng thanh toán</h2><p>Đơn đã thu tiền và hoàn tất.</p></div></div><div class="order-summary mt-4"><p><span>Tạm tính</span><strong>@Model.TamTinh.ToString("N0") đ</strong></p><p><span>Giảm giá</span><strong class="text-success">-@Model.TienGiamGia.ToString("N0") đ</strong></p><p><span>Phí giao hàng</span><strong>@Model.PhiGiao.ToString("N0") đ</strong></p><hr /><p class="order-grand-total"><span>Tổng cộng</span><strong>@Model.TongTien.ToString("N0") đ</strong></p></div></section></div>
<section class="panel table-panel"><div class="panel-heading table-heading"><div><h2>Các món trong đơn</h2><p>@Model.OrderDetails.Sum(d => d.SoLuong) sản phẩm</p></div><span class="status status-success"><i></i>@Model.TrangThai</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>MÓN</th><th>SIZE</th><th>SỐ LƯỢNG</th><th>ĐƠN GIÁ</th><th>THÀNH TIỀN</th></tr></thead><tbody>@foreach (var detail in Model.OrderDetails) { <tr><td><strong>@detail.Product?.TenSP</strong>@if (detail.Toppings.Any()) { <div class="muted-cell">Topping: @string.Join(", ", detail.Toppings.Select(t => t.ToppingProduct?.TenSP))</div> }</td><td>@detail.Variant?.KichCo</td><td>@detail.SoLuong</td><td>@detail.GiaBan.ToString("N0") đ</td><td class="money-cell">@detail.ThanhTien.ToString("N0") đ</td></tr>}</tbody></table></div></section>