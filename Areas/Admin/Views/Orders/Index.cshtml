@model CoffeeShop.Models.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var selectedOrder = Model.SelectedOrder;
    string BadgeClass(string status) => status switch
    {
        "Chờ xác nhận" => "order-status-waiting",
        "Đã xác nhận" => "order-status-confirmed",
        "Đang giao" => "order-status-delivering",
        "Hoàn thành" => "order-status-completed",
        "Đã hủy" => "order-status-cancelled",
        _ => "order-status-unknown"
    };
}

<div class="welcome-row page-title-row">
    <div><div class="eyebrow">ĐIỀU HÀNH</div><h1>Quản lý đơn hàng</h1><p class="page-subtitle">Theo dõi và xử lý đơn hàng theo trạng thái.</p></div>
</div>

<nav class="order-status-filters" aria-label="Lọc đơn hàng theo trạng thái">
    <a asp-action="Index" class="button button-small @(string.IsNullOrEmpty(Model.SelectedStatus) ? "button-primary" : "button-outline")">Tất cả</a>
    <a asp-action="Index" asp-route-status="Chờ xác nhận" class="button button-small @(Model.SelectedStatus == "Chờ xác nhận" ? "button-primary" : "button-outline")">Chờ xác nhận</a>
    <a asp-action="Index" asp-route-status="Đã xác nhận" class="button button-small @(Model.SelectedStatus == "Đã xác nhận" ? "button-primary" : "button-outline")">Đã xác nhận</a>
    <a asp-action="Index" asp-route-status="Đang giao" class="button button-small @(Model.SelectedStatus == "Đang giao" ? "button-primary" : "button-outline")">Đang giao</a>
    <a asp-action="Index" asp-route-status="Hoàn thành" class="button button-small @(Model.SelectedStatus == "Hoàn thành" ? "button-primary" : "button-outline")">Hoàn thành</a>
    <a asp-action="Index" asp-route-status="Đã hủy" class="button button-small @(Model.SelectedStatus == "Đã hủy" ? "button-primary" : "button-outline")">Đã hủy</a>
</nav>

<div class="order-management-grid">
    <section class="panel order-list-panel" aria-labelledby="order-list-title">
        <div class="panel-heading">
            <div>
                <h2 id="order-list-title">Danh sách đơn hàng</h2>
                <p>@Model.Pagination.TotalCount đơn hàng</p>
            </div>
        </div>
        <div class="order-list">
            @if (Model.Orders.Any())
            {
                @foreach (var order in Model.Orders)
                {
                    var isSelected = selectedOrder?.MaHD == order.MaHD;
                    var orderCode = $"#HD{order.MaHD:D4}";
                    <a asp-action="Index"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-page="@Model.Pagination.PageNumber"
                       asp-route-selectedOrderId="@order.MaHD"
                       class="order-list-item @(isSelected ? "is-selected" : "")"
                       aria-current="@(isSelected ? "true" : null)">
                        <div class="order-list-item-top">
                            <strong>@orderCode</strong>
                            <span class="badge order-status @BadgeClass(order.TrangThai)">@order.TrangThai</span>
                        </div>
                        <div class="order-list-customer">@order.HoTenNguoiNhan</div>
                        <div class="order-list-item-bottom">
                            <span>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
                            <strong>@order.TongTien.ToString("N0") đ</strong>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="order-list-empty">Không có đơn hàng trong trạng thái này.</div>
            }
        </div>
        <partial name="_Pagination" model="Model.Pagination" />
    </section>

    <section class="panel order-detail-panel" aria-labelledby="order-detail-title">
        @if (selectedOrder != null)
        {
            var selectedOrderCode = $"#HD{selectedOrder.MaHD:D4}";
            <div class="panel-heading order-detail-heading">
                <div>
                    <h2 id="order-detail-title">Chi tiết đơn hàng</h2>
                    <p>@selectedOrderCode · Đặt lúc @selectedOrder.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <span class="badge order-status @BadgeClass(selectedOrder.TrangThai)">@selectedOrder.TrangThai</span>
            </div>

            <div class="order-detail-content">
                <section class="order-detail-section">
                    <h3>Thông tin khách hàng</h3>
                    <dl class="order-info-grid">
                        <div><dt>Người nhận</dt><dd>@selectedOrder.HoTenNguoiNhan</dd></div>
                        <div><dt>Số điện thoại</dt><dd>@(string.IsNullOrWhiteSpace(selectedOrder.SdtNguoiNhan) ? "—" : selectedOrder.SdtNguoiNhan)</dd></div>
                        <div><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(selectedOrder.EmailKhachHang) ? "—" : selectedOrder.EmailKhachHang)</dd></div>
                        <div><dt>Địa chỉ giao</dt><dd>@(string.IsNullOrWhiteSpace(selectedOrder.DiaChiGiao) ? "Nhận tại quán" : selectedOrder.DiaChiGiao)</dd></div>
                        @if (!string.IsNullOrWhiteSpace(selectedOrder.GhiChu))
                        {
                            <div class="order-info-wide"><dt>Ghi chú</dt><dd>@selectedOrder.GhiChu</dd></div>
                        }
                    </dl>
                </section>

                <section class="order-detail-section">
                    <h3>Món đã đặt <span>(@selectedOrder.Details.Sum(item => item.SoLuong) món)</span></h3>
                    @if (selectedOrder.Details.Any())
                    {
                        <div class="order-detail-items">
                            @foreach (var item in selectedOrder.Details)
                            {
                                <div class="order-detail-item">
                                    <div class="order-detail-item-main">
                                        <strong>@item.TenSP</strong>
                                        <span>Size @item.KichCo · @item.SoLuong x @item.GiaBan.ToString("N0") đ</span>
                                        @if (item.Toppings.Any())
                                        {
                                            <small>Topping: @string.Join(", ", item.Toppings)</small>
                                        }
                                    </div>
                                    <strong>@item.ThanhTien.ToString("N0") đ</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="order-detail-empty">Đơn hàng chưa có món.</p>
                    }
                </section>

                <section class="order-detail-section">
                    <h3>Thanh toán</h3>
                    <dl class="order-summary">
                        <div><dt>Phương thức</dt><dd>@selectedOrder.PhuongThucThanhToan</dd></div>
                        <div><dt>Tạm tính</dt><dd>@selectedOrder.TamTinh.ToString("N0") đ</dd></div>
                        <div><dt>Giảm giá</dt><dd>−@selectedOrder.TienGiamGia.ToString("N0") đ</dd></div>
                        <div><dt>Phí giao hàng</dt><dd>@selectedOrder.PhiGiao.ToString("N0") đ</dd></div>
                        <div class="order-total"><dt>Tổng cộng</dt><dd>@selectedOrder.TongTien.ToString("N0") đ</dd></div>
                    </dl>
                </section>

                @if (selectedOrder.TrangThai == "Đã hủy" && !string.IsNullOrWhiteSpace(selectedOrder.LyDoHuy))
                {
                    <div class="order-cancel-reason"><strong>Lý do hủy:</strong> @selectedOrder.LyDoHuy</div>
                }
            </div>

            <div class="order-detail-actions">
                @if (selectedOrder.TrangThai == "Chờ xác nhận")
                {
                    @if (!selectedOrder.PhuongThucThanhToan.Contains("Đã thanh toán", StringComparison.OrdinalIgnoreCase)
                        && (selectedOrder.PhuongThucThanhToan.Contains("Transfer", StringComparison.OrdinalIgnoreCase)
                            || selectedOrder.PhuongThucThanhToan.Contains("Chuyển khoản", StringComparison.OrdinalIgnoreCase)))
                    {
                        <form asp-action="ConfirmPayment" method="post" onsubmit="return confirm('Xác nhận khách đã chuyển khoản cho đơn hàng @selectedOrderCode?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@selectedOrder.MaHD" />
                            <input type="hidden" name="selectedOrderId" value="@selectedOrder.MaHD" />
                            <input type="hidden" name="status" value="@Model.SelectedStatus" />
                            <input type="hidden" name="page" value="@Model.Pagination.PageNumber" />
                            <button type="submit" class="button button-outline">✓ Đã thanh toán</button>
                        </form>
                    }
                    <form asp-action="ConfirmOrder" method="post" onsubmit="return confirm('Xác nhận duyệt đơn hàng @selectedOrderCode và chuyển sang pha chế?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@selectedOrder.MaHD" />
                        <input type="hidden" name="selectedOrderId" value="@selectedOrder.MaHD" />
                        <input type="hidden" name="status" value="@Model.SelectedStatus" />
                        <input type="hidden" name="page" value="@Model.Pagination.PageNumber" />
                        <button type="submit" class="button button-primary">Xác nhận đơn</button>
                    </form>
                }
                else if (selectedOrder.TrangThai == "Đã xác nhận" || selectedOrder.TrangThai == "Đang giao")
                {
                    <form asp-action="AdvanceOrder" method="post" onsubmit="return confirm('@(selectedOrder.TrangThai == "Đã xác nhận" ? $"Bắt đầu giao đơn hàng {selectedOrderCode}?" : $"Xác nhận hoàn thành đơn hàng {selectedOrderCode}?")');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@selectedOrder.MaHD" />
                        <input type="hidden" name="selectedOrderId" value="@selectedOrder.MaHD" />
                        <input type="hidden" name="status" value="@Model.SelectedStatus" />
                        <input type="hidden" name="page" value="@Model.Pagination.PageNumber" />
                        <button type="submit" class="button button-primary">@(selectedOrder.TrangThai == "Đã xác nhận" ? "Bắt đầu giao" : "Hoàn thành đơn")</button>
                    </form>
                }

                @if (selectedOrder.TrangThai == "Chờ xác nhận" || selectedOrder.TrangThai == "Đã xác nhận")
                {
                    <button type="button" class="button button-outline order-cancel-button js-cancel-order" data-order-id="@selectedOrder.MaHD" data-toggle="modal" data-target="#cancelOrderModal">Hủy đơn</button>
                }
                <a asp-action="Details" asp-route-id="@selectedOrder.MaHD" class="button button-outline">Xem trang chi tiết</a>
            </div>
        }
        else
        {
            <div class="order-detail-placeholder">
                <h2 id="order-detail-title">Chi tiết đơn hàng</h2>
                <p>Chọn một đơn hàng trong danh sách để xem thông tin và món đã đặt.</p>
            </div>
        }
    </section>
</div>

<div class="modal fade" id="cancelOrderModal" tabindex="-1" role="dialog" aria-labelledby="cancelOrderTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="CancelOrder" method="post" id="cancelOrderForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderId" id="cancelOrderId" />
                <input type="hidden" name="selectedOrderId" value="@selectedOrder?.MaHD" />
                <input type="hidden" name="status" value="@Model.SelectedStatus" />
                <input type="hidden" name="page" value="@Model.Pagination.PageNumber" />
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelOrderTitle">Hủy đơn hàng</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <label for="cancelReason">Lý do hủy <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="cancelReason" name="CancelReason" rows="4" maxlength="500" required></textarea>
                    <small class="form-text text-muted">Bắt buộc nhập lý do; tối đa 500 ký tự.</small>
                    <div class="invalid-feedback">Vui lòng nhập lý do hủy đơn.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.js-cancel-order').on('click', function () {
                $('#cancelOrderId').val($(this).data('order-id'));
                $('#cancelReason').val('').removeClass('is-invalid');
            });

            $('#cancelOrderForm').on('submit', function (event) {
                var reason = $('#cancelReason').val().trim();
                if (!reason) {
                    event.preventDefault();
                    $('#cancelReason').addClass('is-invalid').trigger('focus');
                }
            });
        });
    </script>
}
