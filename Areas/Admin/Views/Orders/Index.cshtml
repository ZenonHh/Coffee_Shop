@model CoffeeShop.Models.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    string BadgeClass(string status) => status switch
    {
        "Chờ xác nhận" => "badge-warning",
        "Đã xác nhận" => "badge-info",
        "Đang giao" => "badge-primary",
        "Hoàn thành" => "badge-success",
        "Đã hủy" => "badge-danger",
        _ => "badge-secondary"
    };
}

<div class="welcome-row page-title-row">
    <div><div class="eyebrow">ĐIỀU HÀNH</div><h1>Quản lý đơn hàng</h1><p class="page-subtitle">Theo dõi và xử lý đơn hàng theo trạng thái.</p></div>
</div>
<div class="card stat-card mb-4">
    <div class="card-header bg-white d-flex flex-wrap align-items-center">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedStatus) ? "btn-primary" : "btn-outline-primary") mr-2 mb-1">Tất cả</a>
        <a asp-action="Index" asp-route-status="Chờ xác nhận" class="btn btn-sm @(Model.SelectedStatus == "Chờ xác nhận" ? "btn-warning" : "btn-outline-warning") mr-2 mb-1">Chờ xác nhận</a>
        <a asp-action="Index" asp-route-status="Đã xác nhận" class="btn btn-sm @(Model.SelectedStatus == "Đã xác nhận" ? "btn-info" : "btn-outline-info") mr-2 mb-1">Đã xác nhận</a>
        <a asp-action="Index" asp-route-status="Đang giao" class="btn btn-sm @(Model.SelectedStatus == "Đang giao" ? "btn-primary" : "btn-outline-primary") mr-2 mb-1">Đang giao</a>
        <a asp-action="Index" asp-route-status="Hoàn thành" class="btn btn-sm @(Model.SelectedStatus == "Hoàn thành" ? "btn-success" : "btn-outline-success") mr-2 mb-1">Hoàn thành</a>
        <a asp-action="Index" asp-route-status="Đã hủy" class="btn btn-sm @(Model.SelectedStatus == "Đã hủy" ? "btn-danger" : "btn-outline-danger") mb-1">Đã hủy</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th class="text-right">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Any())
                    {
                        foreach (var order in Model.Orders)
                        {
                            var orderCode = $"#HD{order.MaHD:D4}";
                            <tr>
                                <td>
                                    <!-- RÊ CHUỘT VÀO HIỂN THỊ POP-UP VỀ ĐƠN HÀNG VÀ NÚT XEM CHI TIẾT -->
                                    <div class="order-hover-container">
                                        <a asp-action="Details" asp-route-id="@order.MaHD" class="font-weight-bold text-primary" style="text-decoration: underline; font-size: 13px;">
                                            @orderCode
                                        </a>

                                        <div class="order-hover-card">
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom" style="border-color: rgba(255,255,255,0.15) !important;">
                                                <strong style="color: #c49b63; font-size: 13px;">Đơn hàng @orderCode</strong>
                                                <span class="badge @BadgeClass(order.TrangThai)">@order.TrangThai</span>
                                            </div>
                                            
                                            <div class="mb-1"><span class="text-muted">Khách nhận:</span> <strong>@order.HoTenNguoiNhan</strong> @(string.IsNullOrEmpty(order.SdtNguoiNhan) ? "" : $"({order.SdtNguoiNhan})")</div>
                                            <div class="mb-1 text-truncate" title="@order.DiaChiGiao"><span class="text-muted">Địa chỉ:</span> @(string.IsNullOrWhiteSpace(order.DiaChiGiao) ? "Tại quán" : order.DiaChiGiao)</div>
                                            <div class="mb-2"><span class="text-muted">Thanh toán:</span> <strong style="color: #28a745;">@order.PhuongThucThanhToan</strong></div>
                                            
                                            <div class="p-2 rounded mb-2" style="background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.08); font-size: 11.5px;">
                                                <div class="text-muted mb-1 font-weight-bold">Món đã chọn (@order.TotalItems ly):</div>
                                                @if (order.ItemsPreview.Any())
                                                {
                                                    @foreach (var itm in order.ItemsPreview)
                                                    {
                                                        <div class="text-truncate">• @itm</div>
                                                    }
                                                    @if (order.TotalItems > order.ItemsPreview.Count)
                                                    {
                                                        <div class="text-muted font-italic">+ @(order.TotalItems - order.ItemsPreview.Count) món khác...</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-muted">Chưa có chi tiết món</div>
                                                }
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
                                                <div>
                                                    <span class="text-muted small">Tổng tiền:</span>
                                                    <strong style="color: #ffc107; font-size: 13px;">@order.TongTien.ToString("N0") đ</strong>
                                                </div>
                                                <a asp-action="Details" asp-route-id="@order.MaHD" class="btn btn-sm btn-primary py-1 px-2 font-weight-bold" style="font-size: 11px; border-radius: 4px;">
                                                    Xem chi tiết đơn hàng &rarr;
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>@order.HoTenNguoiNhan</td>
                                <td>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="font-weight-bold">@order.TongTien.ToString("N0") đ</td>
                                <td>
                                    @if (order.PhuongThucThanhToan.Contains("Đã thanh toán") || order.PhuongThucThanhToan == "Transfer")
                                    {
                                        <span class="badge badge-success"><i class="fa fa-check-circle"></i> Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">COD</span>
                                    }
                                </td>
                                <td><span class="badge @BadgeClass(order.TrangThai)">@order.TrangThai</span></td>
                                <td class="text-right text-nowrap">
                                    @if (order.TrangThai == "Chờ xác nhận")
                                    {
                                        <form asp-action="ConfirmPayment" method="post" class="d-inline" onsubmit="return confirm('Xác nhận khách đã thanh toán cho đơn hàng @orderCode?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.MaHD" />
                                            <button type="submit" class="btn btn-sm btn-success mb-1" title="Xác nhận khách đã thanh toán">✓ Đã thanh toán</button>
                                        </form>

                                        <form asp-action="ConfirmOrder" method="post" class="d-inline" onsubmit="return confirm('Xác nhận đơn hàng @orderCode?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.MaHD" />
                                            <button type="submit" class="btn btn-sm btn-outline-success mb-1">Xác nhận</button>
                                        </form>
                                    }
                                    @if (order.TrangThai == "Đã xác nhận" || order.TrangThai == "Đang giao")
                                    {
                                        var nextStatus = order.TrangThai == "Đã xác nhận" ? "Bắt đầu giao" : "Hoàn thành";
                                        <form asp-action="AdvanceOrder" method="post" class="d-inline" onsubmit="return confirm('@nextStatus đơn hàng @orderCode?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.MaHD" />
                                            <button type="submit" class="btn btn-sm btn-primary mb-1">@nextStatus</button>
                                        </form>
                                    }
                                    @if (order.TrangThai == "Chờ xác nhận" || order.TrangThai == "Đã xác nhận")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger mb-1 js-cancel-order" data-order-id="@order.MaHD" data-toggle="modal" data-target="#cancelOrderModal">Hủy đơn</button>
                                    }
                                    <a asp-action="Details" asp-route-id="@order.MaHD" class="btn btn-sm btn-outline-primary mb-1">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">Không có đơn hàng trong trạng thái này.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelOrderModal" tabindex="-1" role="dialog" aria-labelledby="cancelOrderTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="CancelOrder" method="post" id="cancelOrderForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderId" id="cancelOrderId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelOrderTitle">Hủy đơn hàng</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <label for="cancelReason">Lý do hủy <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="cancelReason" name="CancelReason" rows="4" maxlength="500" required></textarea>
                    <small class="form-text text-muted">Bắt buộc nhập lý do; tối đa 500 ký tự.</small>
                    <div class="invalid-feedback">Vui lòng nhập lý do hủy đơn.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.js-cancel-order').on('click', function () {
                $('#cancelOrderId').val($(this).data('order-id'));
                $('#cancelReason').val('').removeClass('is-invalid');
            });

            $('#cancelOrderForm').on('submit', function (event) {
                var reason = $('#cancelReason').val().trim();
                if (!reason) {
                    event.preventDefault();
                    $('#cancelReason').addClass('is-invalid').trigger('focus');
                }
            });
        });
    </script>
}
