@model List<CoffeeShop.Models.Entities.Order>
@{ ViewData["Title"] = "Quản lý đơn hàng"; var selectedStatus = ViewBag.SelectedStatus as string; }
<div class="card stat-card mb-4"><div class="card-header bg-white d-flex justify-content-between align-items-center"><div><a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary" : "btn-outline-primary") mr-1">Tất cả (@Model.Count)</a><a asp-action="Index" asp-route-status="Hoàn tất" class="btn btn-sm @(selectedStatus == "Hoàn tất" ? "btn-primary" : "btn-outline-primary") mr-1">Hoàn tất</a><a asp-action="Index" asp-route-status="Đã hủy" class="btn btn-sm @(selectedStatus == "Đã hủy" ? "btn-danger" : "btn-outline-danger")">Đã hủy</a></div><span class="text-muted small">Chọn “Xem chi tiết” để xem đầy đủ đơn hàng</span></div>
<div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="thead-light"><tr><th>Mã đơn</th><th>Khách hàng</th><th>Số món</th><th>Tổng tiền</th><th>Thời gian</th><th></th></tr></thead><tbody>
@if (Model.Any()) { foreach (var order in Model) { <tr><td class="order-id-cell"><strong class="text-primary">#@order.MaHD</strong><div class="order-preview"><div class="order-preview-title">Đơn hàng #@order.MaHD</div><div><strong>@order.HoTenNguoiNhan</strong> · @order.SdtNguoiNhan</div><div>@order.DiaChiGiao</div>@if (!string.IsNullOrWhiteSpace(order.GhiChu)) { <div>Ghi chú: @order.GhiChu</div> }<hr />@foreach (var detail in order.OrderDetails) { <div>• @detail.Product?.TenSP × @detail.SoLuong — @detail.ThanhTien.ToString("N0") đ</div> }<div class="order-preview-total">Tạm tính: @order.TamTinh.ToString("N0") đ · Giảm: @order.TienGiamGia.ToString("N0") đ · Tổng: @order.TongTien.ToString("N0") đ</div></div></td><td><strong>@order.HoTenNguoiNhan</strong><div class="small text-muted">@order.SdtNguoiNhan</div></td><td>@order.OrderDetails.Sum(d => d.SoLuong)</td><td class="text-danger font-weight-bold">@order.TongTien.ToString("N0") đ</td><td>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</td><td><a asp-action="Details" asp-route-id="@order.MaHD" class="button button-small button-primary"><i class="fas fa-eye"></i> Xem chi tiết</a></td></tr> } } else { <tr><td colspan="6" class="text-center py-4 text-muted">Không có đơn hàng nào trong mục này.</td></tr> }
</tbody></table></div></div></div>