@model CoffeeShop.Models.ViewModels.PurchaseCreateViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Tạo phiếu nhập kho";
    var suppliers = ViewBag.Suppliers as List<CoffeeShop.Models.ViewModels.SupplierOptionViewModel> ?? new();
    var products = ViewBag.Products as List<CoffeeShop.Models.ViewModels.PurchaseProductOptionViewModel> ?? new();
    var creator = ViewBag.Creator;
}
<div class="welcome-row page-title-row"><div><div class="eyebrow">KHO HÀNG</div><h1>Tạo phiếu nhập</h1><p class="page-subtitle">Phiếu sẽ ở trạng thái chờ duyệt và chưa làm tăng tồn kho.</p></div></div>
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger"></div> }
<form asp-action="Create" method="post" class="panel dialog-form">
    @Html.AntiForgeryToken()
    <p class="purchase-creator" role="status">Người lập phiếu: @creator?.HoTen / @creator?.TenDangNhap - Vai trò: @creator?.Role</p>
    <label>Nhà cung cấp<select asp-for="MaNCC" required><option value="">Chọn nhà cung cấp</option>@foreach (var supplier in suppliers) { <option value="@supplier.MaNCC">@supplier.TenNCC</option> }</select></label>
    <div class="panel-heading"><div><h2>Sản phẩm nhập</h2></div><button class="button button-outline" id="addPurchaseLine" type="button">+ Thêm dòng sản phẩm</button></div>
    <div id="purchaseLines">
    @for (var index = 0; index < Math.Max(Model.Details.Count, 1); index++)
    {
        var line = index < Model.Details.Count ? Model.Details[index] : new CoffeeShop.Models.ViewModels.PurchaseLineInput();
        <div class="dialog-fields purchase-line">
            <label>Sản phẩm<select name="Details[@index].MaSP" required><option value="">Chọn sản phẩm</option>@foreach (var product in products) { <option value="@product.MaSP" selected="@(line.MaSP == product.MaSP)">@product.TenSP</option> }</select></label>
            <label>Số lượng<input name="Details[@index].SoLuong" type="number" min="0.01" step="0.01" value="@(line.SoLuong.GetValueOrDefault() > 0 ? line.SoLuong.GetValueOrDefault().ToString(CultureInfo.InvariantCulture) : string.Empty)" /></label>
            <label>Đơn giá<input name="Details[@index].DonGia" type="number" min="0.01" step="0.01" value="@(line.DonGia.GetValueOrDefault() > 0 ? line.DonGia.GetValueOrDefault().ToString(CultureInfo.InvariantCulture) : string.Empty)" /></label>
            @if (index > 0) { <button type="button" class="button button-outline remove-purchase-line" aria-label="Xóa dòng">Xóa dòng</button> }
        </div>
    }
    </div>
    <label>Ghi chú<textarea asp-for="GhiChu" maxlength="255" rows="2"></textarea></label>
    <div class="dialog-actions"><a asp-action="Index" class="button button-outline">Hủy</a><button type="submit" class="button button-primary">Lưu phiếu chờ duyệt</button></div>
</form>

<template id="purchaseLineTemplate">
    <div class="dialog-fields purchase-line">
        <label>Sản phẩm<select name="Details[__index__].MaSP" required><option value="">Chọn sản phẩm</option>@foreach (var product in products) { <option value="@product.MaSP">@product.TenSP</option> }</select></label>
        <label>Số lượng<input name="Details[__index__].SoLuong" type="number" min="0.01" step="0.01" required /></label>
        <label>Đơn giá<input name="Details[__index__].DonGia" type="number" min="0.01" step="0.01" required /></label>
        <button type="button" class="button button-outline remove-purchase-line" aria-label="Xóa dòng">Xóa dòng</button>
    </div>
</template>
@section Scripts {
<script>
    (() => {
        const lines = document.getElementById('purchaseLines');
        const template = document.getElementById('purchaseLineTemplate');
        let nextIndex = lines.querySelectorAll('.purchase-line').length;
        document.getElementById('addPurchaseLine').addEventListener('click', () => {
            lines.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__index__', nextIndex++));
        });
        lines.addEventListener('click', event => {
            if (!event.target.closest('.remove-purchase-line')) return;
            event.target.closest('.purchase-line').remove();
            lines.querySelectorAll('.purchase-line').forEach((line, index) => {
                line.querySelectorAll('[name]').forEach(input => {
                    input.name = input.name.replace(/Details\[\d+\]/, 'Details[' + index + ']');
                });
            });
        });
    })();
</script>
}