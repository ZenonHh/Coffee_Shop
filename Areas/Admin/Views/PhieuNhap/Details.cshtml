@model CoffeeShop.Models.ViewModels.PurchaseDetailsViewModel
@{
    ViewData["Title"] = $"Phiếu nhập #{Model.MaPN}";
}
<div class="welcome-row page-title-row"><div><div class="eyebrow">KHO HÀNG</div><h1>Phiếu nhập #@Model.MaPN</h1><p class="page-subtitle">@Model.TenNCC · @Model.NgayNhap?.ToString("dd/MM/yyyy HH:mm") · @Model.TrangThai</p></div><a asp-action="Index" class="button button-outline">Quay lại</a></div>
<section class="panel table-panel"><div class="panel-heading"><div><h2>Hàng hóa</h2><p>Lập bởi @Model.NguoiLap</p></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>SẢN PHẨM</th><th>SỐ LƯỢNG</th><th>ĐƠN GIÁ</th><th>THÀNH TIỀN</th></tr></thead><tbody>
@foreach (var detail in Model.Details)
{
    <tr><td>@detail.TenSanPham</td><td>@detail.SoLuong.ToString("N0")</td><td>@detail.DonGia.ToString("N0") đ</td><td class="money-cell">@detail.ThanhTien.ToString("N0") đ</td></tr>
}
</tbody><tfoot><tr><th colspan="3">Tổng tiền</th><th class="money-cell">@Model.TongTien?.ToString("N0") đ</th></tr></tfoot></table></div>
@if (!string.IsNullOrWhiteSpace(Model.GhiChu)) { <p class="px-4 pt-3">Ghi chú: @Model.GhiChu</p> }
@if (Model.NgayDuyet.HasValue) { <p class="px-4 pt-2">Duyệt bởi @Model.NguoiDuyet lúc @Model.NgayDuyet.Value.ToString("dd/MM/yyyy HH:mm")</p> }
@if (Model.TrangThai == "Chờ duyệt" && User.IsInRole("Admin"))
{
    <div class="dialog-actions px-4 pb-4"><form asp-action="Approve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MaPN" /><button class="button button-primary" type="submit">Duyệt phiếu</button></form><form asp-action="Cancel" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MaPN" /><button class="button button-outline" type="submit">Hủy phiếu</button></form></div>
}
</section>