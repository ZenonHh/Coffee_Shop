@model CoffeeShop.Models.ViewModels.AdminProductEditViewModel
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="card stat-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 font-weight-bold">Sửa sản phẩm #@Model.MaSP</h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Quay lại danh sách</a>
    </div>
    <div class="card-body">
        <partial name="_EditForm" model="Model" />
    </div>
</div>
