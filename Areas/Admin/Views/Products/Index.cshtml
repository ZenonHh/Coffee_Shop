@model List<CoffeeShop.Models.ViewModels.AdminProductListItemViewModel>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="card stat-card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 font-weight-bold">Danh Sách Món Uống &amp; Bánh Ngọt (@Model.Count)</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Mã</th>
                        <th>Hình Ảnh</th>
                        <th>Tên Món</th>
                        <th>Danh Mục</th>
                        <th>Tồn Kho</th>
                        <th>Các Kích Cỡ &amp; Giá Bán</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.MaSP</td>
                                <td>
                                    <img src="~/picture/@product.HinhAnh" alt="@product.TenSP" loading="lazy" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" />
                                </td>
                                <td><strong>@product.TenSP</strong></td>
                                <td><span class="badge badge-secondary">@product.TenLoaiSP</span></td>
                                <td><strong class="@(product.SoLuongTon > 0 ? "text-success" : "text-danger")">@product.SoLuongTon</strong></td>
                                <td>
                                    @foreach (var variant in product.Variants)
                                    {
                                        <span class="badge badge-light border mr-1">
                                            Size @variant.KichCo: @variant.GiaBan.ToString("N0") đ
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (product.TrangThai)
                                    {
                                        <span class="badge badge-success">Đang phục vụ</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Tạm ngưng</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@product.MaSP" />
                                        @if (product.TrangThai)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Ẩn món này">
                                                <i class="fas fa-eye-slash"></i> Ẩn
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Hiển thị lại món">
                                                <i class="fas fa-eye"></i> Hiện
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
