@model CoffeeShop.Models.ViewModels.AdminProductEditViewModel

<form asp-action="Edit" asp-route-id="@Model.MaSP" method="post" enctype="multipart/form-data" class="product-edit-form">
    @Html.AntiForgeryToken()
    <input asp-for="MaSP" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="TenSP">Tên sản phẩm</label>
            <input asp-for="TenSP" class="form-control" />
            <span asp-validation-for="TenSP" class="text-danger"></span>
        </div>
        <div class="form-group col-md-6">
            <label asp-for="MaLoaiSP">Loại sản phẩm</label>
            <select asp-for="MaLoaiSP" class="form-control">
                <option value="">-- Chọn loại sản phẩm --</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.MaLoaiSP">@category.TenLoaiSP</option>
                }
            </select>
            <span asp-validation-for="MaLoaiSP" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="SoLuongTon">Số lượng tồn</label>
            <input asp-for="SoLuongTon" class="form-control" type="number" min="0" />
            <span asp-validation-for="SoLuongTon" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label>Trạng thái</label>
            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="TrangThai" class="custom-control-input" />
                <label asp-for="TrangThai" class="custom-control-label">Đang phục vụ</label>
            </div>
        </div>
        <div class="form-group col-md-4">
            <label>Hình ảnh hiện tại</label>
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
                {
                    <img src="~/picture/@Model.HinhAnh" alt="@Model.TenSP" style="width: 56px; height: 56px; object-fit: cover; border-radius: 6px;" />
                    <span class="ml-2 text-muted">@Model.HinhAnh</span>
                }
                else
                {
                    <span class="text-muted">Chưa có hình ảnh</span>
                }
            </div>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="HinhAnhMoi">Đổi hình ảnh (không bắt buộc)</label>
        <input asp-for="HinhAnhMoi" class="form-control-file" type="file" accept=".jpg,.jpeg,.png,.webp" />
        <small class="form-text text-muted">Chấp nhận JPG, PNG, WebP; dung lượng tối đa 5 MB.</small>
        <span asp-validation-for="HinhAnhMoi" class="text-danger"></span>
    </div>

    <h6 class="font-weight-bold mt-3">Kích cỡ và giá bán</h6>
    <p class="text-muted small">Thay đổi giá hoặc tên kích cỡ hiện có. Liên hệ quản trị viên nếu cần thêm/xóa kích cỡ.</p>
    @for (var index = 0; index < Model.Variants.Count; index++)
    {
        <div class="form-row align-items-end">
            <input asp-for="Variants[index].MaBienThe" type="hidden" />
            <div class="form-group col-md-5">
                <label asp-for="Variants[index].KichCo">Kích cỡ</label>
                <input asp-for="Variants[index].KichCo" class="form-control" />
                <span asp-validation-for="Variants[index].KichCo" class="text-danger"></span>
            </div>
            <div class="form-group col-md-5">
                <label asp-for="Variants[index].GiaBan">Giá bán (đ)</label>
                <input asp-for="Variants[index].GiaBan" class="form-control" type="number" min="0.01" step="1000" />
                <span asp-validation-for="Variants[index].GiaBan" class="text-danger"></span>
            </div>
        </div>
    }
    <span asp-validation-for="Variants" class="text-danger"></span>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Lưu thay đổi
        </button>
        <button type="button" class="btn btn-light" data-dismiss="modal">Hủy</button>
    </div>
</form>
