@model CoffeeShop.Models.ViewModels.CrmStatisticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Thống kê";
    var fromDate = Model.FromDate.ToString("yyyy-MM-dd");
    var toDate = Model.ToDate.ToString("yyyy-MM-dd");
    var feedbackRate = Model.TotalCustomers == 0 ? 0
        : Model.RespondedCustomerCount * 100d / Model.TotalCustomers;

    var ageGroupsJson = JsonSerializer.Serialize(Model.AgeGroups);
    var loyaltyTiersJson = JsonSerializer.Serialize(Model.LoyaltyTiers);
    var interestsJson = JsonSerializer.Serialize(Model.Interests);
    var ratingsJson = JsonSerializer.Serialize(Model.Ratings);
    var monthlyRatingsJson = JsonSerializer.Serialize(Model.MonthlyRatings);
    var surveysJson = JsonSerializer.Serialize(Model.Surveys);
    var currentYear = DateTime.Today.Year;
    var financePeriodLabel = Model.FinancePeriod switch
    {
        "month" => "tháng",
        "year" => "năm",
        _ => "quý"
    };
}

<div class="page-heading statistics-page-heading">
    <div>
        <h1>Thống kê</h1>
        <p>@(Model.Tab == "finance" ? "Tổng hợp doanh thu hóa đơn, chi phí nhập hàng và doanh thu theo nhân viên, sản phẩm." : "Tổng hợp khách hàng, mức độ hài lòng và kết quả tham gia khảo sát.")</p>
    </div>
    @if (Model.RangeIsValid)
    {
        <div class="statistics-export-actions">
            <a class="button button-outline"
               asp-action="ExportExcel"
               asp-route-tab="@Model.Tab"
               asp-route-period="@Model.Period"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-year="@Model.FinanceYear"
               asp-route-financePeriod="@Model.FinancePeriod">
                <i class="fas fa-file-excel" aria-hidden="true"></i> Xuất Excel
            </a>
            <a class="button button-outline"
               asp-action="ExportPdf"
               asp-route-tab="@Model.Tab"
               asp-route-period="@Model.Period"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-year="@Model.FinanceYear"
               asp-route-financePeriod="@Model.FinancePeriod">
                <i class="fas fa-file-pdf" aria-hidden="true"></i> Xuất PDF
            </a>
            <button class="button button-primary" type="button" onclick="window.print()">
                <i class="fas fa-print" aria-hidden="true"></i> In
            </button>
        </div>
    }
</div>

<section class="panel statistics-filter mb-4">
    @if (Model.Tab == "finance")
    {
        <form asp-action="Index" method="get" class="form-row align-items-end">
            <input type="hidden" name="tab" value="finance" />
            <div class="form-group col-md-4">
                <label for="year">Năm thống kê</label>
                <input id="year" name="year" type="number" class="form-control" min="2000" max="@currentYear" value="@Model.FinanceYear" />
            </div>
            <div class="form-group col-md-4">
                <label for="financePeriod">Xem theo</label>
                <select id="financePeriod" name="financePeriod" class="form-control">
                    <option value="month" selected="@(Model.FinancePeriod == "month")">Tháng</option>
                    <option value="quarter" selected="@(Model.FinancePeriod == "quarter")">Quý</option>
                    <option value="year" selected="@(Model.FinancePeriod == "year")">Năm</option>
                </select>
            </div>
            <div class="form-group col-md-4">
                <button type="submit" class="button button-primary">Áp dụng</button>
            </div>
        </form>
        <p class="muted-cell mb-0">Báo cáo @financePeriodLabel năm @Model.FinanceYear</p>
    }
    else
    {
        <form asp-action="Index" method="get" class="form-row align-items-end">
            <input type="hidden" name="tab" value="@Model.Tab" />
            <div class="form-group col-lg-3 col-md-4">
                <label for="period">Khoảng thời gian</label>
                <select id="period" name="period" class="form-control">
                    <option value="30days" selected="@(Model.Period == "30days")">30 ngày gần nhất</option>
                    <option value="quarter" selected="@(Model.Period == "quarter")">Quý hiện tại</option>
                    <option value="year" selected="@(Model.Period == "year")">Năm hiện tại</option>
                    <option value="custom" selected="@(Model.Period == "custom")">Tùy chọn</option>
                </select>
            </div>
            <div class="form-group col-lg-3 col-md-4">
                <label for="fromDate">Từ ngày</label>
                <input id="fromDate" name="fromDate" type="date" class="form-control" value="@fromDate" />
            </div>
            <div class="form-group col-lg-3 col-md-4">
                <label for="toDate">Đến ngày</label>
                <input id="toDate" name="toDate" type="date" class="form-control" value="@toDate" />
            </div>
            <div class="form-group col-lg-3">
                <button type="submit" class="button button-primary">Áp dụng</button>
            </div>
        </form>
        <p class="muted-cell mb-0">Dữ liệu theo kỳ: @Model.FromDate.ToString("dd/MM/yyyy") – @Model.ToDate.ToString("dd/MM/yyyy")</p>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger mt-3 mb-0"></div>
    }
</section>

@if (!Model.RangeIsValid)
{
    <section class="panel"><p class="muted-cell mb-0">@(Model.Tab == "finance" ? "Hãy chọn năm hợp lệ để xem báo cáo." : "Hãy chọn khoảng ngày hợp lệ để xem báo cáo.")</p></section>
}
else
{
<nav class="admin-tabs statistics-tabs mb-4" aria-label="Các báo cáo">
    <a class="admin-tab @(Model.Tab == "finance" ? "active" : "")"
       asp-action="Index" asp-route-tab="finance" asp-route-year="@Model.FinanceYear" asp-route-financePeriod="@Model.FinancePeriod">Doanh thu</a>
    <a class="admin-tab @(Model.Tab == "customers" ? "active" : "")"
       asp-action="Index" asp-route-tab="customers" asp-route-period="@Model.Period" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">Khách hàng</a>
    <a class="admin-tab @(Model.Tab == "satisfaction" ? "active" : "")"
       asp-action="Index" asp-route-tab="satisfaction" asp-route-period="@Model.Period" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">Hài lòng</a>
    <a class="admin-tab @(Model.Tab == "surveys" ? "active" : "")"
       asp-action="Index" asp-route-tab="surveys" asp-route-period="@Model.Period" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">Khảo sát</a>
</nav>

@if (Model.Tab == "finance")
{
    <div class="row mb-3">
        <div class="col-md-4 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">DOANH THU HÓA ĐƠN HOÀN THÀNH</div>
                <div class="stat-value">@Model.TotalCompletedRevenue.ToString("N0") ₫</div>
                <div class="stat-foot">@Model.CompletedInvoiceCount hóa đơn trong năm @Model.FinanceYear</div>
            </section>
        </div>
        <div class="col-md-4 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">CHI PHÍ PHIẾU NHẬP ĐÃ DUYỆT</div>
                <div class="stat-value">@Model.TotalApprovedPurchases.ToString("N0") ₫</div>
                <div class="stat-foot">Tính theo ngày duyệt phiếu nhập</div>
            </section>
        </div>
        <div class="col-md-4 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">CHÊNH LỆCH THU - CHI NHẬP HÀNG</div>
                <div class="stat-value">@Model.RevenueMinusPurchases.ToString("N0") ₫</div>
                <div class="stat-foot">Doanh thu trừ chi phí nhập hàng</div>
            </section>
        </div>
    </div>

    <section class="panel table-panel mb-4">
        <div class="panel-heading table-heading">
            <div>
                <h2>Doanh thu, chi phí và chênh lệch theo @financePeriodLabel</h2>
                <p>Chỉ tính hóa đơn hoàn thành và phiếu nhập đã duyệt.@(Model.FinancePeriod == "year" ? " Bảng năm so sánh ba năm tính đến năm đã chọn." : "")</p>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data-table admin-data-table">
                <thead>
                    <tr>
                        <th>Chỉ tiêu</th>
                        @foreach (var financialPeriod in Model.FinancialPeriods)
                        {
                            <th>@financialPeriod.Label</th>
                        }
                        <th>@Model.FinanceTotalLabel</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Doanh thu</th>
                        @foreach (var financialPeriod in Model.FinancialPeriods) { <td>@financialPeriod.Revenue.ToString("N0") ₫</td> }
                        <td><strong>@Model.FinancialPeriods.Sum(item => item.Revenue).ToString("N0") ₫</strong></td>
                    </tr>
                    <tr>
                        <th>Chi phí nhập hàng</th>
                        @foreach (var financialPeriod in Model.FinancialPeriods) { <td>@financialPeriod.Purchases.ToString("N0") ₫</td> }
                        <td><strong>@Model.FinancialPeriods.Sum(item => item.Purchases).ToString("N0") ₫</strong></td>
                    </tr>
                    <tr>
                        <th>Chênh lệch thu - chi</th>
                        @foreach (var financialPeriod in Model.FinancialPeriods) { <td>@financialPeriod.Difference.ToString("N0") ₫</td> }
                        <td><strong>@Model.FinancialPeriods.Sum(item => item.Difference).ToString("N0") ₫</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="muted-cell mt-3 mb-0">Đây là chênh lệch giữa doanh thu hóa đơn và tiền nhập hàng, chưa phải lợi nhuận kế toán (chưa trừ các chi phí vận hành khác).</p>
    </section>

    <section class="panel table-panel mb-4">
        <div class="panel-heading table-heading">
            <div>
                <h2>Doanh thu theo nhân viên và năm</h2>
                <p>Ghi nhận nhân viên đầu tiên xác nhận đơn hàng; doanh thu chưa được gán nhân viên được thể hiện riêng.</p>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data-table admin-data-table">
                <thead>
                    <tr><th>Nhân viên</th>@foreach (var reportYear in Model.StaffReportYears) { <th>@reportYear</th> }<th>Tổng</th></tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.StaffRevenue)
                    {
                        <tr>
                            <th>@staff.Name</th>
                            @foreach (var reportYear in Model.StaffReportYears)
                            {
                                <td>@staff.RevenueByYear.GetValueOrDefault(reportYear).ToString("N0") ₫</td>
                            }
                            <td><strong>@staff.Total.ToString("N0") ₫</strong></td>
                        </tr>
                    }
                    <tr>
                        <th>Tổng nhân viên</th>
                        @foreach (var reportYear in Model.StaffReportYears)
                        {
                            <td><strong>@Model.StaffRevenue.Sum(staff => staff.RevenueByYear.GetValueOrDefault(reportYear)).ToString("N0") ₫</strong></td>
                        }
                        <td><strong>@Model.StaffRevenue.Sum(staff => staff.Total).ToString("N0") ₫</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel table-panel mb-4">
        <div class="panel-heading table-heading">
            <div>
                <h2>Doanh thu theo sản phẩm và quý</h2>
                <p>Tính theo thành tiền chi tiết sản phẩm của hóa đơn hoàn thành trong năm @Model.FinanceYear.</p>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data-table admin-data-table">
                <thead><tr><th>Sản phẩm</th><th>Quý 1</th><th>Quý 2</th><th>Quý 3</th><th>Quý 4</th><th>Tổng năm</th></tr></thead>
                <tbody>
                    @foreach (var product in Model.ProductQuarterRevenue)
                    {
                        <tr>
                            <th>@product.Name</th>
                            @for (var quarter = 1; quarter <= 4; quarter++)
                            {
                                <td>@product.RevenueByQuarter.GetValueOrDefault(quarter).ToString("N0") ₫</td>
                            }
                            <td><strong>@product.Total.ToString("N0") ₫</strong></td>
                        </tr>
                    }
                    @if (Model.ProductQuarterRevenue.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center py-4 muted-cell">Chưa có hóa đơn hoàn thành trong năm này.</td></tr>
                    }
                    else
                    {
                        <tr>
                            <th>Tổng sản phẩm</th>
                            @for (var quarter = 1; quarter <= 4; quarter++)
                            {
                                <td><strong>@Model.ProductQuarterRevenue.Sum(product => product.RevenueByQuarter.GetValueOrDefault(quarter)).ToString("N0") ₫</strong></td>
                            }
                            <td><strong>@Model.ProductQuarterRevenue.Sum(product => product.Total).ToString("N0") ₫</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted-cell mt-3 mb-0">Thành tiền theo sản phẩm chưa phân bổ giảm giá hóa đơn và phí giao hàng.</p>
    </section>
}
else if (Model.Tab == "customers")
{
    <div class="row mb-3">
        <div class="col-md-6 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">TỔNG KHÁCH HÀNG</div>
                <div class="stat-value">@Model.TotalCustomers</div>
                <div class="stat-foot">Khách mới trong kỳ: @Model.NewCustomers</div>
            </section>
        </div>
        <div class="col-md-6 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">KHÁCH MỚI TRONG KỲ</div>
                <div class="stat-value">@Model.NewCustomers</div>
                <div class="stat-foot">@Model.FromDate.ToString("dd/MM/yyyy") – @Model.ToDate.ToString("dd/MM/yyyy")</div>
            </section>
        </div>
    </div>

    <!-- Hàng biểu đồ hạng thành viên -->
    <div class="row mb-4">
        <div class="col-12">
            <section class="panel statistics-panel">
                <h2><i class="fas fa-medal mr-2 text-warning"></i>Phân bố hạng thành viên (Loyalty Tiers)</h2>
                <div class="row align-items-center mt-3">
                    <div class="col-md-5 mb-3 mb-md-0">
                        <div style="position: relative; height: 260px; width: 100%;">
                            <canvas id="loyaltyTiersChart"></canvas>
                        </div>
                    </div>
                    <div class="col-md-7">
                        @if (Model.LoyaltyTiers.Count == 0)
                        {
                            <p class="muted-cell mb-0">Chưa có dữ liệu khách hàng.</p>
                        }
                        @foreach (var segment in Model.LoyaltyTiers)
                        {
                            <div class="statistics-bar-row mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong>@segment.Label</strong>
                                    <span>@segment.Count khách (@segment.Percentage.ToString("0.#")%)</span>
                                </div>
                                <div class="statistics-track"><span style="width:@segment.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row">
        <!-- Phân bố độ tuổi -->
        <div class="col-lg-6 mb-4">
            <section class="panel statistics-panel h-100">
                <h2><i class="fas fa-birthday-cake mr-2 text-info"></i>Phân bố độ tuổi</h2>
                <p class="muted-cell">Tính trên toàn bộ khách hàng; đã bao gồm người chưa khai báo ngày sinh.</p>
                <div class="mb-3" style="position: relative; height: 240px; width: 100%;">
                    <canvas id="ageGroupsChart"></canvas>
                </div>
                @foreach (var segment in Model.AgeGroups)
                {
                    <div class="statistics-bar-row">
                        <div class="d-flex justify-content-between"><span>@segment.Label</span><strong>@segment.Count (@segment.Percentage.ToString("0.#")%)</strong></div>
                        <div class="statistics-track"><span style="width:@segment.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                    </div>
                }
            </section>
        </div>

        <!-- Sở thích danh mục -->
        <div class="col-lg-6 mb-4">
            <section class="panel statistics-panel h-100">
                <h2><i class="fas fa-heart mr-2 text-danger"></i>Sở thích món uống</h2>
                <p class="muted-cell">Ước tính từ nhóm sản phẩm đã mua; số khách tính theo tổng @Model.TotalCustomers khách.</p>
                @if (Model.Interests.Count == 0)
                {
                    <p class="muted-cell mb-0">Chưa có đơn hoàn thành để thống kê sở thích.</p>
                }
                else
                {
                    <div class="mb-3" style="position: relative; height: 240px; width: 100%;">
                        <canvas id="interestsChart"></canvas>
                    </div>
                }
                @foreach (var segment in Model.Interests)
                {
                    <div class="statistics-bar-row">
                        <div class="d-flex justify-content-between"><span>@segment.Label</span><strong>@segment.Count/@Model.TotalCustomers khách</strong></div>
                        <div class="statistics-track"><span style="width:@segment.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                    </div>
                }
            </section>
        </div>
    </div>
}
else if (Model.Tab == "satisfaction")
{
    <div class="row mb-3">
        <div class="col-md-4 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">ĐIỂM HÀI LÒNG TRUNG BÌNH</div>
                <div class="stat-value">@(Model.AverageSatisfaction?.ToString("0.0") ?? "—") <small>/ 5</small></div>
                <div class="stat-foot">Từ @Model.RatedFeedbackCount lượt đánh giá có chấm điểm</div>
            </section>
        </div>
        <div class="col-md-4 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">TỔNG ĐÁNH GIÁ</div>
                <div class="stat-value">@Model.TotalFeedbackCount</div>
                <div class="stat-foot">Lượt phản hồi trong kỳ</div>
            </section>
        </div>
        <div class="col-md-4 mb-3">
            <section class="stat-card h-100">
                <div class="stat-top">TỶ LỆ KHÁCH ĐÃ PHẢN HỒI</div>
                <div class="stat-value">@feedbackRate.ToString("0.#")%</div>
                <div class="stat-foot">@Model.RespondedCustomerCount/@Model.TotalCustomers khách</div>
            </section>
        </div>
    </div>
    <div class="row">
        <!-- Phân bố đánh giá 1-5 sao -->
        <div class="col-lg-6 mb-4">
            <section class="panel statistics-panel h-100">
                <h2><i class="fas fa-star mr-2 text-warning"></i>Phân bố đánh giá</h2>
                <div class="mb-3" style="position: relative; height: 240px; width: 100%;">
                    <canvas id="ratingsChart"></canvas>
                </div>
                @foreach (var rating in Model.Ratings.OrderByDescending(item => item.Rating))
                {
                    <div class="statistics-bar-row">
                        <div class="d-flex justify-content-between"><span>@rating.Rating sao</span><strong>@rating.Count lượt (@rating.Percentage.ToString("0.#")%)</strong></div>
                        <div class="statistics-track"><span style="width:@rating.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                    </div>
                }
            </section>
        </div>

        <!-- Xu hướng theo tháng -->
        <div class="col-lg-6 mb-4">
            <section class="panel statistics-panel h-100">
                <h2><i class="fas fa-chart-line mr-2 text-success"></i>Xu hướng theo tháng</h2>
                @if (Model.MonthlyRatings.Count == 0)
                {
                    <p class="muted-cell mb-0">Chưa có đánh giá trong kỳ.</p>
                }
                else
                {
                    <div class="mb-3" style="position: relative; height: 240px; width: 100%;">
                        <canvas id="monthlyRatingsChart"></canvas>
                    </div>
                }
                @foreach (var month in Model.MonthlyRatings)
                {
                    <div class="statistics-bar-row">
                        <div class="d-flex justify-content-between"><span>@month.Month · @month.Count lượt</span><strong>@month.Average/5</strong></div>
                        <div class="statistics-track"><span class="statistics-rating-track" style="width:@((month.Average * 20).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                    </div>
                }
            </section>
        </div>

        <!-- Sản phẩm được đánh giá cao -->
        <div class="col-lg-6 mb-4">
            <section class="panel statistics-panel h-100">
                <h2><i class="fas fa-thumbs-up mr-2 text-success"></i>Sản phẩm được đánh giá cao</h2>
                @if (Model.TopProducts.Count == 0) { <p class="muted-cell mb-0">Chưa có đánh giá theo sản phẩm.</p> }
                @foreach (var product in Model.TopProducts)
                {
                    <div class="statistics-product-row"><span>@product.Name <small>(@product.Count lượt)</small></span><strong>@product.Average.ToString("0.0")/5</strong></div>
                }
            </section>
        </div>

        <!-- Sản phẩm được đánh giá thấp -->
        <div class="col-lg-6 mb-4">
            <section class="panel statistics-panel h-100">
                <h2><i class="fas fa-exclamation-triangle mr-2 text-danger"></i>Sản phẩm cần cải thiện</h2>
                @if (Model.LowestProducts.Count == 0) { <p class="muted-cell mb-0">Chưa có đánh giá theo sản phẩm.</p> }
                @foreach (var product in Model.LowestProducts)
                {
                    <div class="statistics-product-row"><span>@product.Name <small>(@product.Count lượt)</small></span><strong>@product.Average.ToString("0.0")/5</strong></div>
                }
            </section>
        </div>
    </div>
}
else
{
    <!-- Tab Khảo sát -->
    <div class="row mb-4">
        <div class="col-12">
            <section class="panel statistics-panel">
                <h2><i class="fas fa-poll-h mr-2 text-primary"></i>Biểu đồ so sánh tỷ lệ tham gia khảo sát</h2>
                <div class="my-3" style="position: relative; height: 260px; width: 100%;">
                    <canvas id="surveysChart"></canvas>
                </div>
            </section>
        </div>
    </div>

    <section class="panel table-panel">
        <div class="panel-heading table-heading">
            <div>
                <h2>Chi tiết đợt khảo sát</h2>
                <p>Số lượt hoàn thành trong kỳ trên tổng số khách thuộc đối tượng nhận khảo sát.</p>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data-table admin-data-table">
                <thead><tr><th>KHẢO SÁT</th><th>ĐỐI TƯỢNG</th><th>LƯỢT TRẢ LỜI</th><th>TỶ LỆ THAM GIA</th><th></th></tr></thead>
                <tbody>
                    @foreach (var survey in Model.Surveys)
                    {
                        <tr>
                            <td><strong>@survey.Title</strong></td>
                            <td>@survey.TargetCount khách</td>
                            <td>@survey.ResponseCount/@survey.TargetCount khách (@survey.Percentage.ToString("0.#")%)</td>
                            <td><div class="statistics-track"><span style="width:@survey.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div></td>
                            <td><a class="button button-small button-outline" asp-controller="Surveys" asp-action="Statistics" asp-route-id="@survey.Id" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">Xem kết quả</a></td>
                        </tr>
                    }
                    @if (Model.Surveys.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-4 muted-cell">Chưa có khảo sát.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
}

<script type="application/json" id="stat-age-data">@Html.Raw(ageGroupsJson)</script>
<script type="application/json" id="stat-loyalty-data">@Html.Raw(loyaltyTiersJson)</script>
<script type="application/json" id="stat-interests-data">@Html.Raw(interestsJson)</script>
<script type="application/json" id="stat-ratings-data">@Html.Raw(ratingsJson)</script>
<script type="application/json" id="stat-monthly-data">@Html.Raw(monthlyRatingsJson)</script>
<script type="application/json" id="stat-surveys-data">@Html.Raw(surveysJson)</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            var currentTab = '@Model.Tab';
            var styles = getComputedStyle(document.documentElement);
            var primary = '#6f4e37'; // Katinat coffee brown
            var secondary = '#c49b63'; // Katinat gold
            var ink = '#28251f';
            var muted = '#8e8981';
            var line = '#efede9';

            Chart.defaults.font.family = "'DM Sans', sans-serif";
            Chart.defaults.color = ink;

            if (currentTab === 'customers') {
                // 1. Phân bố hạng thẻ (Doughnut)
                var loyaltyEl = document.getElementById('stat-loyalty-data');
                var loyaltyData = loyaltyEl ? JSON.parse(loyaltyEl.textContent || '[]') : [];
                var loyaltyCanvas = document.getElementById('loyaltyTiersChart');

                if (loyaltyCanvas && loyaltyData.length > 0) {
                    var tierColors = {
                        'Đồng': '#b87333',
                        'Bạc': '#a8a9ad',
                        'Vàng': '#d4af37',
                        'Kim Cương': '#0284c7'
                    };
                    var labels = loyaltyData.map(function(item) { return item.Label || 'Khác'; });
                    var counts = loyaltyData.map(function(item) { return item.Count; });
                    var bgColors = labels.map(function(lbl) { return tierColors[lbl] || '#6f4e37'; });

                    new Chart(loyaltyCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: counts,
                                backgroundColor: bgColors,
                                borderWidth: 2,
                                borderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' }
                            },
                            cutout: '60%'
                        }
                    });
                }

                // 2. Phân bố độ tuổi (Bar)
                var ageEl = document.getElementById('stat-age-data');
                var ageData = ageEl ? JSON.parse(ageEl.textContent || '[]') : [];
                var ageCanvas = document.getElementById('ageGroupsChart');

                if (ageCanvas && ageData.length > 0) {
                    new Chart(ageCanvas, {
                        type: 'bar',
                        data: {
                            labels: ageData.map(function(i) { return i.Label; }),
                            datasets: [{
                                label: 'Số khách hàng',
                                data: ageData.map(function(i) { return i.Count; }),
                                backgroundColor: '#496eae',
                                borderRadius: 4,
                                maxBarThickness: 36
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { grid: { display: false } },
                                y: { beginAtZero: true, grid: { color: line }, ticks: { precision: 0 } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }

                // 3. Sở thích món uống (Horizontal Bar)
                var interestEl = document.getElementById('stat-interests-data');
                var interestData = interestEl ? JSON.parse(interestEl.textContent || '[]') : [];
                var interestCanvas = document.getElementById('interestsChart');

                if (interestCanvas && interestData.length > 0) {
                    new Chart(interestCanvas, {
                        type: 'bar',
                        data: {
                            labels: interestData.map(function(i) { return i.Label; }),
                            datasets: [{
                                label: 'Số khách quan tâm',
                                data: interestData.map(function(i) { return i.Count; }),
                                backgroundColor: '#23845b',
                                borderRadius: 4,
                                maxBarThickness: 24
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { beginAtZero: true, grid: { color: line }, ticks: { precision: 0 } },
                                y: { grid: { display: false } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            }
            else if (currentTab === 'satisfaction') {
                // 1. Phân bố đánh giá (Bar)
                var ratingEl = document.getElementById('stat-ratings-data');
                var ratingData = ratingEl ? JSON.parse(ratingEl.textContent || '[]') : [];
                var ratingCanvas = document.getElementById('ratingsChart');

                if (ratingCanvas && ratingData.length > 0) {
                    var sortedRatings = ratingData.slice().sort(function(a, b) { return a.Rating - b.Rating; });
                    var colors = ['#dc2626', '#ea580c', '#eab308', '#84cc16', '#16a34a'];

                    new Chart(ratingCanvas, {
                        type: 'bar',
                        data: {
                            labels: sortedRatings.map(function(i) { return i.Rating + ' sao'; }),
                            datasets: [{
                                label: 'Lượt đánh giá',
                                data: sortedRatings.map(function(i) { return i.Count; }),
                                backgroundColor: colors,
                                borderRadius: 4,
                                maxBarThickness: 40
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { grid: { display: false } },
                                y: { beginAtZero: true, grid: { color: line }, ticks: { precision: 0 } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }

                // 2. Xu hướng theo tháng (Line)
                var monthlyEl = document.getElementById('stat-monthly-data');
                var monthlyData = monthlyEl ? JSON.parse(monthlyEl.textContent || '[]') : [];
                var monthlyCanvas = document.getElementById('monthlyRatingsChart');

                if (monthlyCanvas && monthlyData.length > 0) {
                    new Chart(monthlyCanvas, {
                        type: 'line',
                        data: {
                            labels: monthlyData.map(function(i) { return i.Month; }),
                            datasets: [{
                                label: 'Điểm trung bình (trên 5)',
                                data: monthlyData.map(function(i) { return i.Average; }),
                                borderColor: secondary,
                                backgroundColor: 'rgba(196, 155, 99, 0.15)',
                                borderWidth: 3,
                                fill: true,
                                tension: 0.3,
                                pointRadius: 5,
                                pointBackgroundColor: '#fff',
                                pointBorderColor: secondary
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { grid: { display: false } },
                                y: { min: 1, max: 5, grid: { color: line }, ticks: { stepSize: 1 } }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function(ctx) { return ' Điểm: ' + ctx.parsed.y + ' / 5 sao'; }
                                    }
                                }
                            }
                        }
                    });
                }
            }
            else if (currentTab === 'surveys') {
                // Biểu đồ khảo sát (Horizontal Bar)
                var surveyEl = document.getElementById('stat-surveys-data');
                var surveyData = surveyEl ? JSON.parse(surveyEl.textContent || '[]') : [];
                var surveyCanvas = document.getElementById('surveysChart');

                if (surveyCanvas && surveyData.length > 0) {
                    new Chart(surveyCanvas, {
                        type: 'bar',
                        data: {
                            labels: surveyData.map(function(i) { return i.Title; }),
                            datasets: [{
                                label: 'Tỷ lệ tham gia (%)',
                                data: surveyData.map(function(i) { return i.Percentage; }),
                                backgroundColor: '#6f4e37',
                                borderRadius: 4,
                                maxBarThickness: 28
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    max: 100,
                                    grid: { color: line },
                                    ticks: { callback: function(val) { return val + '%'; } }
                                },
                                y: { grid: { display: false } }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function(ctx) {
                                            var item = surveyData[ctx.dataIndex];
                                            return ' ' + ctx.parsed.x + '% (' + item.ResponseCount + '/' + item.TargetCount + ' khách)';
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            }
        })();
    </script>
}
