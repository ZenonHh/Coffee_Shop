@model List<CoffeeShop.Models.Entities.Survey>
@{ ViewData["Title"] = "Khảo sát ý kiến"; var editing = ViewBag.EditSurvey as CoffeeShop.Models.Entities.Survey; }
<div class="welcome-row page-title-row"><div><div class="eyebrow">THẤU HIỂU KHÁCH HÀNG</div><h1>Khảo sát ý kiến</h1><p class="page-subtitle">Tạo khảo sát, quản lý câu hỏi và theo dõi phản hồi khách hàng.</p></div></div>
@if (ViewBag.FormError != null) { <div class="alert alert-danger">@ViewBag.FormError</div> }
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>@(editing == null ? "Tạo khảo sát mới" : "Chỉnh sửa khảo sát")</h2><p>Khảo sát chỉ hiển thị cho khách trong thời gian đã cấu hình.</p></div></div>
<form asp-action="@(editing == null ? "Create" : "Edit")" method="post" class="dialog-form px-0">@Html.AntiForgeryToken()@if (editing != null) { <input type="hidden" name="MaKhaoSat" value="@editing.MaKhaoSat" /> }<label>Tiêu đề<input name="TieuDe" value="@(editing?.TieuDe ?? "")" maxlength="255" required placeholder="VD: Trải nghiệm đồ uống mới" /></label><label>Mô tả<textarea name="MoTa" rows="3" placeholder="Mục tiêu của khảo sát">@(editing?.MoTa ?? "")</textarea></label><div class="dialog-fields"><label>Bắt đầu<input name="NgayBatDau" type="datetime-local" value="@(editing?.NgayBatDau.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" required /></label><label>Kết thúc<input name="NgayKetThuc" type="datetime-local" value="@(editing?.NgayKetThuc.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.AddMonths(1).ToString("yyyy-MM-ddTHH:mm"))" required /></label></div><div class="dialog-actions">@if (editing != null) { <a asp-action="Index" class="button button-outline">Hủy</a> }<button class="button button-primary" type="submit">@(editing == null ? "Tạo khảo sát" : "Lưu thay đổi")</button></div></form></section>
<section class="panel"><div class="panel-heading"><div><h2>Thống kê nhanh</h2><p>Tổng quan dữ liệu khảo sát hiện có.</p></div></div><div class="category-note mt-4"><strong>@Model.Count</strong> khảo sát trong hệ thống.</div><div class="category-note mt-3"><strong>@Model.Count(s => s.NgayBatDau <= DateTime.Now && s.NgayKetThuc >= DateTime.Now)</strong> khảo sát đang mở.</div><div class="category-note mt-3"><strong>@Model.Sum(s => s.Questions.Sum(q => q.Answers.Count))</strong> lượt trả lời đã ghi nhận.</div></section></div>
<section class="panel table-panel"><div class="panel-heading table-heading"><div><h2>Danh sách khảo sát</h2><p>Rê xem từng khảo sát để quản lý câu hỏi.</p></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>KHẢO SÁT</th><th>THỜI GIAN</th><th>CÂU HỎI</th><th>PHẢN HỒI</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>@foreach (var survey in Model) { var open = survey.NgayBatDau <= DateTime.Now && survey.NgayKetThuc >= DateTime.Now; <tr><td><strong>@survey.TieuDe</strong><div class="muted-cell">#@survey.MaKhaoSat</div></td><td>@survey.NgayBatDau.ToString("dd/MM/yyyy HH:mm")<br /><span class="muted-cell">→ @survey.NgayKetThuc.ToString("dd/MM/yyyy HH:mm")</span></td><td>@survey.Questions.Count</td><td>@survey.Questions.Sum(q => q.Answers.Count)</td><td><span class="status @(open ? "status-success" : "status-muted")"><i></i>@(open ? "Đang mở" : "Đã đóng")</span></td><td><a asp-action="Index" asp-route-editId="@survey.MaKhaoSat" class="button button-small button-outline">@(editing?.MaKhaoSat == survey.MaKhaoSat ? "Đang sửa" : "Quản lý")</a> <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa khảo sát này?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@survey.MaKhaoSat" /><button class="button button-small button-outline text-danger">Xóa</button></form></td></tr>@if (editing?.MaKhaoSat == survey.MaKhaoSat) { <tr><td colspan="6"><div class="category-note"><strong>Danh sách câu hỏi</strong>@foreach (var q in survey.Questions) { <div class="d-flex justify-content-between align-items-center mt-2"><span>@q.NoiDungCauHoi <small class="muted-cell">(@q.Answers.Count trả lời)</small></span><form asp-action="DeleteQuestion" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@q.MaCauHoi" /><input type="hidden" name="surveyId" value="@survey.MaKhaoSat" /><button class="button button-small button-outline text-danger">Xóa</button></form></div> }<form asp-action="AddQuestion" method="post" class="d-flex mt-3" style="gap:8px;">@Html.AntiForgeryToken()<input type="hidden" name="surveyId" value="@survey.MaKhaoSat" /><input name="content" class="form-control" placeholder="Nhập câu hỏi mới" required /><button class="button button-small button-primary">Thêm câu hỏi</button></form></div></td></tr> } }@if (!Model.Any()) { <tr><td colspan="6" class="text-center py-4 muted-cell">Chưa có khảo sát nào.</td></tr>}</tbody></table></div></section>