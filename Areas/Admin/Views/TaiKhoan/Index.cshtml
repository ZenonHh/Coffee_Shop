@model CoffeeShop.Models.ViewModels.AdminAccountIndexViewModel
@{
    ViewData["Title"] = "Tài khoản";
    var formModel = ViewBag.FormModel as CoffeeShop.Models.ViewModels.InternalAccountCreateViewModel ?? new();
    var roles = ViewBag.Roles as List<CoffeeShop.Models.ViewModels.RoleOptionViewModel> ?? new();
    string RoleLabel(string name) => name switch
    {
        "Admin" => "Quản trị viên",
        "NhanVien" or "Staff" => "Nhân viên",
        "QuanLy" or "Manager" => "Quản lý",
        _ => name
    };
    string RoleBadgeClass(string name) => name switch
    {
        "Admin" => "role-badge-admin",
        "NhanVien" or "Staff" => "role-badge-staff",
        _ => "role-badge-other"
    };
}

<div class="welcome-row page-title-row">
    <div>
        <div class="eyebrow">HỆ THỐNG &amp; CRM</div>
        <h1>Tài khoản</h1>
        <p class="page-subtitle">Quản lý tài khoản quản trị viên, quản lý và nhân viên.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
}

<section class="panel table-panel">
            <div class="panel-heading table-heading account-table-heading">
                <div>
                    <h2>Danh sách nhân sự &amp; quản trị</h2>
                    <p>Hiện có @Model.InternalAccountCount tài khoản trong hệ thống nội bộ.</p>
                </div>
                <div class="account-table-tools">
                    <input type="search" class="form-control account-search" data-account-search="internalAccountTable"
                           placeholder="Tìm tên, vai trò, trạng thái..." aria-label="Tìm tài khoản nội bộ" />
                    <button type="button" class="button button-primary" data-toggle="modal" data-target="#createInternalAccountModal">
                        + Tạo tài khoản
                    </button>
                </div>
            </div>
            <div class="table-scroll">
                <table class="data-table" id="internalAccountTable">
                    <thead>
                        <tr>
                            <th>TÊN ĐĂNG NHẬP</th>
                            <th>HỌ TÊN</th>
                            <th>VAI TRÒ</th>
                            <th>TRẠNG THÁI</th>
                            <th>THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model.InternalAccounts)
                        {
                            var isCurrentAccount = string.Equals(account.TenDangNhap, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                            <tr data-search-row>
                                <td class="order-id">
                                    <strong style="color: #c49b63;">@account.TenDangNhap</strong>
                                </td>
                                <td>@account.HoTen</td>
                                <td>
                                    <span class="role-badge @RoleBadgeClass(account.TenVaiTro)">@RoleLabel(account.TenVaiTro)</span>
                                </td>
                                <td>
                                    <span class="status @(account.TrangThai ? "status-success" : "status-muted")">
                                        <i></i>@(account.TrangThai ? "Đang hoạt động" : "Đã khóa")
                                    </span>
                                </td>
                                <td>
                                    <div class="account-actions">
                                        @if (!isCurrentAccount)
                                        {
                                            <form asp-action="ChangeRole" method="post" class="account-role-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@account.MaTaiKhoan" />
                                                <select name="maVaiTro" aria-label="Vai trò của @account.TenDangNhap">
                                                    @foreach (var role in roles)
                                                    {
                                                        <option value="@role.MaVaiTro" selected="@(role.TenVaiTro == account.TenVaiTro)">@RoleLabel(role.TenVaiTro)</option>
                                                    }
                                                </select>
                                                <button class="button button-small button-outline" type="submit">Lưu quyền</button>
                                            </form>
                                            <form asp-action="ToggleStatus" method="post" onsubmit="return confirm('Bạn có chắc muốn @(account.TrangThai ? "khóa" : "mở khóa") tài khoản @account.TenDangNhap?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@account.MaTaiKhoan" />
                                                <button class="button button-small @(account.TrangThai ? "button-outline text-danger" : "button-primary")" type="submit">
                                                    @(account.TrangThai ? "Khóa" : "Mở khóa")
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="muted-cell">Tài khoản của bạn</span>
                                        }
                                        <button type="button" class="button button-small button-outline js-reset-account"
                                                data-account-id="@account.MaTaiKhoan" data-account-name="@account.TenDangNhap">
                                            Đặt lại mật khẩu
                                        </button>
                                        @if (!isCurrentAccount)
                                        {
                                            <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa vĩnh viễn tài khoản @account.TenDangNhap?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@account.MaTaiKhoan" />
                                                <button class="button button-small button-outline text-danger" type="submit">Xóa</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.InternalAccounts.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 muted-cell">Chưa có tài khoản nội bộ nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
    </section>
<partial name="_Pagination" model="ViewBag.Pagination" />

    <div class="modal fade" id="createInternalAccountModal" tabindex="-1" role="dialog" aria-labelledby="createInternalAccountModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form asp-action="Create" method="post" class="dialog-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="createInternalAccountModalLabel">Tạo tài khoản nhân viên</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">Mật khẩu được băm bảo mật BCrypt trước khi lưu.</p>
                        <label>Tên đăng nhập<input name="TenDangNhap" value="@formModel.TenDangNhap" maxlength="50" autocomplete="username" required placeholder="ví dụ: staff_01" /></label>
                        <label>Họ và tên<input name="HoTen" value="@formModel.HoTen" maxlength="100" required placeholder="ví dụ: Nguyễn Văn A" /></label>
                        <label>Vai trò phân quyền
                            <select name="MaVaiTro" required>
                                @foreach (var role in roles)
                                {
                                    <option value="@role.MaVaiTro" selected="@(formModel.MaVaiTro == role.MaVaiTro)">@RoleLabel(role.TenVaiTro)</option>
                                }
                            </select>
                        </label>
                        <label>Mật khẩu khởi tạo<input name="MatKhau" type="password" minlength="8" maxlength="72" autocomplete="new-password" required placeholder="Tối thiểu 8 ký tự" /></label>
                        @if (ViewBag.OpenInternalModal == true)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger"></div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="button button-outline" data-dismiss="modal">Hủy</button>
                        <button class="button button-primary" type="submit">Tạo tài khoản mới</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @if (ViewBag.OpenInternalModal == true)
    {
        <script>$(function () { $("#createInternalAccountModal").modal("show"); });</script>
    }

    <div class="modal fade" id="resetAccountPasswordModal" tabindex="-1" role="dialog" aria-labelledby="resetAccountPasswordTitle" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form asp-action="ResetPassword" method="post" class="dialog-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="resetAccountId" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="resetAccountPasswordTitle">Đặt lại mật khẩu</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <p>Đặt mật khẩu mới cho <strong id="resetAccountName"></strong>.</p>
                        <label>Mật khẩu mới
                            <input name="newPassword" type="password" minlength="8" maxlength="72" autocomplete="new-password" required />
                        </label>
                        <small class="muted-cell">Tối thiểu 8 ký tự. Mật khẩu sẽ được băm trước khi lưu.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="button button-outline" data-dismiss="modal">Hủy</button>
                        <button class="button button-primary" type="submit">Lưu mật khẩu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
@section Scripts {
    <script>
        (function () {
            document.querySelectorAll(".js-reset-account").forEach(function (button) {
                button.addEventListener("click", function () {
                    document.getElementById("resetAccountId").value = button.dataset.accountId;
                    document.getElementById("resetAccountName").textContent = button.dataset.accountName;
                    $("#resetAccountPasswordModal").modal("show");
                });
            });

        })();
    </script>
}