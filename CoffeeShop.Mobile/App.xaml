<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeeBackground}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource CoffeeText}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeeAccent}" />
                <Setter Property="TextColor" Value="{StaticResource CoffeeBackground}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource CoffeeText}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource CoffeeMuted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeeSurface}" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource CoffeeText}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource CoffeeMuted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeeSurface}" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource CoffeeText}" />
                <Setter Property="TitleColor" Value="{StaticResource CoffeeMuted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeeSurface}" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource CoffeeText}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource CoffeeMuted}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
