<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="CoffeePrimary">#2E1A11</Color>
            <Color x:Key="CoffeeAccent">#C49B63</Color>
            <Color x:Key="CoffeeBackground">#F9F6F0</Color>
            <Color x:Key="CoffeeSurface">#FFFFFF</Color>
            <Color x:Key="CoffeeMuted">#806F63</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeeBackground}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource CoffeePrimary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
