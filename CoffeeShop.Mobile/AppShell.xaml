<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="CoffeeShop.Mobile.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="#12100D"
       Shell.TitleColor="#FFFFFF"
       Shell.ForegroundColor="#C49B63"
       Shell.TabBarBackgroundColor="#181512"
       Shell.TabBarForegroundColor="#C49B63"
       Shell.TabBarTitleColor="#C49B63"
       Shell.TabBarUnselectedColor="#8A7D75">
    <TabBar>
        <ShellContent x:Name="HomeTab" Title="Home" Icon="tab_home.svg" Route="home" />
        <ShellContent x:Name="VoucherTab" Title="Voucher" Icon="tab_voucher.svg" Route="voucher" />
        <ShellContent x:Name="OrderTab" Title="Order" Icon="tab_order.svg" Route="order" />
        <ShellContent x:Name="AccountTab" Title="Account" Icon="tab_account.svg" Route="account" />
    </TabBar>
</Shell>
