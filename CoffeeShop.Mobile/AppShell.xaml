<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="CoffeeShop.Mobile.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="{StaticResource AppBackground}"
       Shell.TitleColor="#FFFFFF"
       Shell.ForegroundColor="#C49B63"
       Shell.TabBarBackgroundColor="{StaticResource AppBackground}"
       Shell.TabBarForegroundColor="#C49B63"
       Shell.TabBarTitleColor="#C49B63"
       Shell.TabBarUnselectedColor="#8A7D75">
    <TabBar>
        <ShellContent x:Name="HomeTab" Title="" Icon="tab_home.svg" Route="home"
                      AutomationProperties.Name="Trang chủ" />
        <ShellContent x:Name="VoucherTab" Title="" Icon="tab_voucher.svg" Route="voucher"
                      AutomationProperties.Name="Voucher" />
        <ShellContent x:Name="OrderTab" Title="" Icon="tab_order.svg" Route="order"
                      AutomationProperties.Name="Đặt hàng" />
        <ShellContent x:Name="AccountTab" Title="" Icon="tab_account.svg" Route="account"
                      AutomationProperties.Name="Tài khoản" />
    </TabBar>
</Shell>
