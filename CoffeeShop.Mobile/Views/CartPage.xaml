<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.Views.CartPage"
             Title="Giỏ hàng"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource AppBackground}">
        <ScrollView BackgroundColor="{StaticResource AppBackground}">
            <VerticalStackLayout Padding="16" Spacing="16" BackgroundColor="{StaticResource AppBackground}">
                <!-- NÚT QUAY LẠI & TIÊU ĐỀ -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Button Text="‹  Quay lại" Clicked="OnBackClicked" HorizontalOptions="Start"
                            BackgroundColor="Transparent" TextColor="{StaticResource CoffeeAccent}" Padding="4,2" FontSize="14" />
                </HorizontalStackLayout>
                
                <VerticalStackLayout Spacing="2">
                    <Label Text="Giỏ Hàng Của Bạn" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource CoffeeText}" />
                    <Label Text="Kiểm tra món uống và thông tin nhận hàng" FontSize="12" TextColor="{StaticResource CoffeeMuted}" />
                </VerticalStackLayout>

                <!-- DANH SÁCH MÓN ĐÃ CHỌN -->
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="24" Margin="0,10">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="🛒" FontSize="36" HorizontalOptions="Center" />
                                <Label Text="Giỏ hàng đang trống" TextColor="{StaticResource CoffeeText}" FontAttributes="Bold" HorizontalOptions="Center" FontSize="15" />
                                <Label Text="Hãy dạo quanh thực đơn và chọn món bạn yêu thích nhé!" TextColor="{StaticResource CoffeeMuted}" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,5">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                    <Label Text="{Binding Product.TenSP}" FontAttributes="Bold" TextColor="{StaticResource CoffeeText}" FontSize="15" />
                                    <Label Grid.Row="1" Text="{Binding SizeAndToppings}" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                                    <Label Grid.Row="2" Text="{Binding LineTotal, StringFormat='{0:N0} đ'}" TextColor="{StaticResource PrimaryGold}" FontAttributes="Bold" FontSize="14" />
                                    
                                    <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="6" VerticalOptions="Center">
                                        <Border BackgroundColor="#26201B" Stroke="#3E342B" StrokeShape="RoundRectangle 8" WidthRequest="34" HeightRequest="34">
                                            <Button Text="−" Padding="0" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryGold}" FontAttributes="Bold" FontSize="16"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseCommand}" CommandParameter="{Binding .}" />
                                        </Border>
                                        <Label Text="{Binding Quantity}" VerticalOptions="Center" TextColor="{StaticResource CoffeeText}" FontAttributes="Bold" FontSize="14" WidthRequest="24" HorizontalTextAlignment="Center" />
                                        <Border BackgroundColor="#26201B" Stroke="#3E342B" StrokeShape="RoundRectangle 8" WidthRequest="34" HeightRequest="34">
                                            <Button Text="+" Padding="0" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryGold}" FontAttributes="Bold" FontSize="16"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseCommand}" CommandParameter="{Binding .}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- KHUYẾN MÃI TỰ ĐỘNG / UP-SELL HINT (MUA THÊM ĐỂ ĐƯỢC GIẢM) -->
                <Border IsVisible="{Binding HasUpsellHint}" BackgroundColor="#241E19" Stroke="#C49B63"
                        StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="🎁" FontSize="20" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding UpsellMessage}" TextColor="#FFFFFF"
                                   FontAttributes="Bold" FontSize="13" VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                        <ProgressBar Progress="{Binding UpsellProgress}" ProgressColor="#C49B63"
                                     BackgroundColor="#46392B" HeightRequest="6" />
                        <Button Text="+ Thêm món nữa để nhận ưu đãi" Command="{Binding GoToMenuCommand}"
                                HorizontalOptions="Start" CornerRadius="16" Padding="14,6" FontSize="12"
                                BackgroundColor="#C49B63" TextColor="#12100D" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- KHỐI 1: MÃ GIẢM GIÁ / VOUCHER -->
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🎟️  MÃ GIẢM GIÁ / VOUCHER" FontAttributes="Bold" TextColor="{StaticResource PrimaryGold}" FontSize="13" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border BackgroundColor="#171310" Stroke="#332B24" StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Entry Placeholder="Nhập mã voucher (vd: REWARD20K)..." Text="{Binding VoucherCode}" TextColor="White" PlaceholderColor="#7A7166" FontSize="13" />
                            </Border>
                            <Button Grid.Column="1" Text="Áp Dụng" Command="{Binding ApplyVoucherCommand}"
                                    BackgroundColor="{StaticResource PrimaryGold}" TextColor="#12100D" FontAttributes="Bold" FontSize="12" CornerRadius="8" Padding="16,0" />
                        </Grid>
                        <Border IsVisible="{Binding HasVoucherApplied}" BackgroundColor="#1B261D" Stroke="#2ECC71" StrokeShape="RoundRectangle 8" Padding="10,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="✓" TextColor="#2ECC71" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding VoucherDiscount, StringFormat='Đã áp dụng mã - Giảm {0:N0} đ'}" TextColor="#2ECC71" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- KHỐI 2: HÌNH THỨC NHẬN MÓN (GIAO TẬN NƠI HOẶC LẤY TẠI QUÁN) -->
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🛵  HÌNH THỨC NHẬN MÓN" FontAttributes="Bold" TextColor="{StaticResource PrimaryGold}" FontSize="13" />
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <!-- Nút chọn Giao tận nơi -->
                            <Border BackgroundColor="{Binding DeliveryBgColor}" Stroke="{Binding DeliveryBorderColor}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDeliveryCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="🛵" FontSize="26" HorizontalOptions="Center" />
                                    <Label Text="Giao Tận Nơi" FontAttributes="Bold" TextColor="{Binding DeliveryTextColor}" HorizontalOptions="Center" FontSize="13" />
                                    <Label Text="Phí ship 20.000đ" TextColor="{StaticResource CoffeeMuted}" FontSize="11" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Nút chọn Đến lấy tại quán -->
                            <Border Grid.Column="1" BackgroundColor="{Binding PickupBgColor}" Stroke="{Binding PickupBorderColor}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectPickupCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="🏪" FontSize="26" HorizontalOptions="Center" />
                                    <Label Text="Lấy Tại Quán" FontAttributes="Bold" TextColor="{Binding PickupTextColor}" HorizontalOptions="Center" FontSize="13" />
                                    <Label Text="Miễn phí (0đ)" TextColor="{StaticResource PrimaryGold}" FontSize="11" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- KHỐI 3: THÔNG TIN NGƯỜI NHẬN HÀNG -->
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="👤  THÔNG TIN NGƯỜI NHẬN" FontAttributes="Bold" TextColor="{StaticResource PrimaryGold}" FontSize="13" />

                        <!-- Họ tên người nhận -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Họ và tên người nhận *" TextColor="{StaticResource CoffeeText}" FontSize="12" />
                            <Border BackgroundColor="#171310" Stroke="#332B24" StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Entry Text="{Binding RecipientName}" Placeholder="Nhập họ và tên người nhận..." TextColor="White" PlaceholderColor="#7A7166" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Số điện thoại -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Số điện thoại nhận hàng *" TextColor="{StaticResource CoffeeText}" FontSize="12" />
                            <Border BackgroundColor="#171310" Stroke="#332B24" StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Entry Text="{Binding Phone}" Placeholder="Nhập số điện thoại 10 chữ số..." Keyboard="Telephone" TextColor="White" PlaceholderColor="#7A7166" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Địa chỉ Email (nhận hóa đơn điện tử)" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                            <Border BackgroundColor="#171310" Stroke="#332B24" StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Entry Text="{Binding Email}" Placeholder="Nhập email nhận hóa đơn..." Keyboard="Email" TextColor="White" PlaceholderColor="#7A7166" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Địa chỉ giao hàng (chỉ hiện khi Giao tận nơi) -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDelivery}">
                            <Label Text="Địa chỉ giao hàng chi tiết *" TextColor="{StaticResource CoffeeText}" FontSize="12" />
                            <Border BackgroundColor="#171310" Stroke="#332B24" StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Entry Text="{Binding Address}" Placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." TextColor="White" PlaceholderColor="#7A7166" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Thông báo khi chọn Lấy tại quán -->
                        <Border BackgroundColor="#241E18" Stroke="#C49B63" StrokeShape="RoundRectangle 8" Padding="10" IsVisible="{Binding IsPickup}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="🏪" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Quý khách vui lòng đến trực tiếp quầy Katinat Coffee để nhận món khi đơn hàng được chuẩn bị xong." TextColor="#E3B875" FontSize="12" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Ghi chú đơn hàng -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ghi chú cho quán (Tùy chọn)" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                            <Border BackgroundColor="#171310" Stroke="#332B24" StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Entry Text="{Binding OrderNote}" Placeholder="Ví dụ: Giảm ngọt, nhiều đá, giao giờ trưa..." TextColor="White" PlaceholderColor="#7A7166" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Lưu làm mặc định -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding SaveCustomerInfo}" Color="{StaticResource CoffeeAccent}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Lưu thông tin này làm địa chỉ nhận hàng mặc định cho lần sau"
                                   TextColor="{StaticResource CoffeeMuted}" VerticalOptions="Center" FontSize="12"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- KHỐI 4: PHƯƠNG THỨC THANH TOÁN TRỰC QUAN -->
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="💳  PHƯƠNG THỨC THANH TOÁN" FontAttributes="Bold" TextColor="{StaticResource PrimaryGold}" FontSize="13" />

                        <!-- Tùy chọn 1: Tiền mặt khi nhận hàng (COD) -->
                        <Border BackgroundColor="{Binding CodBgColor}" Stroke="{Binding CodBorderColor}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCodCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="💵" FontSize="26" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Tiền mặt khi nhận hàng (COD)" FontAttributes="Bold" TextColor="White" FontSize="13" />
                                    <Label Text="Thanh toán trực tiếp cho shipper hoặc tại quầy" TextColor="{StaticResource CoffeeMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding CodRadioIcon}" TextColor="{StaticResource PrimaryGold}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Tùy chọn 2: Chuyển khoản QR ngân hàng (Transfer) -->
                        <Border BackgroundColor="{Binding TransferBgColor}" Stroke="{Binding TransferBorderColor}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTransferCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="📲" FontSize="26" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Chuyển khoản QR ngân hàng" FontAttributes="Bold" TextColor="White" FontSize="13" />
                                    <Label Text="Quét mã VietQR qua app ngân hàng hoặc ví điện tử" TextColor="{StaticResource CoffeeMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding TransferRadioIcon}" TextColor="{StaticResource PrimaryGold}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- KHỐI 5: TỔNG KẾT CHI PHÍ -->
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🧾  CHI TIẾT THANH TOÁN" FontAttributes="Bold" TextColor="{StaticResource PrimaryGold}" FontSize="13" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tạm tính món" TextColor="{StaticResource CoffeeMuted}" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='{0:N0} đ'}" TextColor="{StaticResource CoffeeText}" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Giảm giá ưu đãi" TextColor="{StaticResource CoffeeMuted}" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding VoucherDiscount, StringFormat='−{0:N0} đ'}" TextColor="#2ECC71" FontAttributes="Bold" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Phí giao hàng" TextColor="{StaticResource CoffeeMuted}" FontSize="13" />
                            <Label Grid.Column="1" Text="{Binding ShippingFee, StringFormat='{0:N0} đ'}" TextColor="{StaticResource CoffeeText}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- THANH ĐẶT HÀNG CỐ ĐỊNH Ở ĐÁY MÀN HÌNH -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource CoffeeSurfaceRaised}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 0" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Tổng thanh toán" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                    <Label Text="{Binding Total, StringFormat='{0:N0} đ'}" TextColor="{StaticResource PrimaryGold}" FontAttributes="Bold" FontSize="20" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="ĐẶT HÀNG NGAY  ›" Command="{Binding CheckoutCommand}"
                        BackgroundColor="{StaticResource PrimaryGold}" TextColor="#12100D" FontAttributes="Bold" FontSize="14"
                        CornerRadius="24" Padding="20,12" HeightRequest="48" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>