<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.Views.CartPage"
             Title="Giỏ hàng">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Button Text="‹  Quay lại" Clicked="OnBackClicked" HorizontalOptions="Start"
                        BackgroundColor="Transparent" TextColor="{StaticResource CoffeeAccent}" Padding="4,2" />
                <Label Text="Giỏ hàng của bạn" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource CoffeeText}" />
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Giỏ hàng đang trống." TextColor="{StaticResource CoffeeMuted}" HorizontalOptions="Center" Margin="20" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,5">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="{Binding Product.TenSP}" FontAttributes="Bold" TextColor="{StaticResource CoffeeText}" />
                                    <Label Grid.Row="1" Text="{Binding SizeAndToppings}" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                                    <Label Grid.Row="2" Text="{Binding LineTotal, StringFormat='{0:N0} đ'}" TextColor="{StaticResource CoffeeAccent}" FontAttributes="Bold" />
                                    <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="8" VerticalOptions="Center">
                                        <Button Text="−" WidthRequest="38" Padding="0" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseCommand}" CommandParameter="{Binding .}" />
                                        <Label Text="{Binding Quantity}" VerticalOptions="Center" TextColor="{StaticResource CoffeeText}" />
                                        <Button Text="+" WidthRequest="38" Padding="0" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseCommand}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mã ưu đãi" FontAttributes="Bold" TextColor="{StaticResource CoffeeText}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Placeholder="Nhập mã voucher" Text="{Binding VoucherCode}" />
                            <Button Grid.Column="1" Text="Áp dụng" Command="{Binding ApplyVoucherCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="Nhận hàng &amp; thanh toán" FontAttributes="Bold" TextColor="{StaticResource CoffeeText}" />
                        <Picker Title="Hình thức nhận hàng" ItemsSource="{Binding FulfillmentOptions}" SelectedItem="{Binding SelectedFulfillment}" />
                        <Entry Placeholder="Tên người nhận" Text="{Binding RecipientName}" />
                        <Entry Placeholder="Số điện thoại" Keyboard="Telephone" Text="{Binding Phone}" />
                        <Entry Placeholder="Địa chỉ giao hàng" Text="{Binding Address}" IsVisible="{Binding IsDelivery}" />
                        <Picker Title="Phương thức thanh toán" ItemsSource="{Binding PaymentMethods}"
                                ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedPayment}" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Tạm tính" TextColor="{StaticResource CoffeeMuted}" /><Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='{0:N0} đ'}" TextColor="{StaticResource CoffeeText}" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Giảm giá" TextColor="{StaticResource CoffeeMuted}" /><Label Grid.Column="1" Text="{Binding VoucherDiscount, StringFormat='−{0:N0} đ'}" TextColor="{StaticResource CoffeeText}" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Phí giao hàng" TextColor="{StaticResource CoffeeMuted}" /><Label Grid.Column="1" Text="{Binding ShippingFee, StringFormat='{0:N0} đ'}" TextColor="{StaticResource CoffeeText}" /></Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource CoffeeSurface}" Padding="16">
            <VerticalStackLayout>
                <Label Text="Tổng thanh toán" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                <Label Text="{Binding Total, StringFormat='{0:N0} đ'}" TextColor="{StaticResource CoffeeAccent}" FontAttributes="Bold" FontSize="19" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="ĐẶT HÀNG NGAY" Command="{Binding CheckoutCommand}" />
        </Grid>
    </Grid>
</ContentPage>
