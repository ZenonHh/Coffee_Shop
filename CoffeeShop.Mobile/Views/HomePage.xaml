<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.Views.HomePage"
             Title="Home"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,24" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Greeting}" TextColor="{StaticResource CoffeeMuted}" FontSize="13" />
                    <Label Text="{Binding CustomerName}" FontSize="23" FontAttributes="Bold"
                           TextColor="{StaticResource CoffeeText}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="Coffee Shop" TextColor="{StaticResource CoffeeAccent}"
                       FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <Grid RowDefinitions="190,Auto">
                <CarouselView x:Name="BannerCarousel"
                              ItemsSource="{Binding Banners}"
                              Position="{Binding BannerPosition, Mode=TwoWay}"
                              IndicatorView="{x:Reference BannerIndicators}"
                              IsBounceEnabled="False"
                              Loop="True">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource CoffeeSurface}" Padding="0" Margin="1">
                                <Grid>
                                    <Image Source="{Binding ., FallbackValue=coffee_swirl.svg}"
                                           Aspect="AspectFill" />
                                    <BoxView Color="#5512100D" />
                                    <VerticalStackLayout VerticalOptions="End" Padding="18" Spacing="3">
                                        <Label Text="COFFEE SHOP" TextColor="{StaticResource CoffeeAccent}"
                                               CharacterSpacing="2" FontSize="12" FontAttributes="Bold" />
                                        <Label Text="Thưởng thức trọn vị cà phê"
                                               TextColor="{StaticResource CoffeeText}" FontSize="18"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="BannerIndicators" Grid.Row="1" IndicatorSize="7"
                               IndicatorColor="#8A7D75" SelectedIndicatorColor="{StaticResource CoffeeAccent}"
                               HorizontalOptions="Center" Margin="0,10,0,0" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource CoffeeSurface}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="▣  Pick Up" TextColor="{StaticResource CoffeeAccent}"
                               FontSize="17" FontAttributes="Bold" />
                        <Label Text="Đến lấy tại quầy" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                        <Button Text="Chọn món" Command="{Binding SelectPickupCommand}" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource CoffeeSurface}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="♧  Delivery" TextColor="{StaticResource CoffeeAccent}"
                               FontSize="17" FontAttributes="Bold" />
                        <Label Text="Giao hàng tận nơi" TextColor="{StaticResource CoffeeMuted}" FontSize="12" />
                        <Button Text="Chọn món" Command="{Binding SelectDeliveryCommand}" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Xu hướng quanh bạn" TextColor="{StaticResource CoffeeText}"
                       FontSize="20" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Xem thực đơn ›" TextColor="{StaticResource CoffeeAccent}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMenuCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <CollectionView ItemsSource="{Binding BestSellers}" ItemsLayout="HorizontalList"
                            HeightRequest="224" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có món để hiển thị." TextColor="{StaticResource CoffeeMuted}"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}"
                                StrokeShape="RoundRectangle 16" Padding="8" Margin="4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenProductCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout WidthRequest="154" Spacing="5">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource CoffeeSurfaceRaised}" Padding="0">
                                    <Grid HeightRequest="132">
                                        <Image Source="{Binding HinhAnh, FallbackValue=coffee_swirl.svg}"
                                               Aspect="AspectFill" />
                                        <Border BackgroundColor="#B312100D" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8" Padding="6,3"
                                                HorizontalOptions="Start" VerticalOptions="Start" Margin="6"
                                                IsVisible="{Binding IsOutOfStock}">
                                            <Label Text="HẾT HÀNG" TextColor="White" FontSize="9"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Label Text="{Binding TenSP}" TextColor="{StaticResource CoffeeText}"
                                       FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding GiaTu, StringFormat='Từ {0:N0} đ'}"
                                       TextColor="{StaticResource CoffeeAccent}" FontSize="13"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
