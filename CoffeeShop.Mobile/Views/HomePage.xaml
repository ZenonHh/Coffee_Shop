<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.Views.HomePage"
             Title="Home"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource Background}">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,16,18,24" Spacing="22">
                <Grid>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding Greeting}" TextColor="{StaticResource TextMuted}"
                               FontSize="14" />
                        <Label Text="{Binding CustomerName}" TextColor="{StaticResource TextPrimary}"
                               FontSize="24" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>

                <Grid RowDefinitions="190,Auto">
                    <CarouselView x:Name="BannerCarousel"
                                  ItemsSource="{Binding Banners}"
                                  Position="{Binding BannerPosition, Mode=TwoWay}"
                                  IndicatorView="{x:Reference BannerIndicators}"
                                  IsBounceEnabled="False"
                                  Loop="True">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{StaticResource CardSurface}"
                                        Padding="0" Margin="1">
                                    <Grid>
                                        <Image Source="{Binding ., TargetNullValue=coffee_swirl.svg, FallbackValue=coffee_swirl.svg}"
                                               Aspect="AspectFill" />
                                        <BoxView Color="#6612100D" />
                                        <VerticalStackLayout VerticalOptions="End" Padding="20"
                                                             Spacing="5">
                                            <Label Text="COFFEE SHOP"
                                                   TextColor="{StaticResource Accent}"
                                                   CharacterSpacing="2" FontSize="11"
                                                   FontAttributes="Bold" />
                                            <Label Text="Thưởng thức trọn vị cà phê"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   FontSize="20" FontAttributes="Bold" />
                                            <Label Text="Một chút thư thái trong từng khoảnh khắc"
                                                   TextColor="White" FontSize="13" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                    <IndicatorView x:Name="BannerIndicators" Grid.Row="1"
                                   IndicatorSize="7" IndicatorColor="#8A7D75"
                                   SelectedIndicatorColor="{StaticResource Accent}"
                                   HorizontalOptions="Center" Margin="0,10,0,0" />
                </Grid>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Bạn muốn thưởng thức theo cách nào?"
                           TextColor="{StaticResource TextPrimary}" FontSize="18"
                           FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource SurfaceCard}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPickupCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="☕  Mang đi" TextColor="{StaticResource Accent}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="Đến lấy tại quầy" TextColor="{StaticResource TextMuted}"
                                       FontSize="12" />
                                <Label Text="Chọn món  ›" TextColor="{StaticResource TextPrimary}"
                                       FontSize="13" FontAttributes="Bold" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectDeliveryCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="🛵  Giao hàng" TextColor="{StaticResource Accent}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="Giao tận nơi" TextColor="{StaticResource TextMuted}"
                                       FontSize="12" />
                                <Label Text="Chọn món  ›" TextColor="{StaticResource TextPrimary}"
                                       FontSize="13" FontAttributes="Bold" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Được yêu thích" TextColor="{StaticResource TextPrimary}"
                                   FontSize="20" FontAttributes="Bold" />
                            <Label Text="Những lựa chọn nổi bật hôm nay"
                                   TextColor="{StaticResource TextMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="Xem thực đơn  ›"
                               TextColor="{StaticResource Accent}" FontSize="13"
                               FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMenuCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView ItemsSource="{Binding BestSellers}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="226" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Chưa có món để hiển thị."
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceCard}" Padding="8"
                                        Margin="4,2,8,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenProductCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout WidthRequest="158" Spacing="7">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{StaticResource SurfaceRaised}"
                                                Padding="0">
                                            <Grid HeightRequest="142">
                                                <Image Source="{Binding HinhAnh, FallbackValue=coffee_swirl.svg}"
                                                       Aspect="AspectFill" />
                                                <BoxView Color="#8812100D"
                                                         IsVisible="{Binding IsOutOfStock}" />
                                                <Border BackgroundColor="#B312100D"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="6,3"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Start" Margin="6"
                                                        IsVisible="{Binding IsOutOfStock}">
                                                    <Label Text="HẾT HÀNG" TextColor="White"
                                                           FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding TenSP}" TextColor="{StaticResource TextPrimary}"
                                               FontSize="14" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding GiaTu, StringFormat='Từ {0:N0} đ'}"
                                               TextColor="{StaticResource Accent}" FontSize="13"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" IsVisible="{Binding HasItemsInCart}"
                BackgroundColor="{StaticResource SurfaceRaised}"
                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                StrokeShape="RoundRectangle 18" Margin="16,6,16,12" Padding="14,8">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.16" Radius="12" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="{Binding CartItemCount, StringFormat='{0} món trong giỏ'}"
                           TextColor="{StaticResource TextMuted}" FontSize="12" />
                    <Label Text="{Binding TotalPriceFormatted}"
                           TextColor="{StaticResource Accent}" FontSize="16"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Xem giỏ"
                        Command="{Binding OpenCartCommand}" Padding="18,8" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
