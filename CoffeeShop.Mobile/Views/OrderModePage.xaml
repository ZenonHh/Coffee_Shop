<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.Views.OrderModePage"
             Title="Order"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,20" Spacing="18">
            <Label Text="Have a good day!" TextColor="{StaticResource CoffeeText}"
                   FontSize="26" FontAttributes="Bold" Margin="0,0,0,6" />
            <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}"
                    StrokeShape="RoundRectangle 22" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="▣  Pick Up" TextColor="{StaticResource CoffeeText}"
                           FontSize="22" FontAttributes="Bold" />
                    <Label Text="Skip the line and grab your brew" TextColor="{StaticResource CoffeeMuted}" FontSize="16" />
                    <Button Text="Order Now" Clicked="OnPickupClicked" HorizontalOptions="Start"
                            Padding="28,12" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="{StaticResource CoffeeSurface}" Stroke="{StaticResource CoffeeBorder}"
                    StrokeShape="RoundRectangle 22" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="♧  Delivery" TextColor="{StaticResource CoffeeText}"
                           FontSize="22" FontAttributes="Bold" />
                    <Label Text="Delivered right to your doorstep" TextColor="{StaticResource CoffeeMuted}" FontSize="16" />
                    <Button Text="Order Now" Clicked="OnDeliveryClicked" HorizontalOptions="Start"
                            Padding="28,12" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="{StaticResource CoffeeBorder}" StrokeShape="RoundRectangle 22" Padding="0"
                    HeightRequest="270" BackgroundColor="{StaticResource CoffeeSurface}">
                <Grid>
                    <Image Source="coffee_swirl.svg" Aspect="AspectFill" />
                    <BoxView Color="#6612100D" />
                    <VerticalStackLayout VerticalOptions="End" Padding="18" Spacing="4">
                        <Label Text="COFFEE &amp; BAKERY" TextColor="{StaticResource CoffeeAccent}"
                               CharacterSpacing="2" FontSize="12" FontAttributes="Bold" />
                        <Label Text="Chọn món yêu thích, thưởng thức trọn vị"
                               TextColor="White" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
