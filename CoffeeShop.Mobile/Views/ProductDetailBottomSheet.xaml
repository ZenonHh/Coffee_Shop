<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="CoffeeShop.Mobile.Views.ProductDetailBottomSheet"
               x:Name="ProductPopup">
    <Border x:Name="SheetContent"
            BackgroundColor="{StaticResource Background}"
            Stroke="{StaticResource BorderColor}" StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            VerticalOptions="End" Padding="18" WidthRequest="380" HeightRequest="720">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Border WidthRequest="38" HeightRequest="4" StrokeThickness="0"
                    StrokeShape="RoundRectangle 2"
                    BackgroundColor="{StaticResource TextMuted}"
                    HorizontalOptions="Center" Margin="0,0,0,4" />
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="14">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource SurfaceRaised}" Padding="0">
                        <Grid HeightRequest="210">
                            <Image Source="{Binding Product.HinhAnh, FallbackValue=coffee_swirl.svg}"
                                   Aspect="AspectFill" />
                            <Button Text="×" Clicked="OnCloseClicked"
                                    WidthRequest="42" HeightRequest="42"
                                    Padding="0" FontSize="26"
                                    BackgroundColor="#AA12100D"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="End" VerticalOptions="Start"
                                    Margin="8" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Product.TenSP}" FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Product.TenLoaiSP}"
                                   TextColor="{StaticResource TextMuted}" FontSize="13" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{Binding FavoriteButtonText}"
                                Command="{Binding ToggleFavoriteCommand}"
                                BackgroundColor="{StaticResource CardSurface}"
                                TextColor="{StaticResource Accent}" FontSize="12"
                                Padding="10,8" VerticalOptions="Center" />
                    </Grid>

                    <Border Style="{StaticResource SurfaceCard}" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Giá cơ bản" TextColor="{StaticResource TextMuted}"
                                   FontSize="12" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedVariant.GiaBan, StringFormat='{0:N0} đ'}"
                                   FontAttributes="Bold" TextColor="{StaticResource Accent}"
                                   FontSize="17" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Chọn kích cỡ" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" FontSize="16" />
                        <ScrollView Orientation="Horizontal">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Variants}"
                                                   Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="3">
                                            <Button Text="{Binding Item.KichCo}"
                                                    Command="{Binding Source={x:Reference ProductPopup}, Path=BindingContext.SelectVariantCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource CardSurface}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    BorderColor="{StaticResource BorderColor}"
                                                    BorderWidth="1" CornerRadius="18"
                                                    Padding="16,8">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{StaticResource Accent}" />
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource Background}" />
                                                        <Setter Property="BorderColor"
                                                                Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Label Text="{Binding Item.GiaBan, StringFormat='{0:N0} đ'}"
                                                   TextColor="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Mức đường" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <HorizontalStackLayout x:Name="SugarOptionsLayout"
                                                   BindableLayout.ItemsSource="{Binding SugarOptions}"
                                                   Spacing="5" Loaded="OnOptionChipsLoaded">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding .}" CommandParameter="{Binding .}"
                                                Clicked="OnSugarOptionClicked"
                                                BackgroundColor="{StaticResource CardSurface}"
                                                TextColor="{StaticResource TextPrimary}"
                                                BorderColor="{StaticResource BorderColor}"
                                                BorderWidth="1" CornerRadius="14"
                                                Padding="9,6" FontSize="12" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="7">
                            <Label Text="Mức đá" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <HorizontalStackLayout x:Name="IceOptionsLayout"
                                                   BindableLayout.ItemsSource="{Binding IceOptions}"
                                                   Spacing="5" Loaded="OnOptionChipsLoaded">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding .}" CommandParameter="{Binding .}"
                                                Clicked="OnIceOptionClicked"
                                                BackgroundColor="{StaticResource CardSurface}"
                                                TextColor="{StaticResource TextPrimary}"
                                                BorderColor="{StaticResource BorderColor}"
                                                BorderWidth="1" CornerRadius="14"
                                                Padding="9,6" FontSize="12" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Topping" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" FontSize="16" />
                    <CollectionView ItemsSource="{Binding Toppings}" SelectionMode="None"
                                    HeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceCard}"
                                        Padding="8,4" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,3">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Color="{StaticResource Accent}" />
                                        <Label Grid.Column="1" Text="{Binding Item.TenSP}"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding Item.GiaBan, StringFormat='+{0:N0} đ'}"
                                               TextColor="{StaticResource TextMuted}"
                                               VerticalOptions="Center" FontSize="12" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="Ghi chú cho Barista" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Editor Text="{Binding Note}" Placeholder="Ít ngọt, đá để riêng..."
                            AutoSize="TextChanges" HeightRequest="75" />
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,4,0,0"
                  RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <Label Text="Số lượng" TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="−"
                            Command="{Binding DecreaseQuantityCommand}"
                            WidthRequest="40" HeightRequest="40" Padding="0" />
                    <Label Grid.Column="2" Text="{Binding Quantity}"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center" VerticalOptions="Center"
                           WidthRequest="28" />
                    <Button Grid.Column="3" Text="+"
                            Command="{Binding IncreaseQuantityCommand}"
                            WidthRequest="40" HeightRequest="40" Padding="0" />
                </Grid>
                <Button Grid.Row="1"
                        Text="{Binding TotalPrice, StringFormat='Thêm vào giỏ hàng · {0:N0} đ'}"
                        Clicked="OnAddClicked" IsEnabled="{Binding CanAddToCart}" />
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
