<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeShop.Mobile.Views.SplashPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <Grid BackgroundColor="White">
        <VerticalStackLayout Padding="28" VerticalOptions="Center" HorizontalOptions="Center" Spacing="18">
            <Image Source="katinat_logo.png" WidthRequest="280" HeightRequest="280"
                   Aspect="AspectFit" HorizontalOptions="Center" />
            <Border Stroke="{StaticResource PrimaryGold}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 32" BackgroundColor="White" Padding="8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                    <Border BackgroundColor="{StaticResource PrimaryGold}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 28" WidthRequest="56" HeightRequest="56">
                        <Label Text="›" TextColor="White" FontSize="32" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="Bắt đầu ngay"
                           TextColor="#684B31" FontSize="18" HorizontalOptions="Start"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="#B3261E" FontSize="12" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <ActivityIndicator IsRunning="{Binding IsCheckingSession}" IsVisible="{Binding IsCheckingSession}"
                           Color="{StaticResource PrimaryGold}" VerticalOptions="Start" HorizontalOptions="End"
                           Margin="24,48" />
    </Grid>
</ContentPage>
