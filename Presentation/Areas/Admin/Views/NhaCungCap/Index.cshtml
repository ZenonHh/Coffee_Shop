@model CoffeeShop.Business.ViewModels.SupplierManagementViewModel
@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
    var isPurchasesTab = Model.ActiveTab == "purchases";
}

<div class="welcome-row page-title-row">
    <div>
        <div class="eyebrow">ĐỐI TÁC &amp; KHO HÀNG</div>
        <h1>Quản lý nhà cung cấp</h1>
        <p class="page-subtitle">Quản lý danh bạ đối tác cung ứng, tiếp nhận hàng hóa và theo dõi phiếu nhập kho toàn diện.</p>
    </div>
</div>

@if (ViewBag.FormError != null)
{
    <div class="alert alert-danger mb-4">@ViewBag.FormError</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">@TempData["Success"]</div>
}

<!-- TAB NAVIGATION CHUYỂN ĐỔI GIỮA NHÀ CUNG CẤP & PHIẾU NHẬP -->
<div class="d-flex mb-4" style="gap: 8px; border-bottom: 2px solid rgba(255,255,255,0.08); padding-bottom: 2px;">
    <a asp-action="Index" asp-route-tab="suppliers" 
       class="button @(!isPurchasesTab ? "button-primary" : "button-outline")" 
       style="border-bottom-left-radius: 0; border-bottom-right-radius: 0; font-weight: 600;">
        🏢 Danh sách nhà cung cấp (@Model.SupplierCount)
    </a>
    <a asp-action="Index" asp-route-tab="purchases" 
       class="button @(isPurchasesTab ? "button-primary" : "button-outline")" 
       style="border-bottom-left-radius: 0; border-bottom-right-radius: 0; font-weight: 600;">
        📥 Lịch sử &amp; Phiếu nhập kho (@Model.PurchaseCount)
    </a>
</div>

@if (!isPurchasesTab)
{
    <section class="panel table-panel">
        <div class="panel-heading table-heading">
            <div>
                <h2>Danh bạ đối tác cung ứng</h2>
                <p>Hiện có @Model.SupplierCount nhà cung cấp.</p>
            </div>
            <button type="button" class="button button-primary" data-toggle="modal" data-target="#createSupplierModal">
                + Thêm nhà cung cấp
            </button>
        </div>
        <div class="table-scroll">
            <table class="data-table admin-data-table admin-table--suppliers">
                <thead>
                    <tr>
                        <th>TÊN NHÀ CUNG CẤP</th>
                        <th>ĐIỆN THOẠI</th>
                        <th>ĐỊA CHỈ</th>
                        <th>ĐÃ NHẬP KHO</th>
                        <th>TRẠNG THÁI</th>
                        <th>THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td>
                                <strong>@supplier.TenNCC</strong>
                                <div class="muted-cell" style="font-size: 11px;">Mã NCC: #@supplier.MaNCC</div>
                            </td>
                            <td>@(string.IsNullOrEmpty(supplier.Sdt) ? "—" : supplier.Sdt)</td>
                            <td>@(string.IsNullOrEmpty(supplier.DiaChi) ? "—" : supplier.DiaChi)</td>
                            <td>
                                <span style="color: #c49b63; font-weight: 600;">@supplier.TotalPurchases đơn</span>
                                @if (supplier.TotalPurchasedAmount > 0)
                                {
                                    <div class="muted-cell small">@supplier.TotalPurchasedAmount.ToString("N0") đ</div>
                                }
                            </td>
                            <td>
                                <span class="status @(supplier.TrangThai == true ? "status-success" : "status-muted")">
                                    <i></i>@(supplier.TrangThai == true ? "Đang hoạt động" : "Đã ngừng")
                                </span>
                            </td>
                            <td style="white-space: nowrap;">
                                @if (supplier.TrangThai == true)
                                {
                                    <a asp-controller="PhieuNhap" asp-action="Create" class="button button-small button-primary mr-1" title="Tạo phiếu nhập từ NCC này">
                                        + Nhập hàng
                                    </a>
                                }
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@supplier.MaNCC" />
                                    <button type="submit" class="button button-small button-outline">
                                        @(supplier.TrangThai == true ? "Ngừng" : "Kích hoạt")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Suppliers.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 muted-cell">Chưa có nhà cung cấp nào trong danh bạ.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="ViewBag.Pagination" />
    </section>

    <div class="modal fade" id="createSupplierModal" tabindex="-1" role="dialog" aria-labelledby="createSupplierModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form asp-action="Create" method="post" class="dialog-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="createSupplierModalLabel">Thêm nhà cung cấp</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <label>
                            Tên nhà cung cấp *
                            <input name="tenNCC" maxlength="150" required placeholder="VD: Công ty Cà Phê Việt Nam" />
                        </label>
                        <label>
                            Số điện thoại
                            <input name="sdt" maxlength="20" placeholder="VD: 028 3812 3456" />
                        </label>
                        <label>
                            Địa chỉ kho / trụ sở
                            <input name="diaChi" maxlength="255" placeholder="VD: 123 Lê Lợi, Q.1, TP.HCM" />
                        </label>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="button button-outline" data-dismiss="modal">Hủy</button>
                        <button type="submit" class="button button-primary">Thêm nhà cung cấp</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @if (ViewBag.OpenSupplierModal == true)
    {
        <script>
            $(function () { $("#createSupplierModal").modal("show"); });
        </script>
    }
}
else
{
    <section class="panel purchase-history-panel">
        <div class="panel-heading purchase-history-heading">
            <div>
                <h2>Lịch sử &amp; Phiếu nhập kho</h2>
                <p>Theo dõi các lần nhập kho, mặt hàng và trạng thái duyệt.</p>
            </div>
            <a asp-controller="PhieuNhap" asp-action="Create" class="button button-primary">
                + Lập phiếu nhập mới
            </a>
        </div>

        <form asp-action="Index" method="get" class="purchase-filter-panel" id="purchaseFilterForm">
            <input type="hidden" name="tab" value="purchases" />
            <input type="hidden" name="purchasePage" value="1" />
            <input type="hidden" name="purchaseFilter" id="purchaseFilterMode" value="@Model.PurchaseFilter" />
            <input type="hidden" name="purchaseQuarter" id="purchaseQuarter" value="@Model.PurchaseQuarter" />
            <input type="hidden" name="purchaseMonths" id="purchaseMonths" value="@Model.PurchaseMonths" />
            <div class="purchase-filter-toolbar">
                <div class="purchase-filter-modes" role="group" aria-label="Chế độ lọc thời gian">
                    <button type="button" class="purchase-filter-mode @(Model.PurchaseFilter == "all" ? "active" : "")" data-filter-mode="all">Tất cả</button>
                    <button type="button" class="purchase-filter-mode @(Model.PurchaseFilter == "quarter" ? "active" : "")" data-filter-mode="quarter">Theo Quý</button>
                    <button type="button" class="purchase-filter-mode @(Model.PurchaseFilter == "months" ? "active" : "")" data-filter-mode="months">Theo tháng</button>
                    <button type="button" class="purchase-filter-mode @(Model.PurchaseFilter == "custom" ? "active" : "")" data-filter-mode="custom">Từ ngày – Đến ngày</button>
                </div>
                <label class="purchase-sort-control">
                    <span>Sắp xếp</span>
                    <select name="purchaseSort" id="purchaseSort">
                        <option value="newest" selected="@(Model.PurchaseSort == "newest")">Mới nhất trước</option>
                        <option value="oldest" selected="@(Model.PurchaseSort == "oldest")">Cũ nhất trước</option>
                    </select>
                </label>
            </div>

            <div class="purchase-filter-options" data-filter-options="quarter" hidden="@(Model.PurchaseFilter != "quarter")">
                <label class="purchase-year-control">
                    Năm
                    <select name="purchaseYear" id="purchaseYear">
                        @foreach (var year in Model.PurchaseYears)
                        {
                            <option value="@year" selected="@(year == Model.PurchaseYear)">@year</option>
                        }
                    </select>
                </label>
                <div class="purchase-quick-filters" role="group" aria-label="Chọn quý">
                    @for (var quarter = 1; quarter <= 4; quarter++)
                    {
                        <button type="button" class="button button-small @(Model.PurchaseQuarter == quarter ? "button-primary" : "button-outline")" data-purchase-quarter="@quarter">Quý @quarter</button>
                    }
                </div>
            </div>
            <div class="purchase-filter-options purchase-quick-filters" data-filter-options="months" role="group" aria-label="Khoảng thời gian" hidden="@(Model.PurchaseFilter != "months")">
                <button type="button" class="button button-small @(Model.PurchaseMonths == 3 ? "button-primary" : "button-outline")" data-purchase-months="3">3 tháng</button>
                <button type="button" class="button button-small @(Model.PurchaseMonths == 6 ? "button-primary" : "button-outline")" data-purchase-months="6">6 tháng</button>
                <button type="button" class="button button-small @(Model.PurchaseMonths == 9 ? "button-primary" : "button-outline")" data-purchase-months="9">9 tháng</button>
            </div>
            <div class="purchase-filter-options purchase-date-range" data-filter-options="custom" hidden="@(Model.PurchaseFilter != "custom")">
                <label>Từ ngày<input type="date" name="purchaseFromDate" id="purchaseFromDate" value="@Model.PurchaseFromDate?.ToString("yyyy-MM-dd")" /></label>
                <label>Đến ngày<input type="date" name="purchaseToDate" id="purchaseToDate" value="@Model.PurchaseToDate?.ToString("yyyy-MM-dd")" /></label>
                <button type="submit" class="button button-small button-primary">Áp dụng</button>
            </div>

            <div class="purchase-filter-summary">
                <p><strong>@Model.FilteredPurchaseCount</strong> phiếu phù hợp <span>·</span> @Model.PurchaseFilterSummary</p>
                @if (ViewBag.PurchaseFilterError != null)
                {
                    <p class="purchase-filter-error" role="alert">@ViewBag.PurchaseFilterError</p>
                }
                <a asp-action="Index" asp-route-tab="purchases" class="button button-small button-outline">Đặt lại</a>
            </div>
        </form>

        <div class="purchase-master-detail">
            <section class="panel purchase-list-panel" aria-labelledby="purchaseListHeading">
                <div class="panel-heading purchase-list-heading">
                    <div>
                        <h3 id="purchaseListHeading">Danh sách phiếu</h3>
                        <p>@Model.Purchases.Count phiếu trên trang này</p>
                    </div>
                </div>
                <div class="table-scroll purchase-table-scroll">
                    <table class="data-table admin-data-table admin-table--purchases purchase-history-table">
                        <thead>
                            <tr>
                                <th>MÃ PHIẾU</th>
                                <th>NHÀ CUNG CẤP</th>
                                <th>NGÀY NHẬP</th>
                                <th>TỔNG GIÁ TRỊ</th>
                                <th>TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var purchase in Model.Purchases)
                            {
                                var statusClass = purchase.TrangThai == "Đã duyệt" ? "status-success" : purchase.TrangThai == "Đã hủy" ? "status-muted" : "status-warning";
                                <tr class="purchase-select-row" data-purchase-id="@purchase.MaPN" data-details-url="@Url.Action("GetDetailsPartial", "PhieuNhap", new { area = "Admin", id = purchase.MaPN })" tabindex="0" role="button" aria-label="Xem chi tiết phiếu nhập #@purchase.MaPN">
                                    <td class="order-id">#@purchase.MaPN</td>
                                    <td><strong>@purchase.TenNCC</strong></td>
                                    <td>@(purchase.NgayNhap?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td class="money-cell">@(purchase.TongTien?.ToString("N0") ?? "0") đ</td>
                                    <td><span class="status @statusClass"><i></i>@purchase.TrangThai</span></td>
                                </tr>
                            }
                            @if (!Model.Purchases.Any())
                            {
                                <tr><td colspan="5" class="text-center py-4 muted-cell">Không có phiếu nhập trong khoảng thời gian này.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pagination" model="ViewBag.Pagination" />
            </section>

            <aside class="purchase-detail-sticky" aria-label="Chi tiết phiếu nhập" aria-live="polite">
                <div id="purchaseDetailPanel">
                    @if (Model.Purchases.Any())
                    {
                        <div class="purchase-detail-loading">Đang tải chi tiết phiếu nhập #@Model.Purchases[0].MaPN…</div>
                    }
                    else
                    {
                        <div class="purchase-detail-empty">
                            <span aria-hidden="true">▤</span>
                            <h3>Chưa có phiếu nhập</h3>
                            <p>Thay đổi bộ lọc thời gian hoặc lập phiếu nhập mới.</p>
                        </div>
                    }
                </div>
            </aside>
        </div>
    </section>
}