@model List<CoffeeShop.Business.ViewModels.AdminProductListItemViewModel>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var soldPeriod = (string?)ViewBag.SoldPeriod ?? "day";
    var fromDateVal = (string?)ViewBag.FromDate ?? "";
    var toDateVal = (string?)ViewBag.ToDate ?? "";
    var periodLabel = soldPeriod switch {
        "day"     => "hôm nay",
        "week"    => "tuần này",
        "month"   => "tháng này",
        "quarter" => "quý này",
        "year"    => "năm này",
        "custom"  => $"từ {ViewBag.FilterStart:dd/MM/yyyy} đến {ViewBag.FilterEnd:dd/MM/yyyy}",
        _         => "hôm nay"
    };
}

<style>
    /* Mở rộng toàn trang quản lý sản phẩm để không bị cuộn ngang */
    .page-content {
        max-width: 100% !important;
        padding: 20px 25px !important;
    }
    .admin-table--products {
        width: 100% !important;
        table-layout: auto;
    }
    .admin-table--products th,
    .admin-table--products td {
        padding: 8px 10px !important;
        vertical-align: middle !important;
        font-size: 13.5px;
    }
    .product-variant-badge-group {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        max-width: 250px;
    }
    .product-variant-badge-group .badge {
        font-size: 11.5px;
        padding: 4px 6px;
    }

    /* Style cho cột Top 5 món bán chạy bên trái */
    .top5-item {
        border-radius: 8px !important;
        border: 1px solid #e9ecef;
        margin-bottom: 6px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        background-color: #fff;
    }
    .top5-item:hover {
        background-color: #f8f9fa;
        border-color: #c49b63;
        transform: translateX(3px);
    }
    .top5-item.active-item {
        background-color: #fcf8f2 !important;
        border-color: #c49b63 !important;
        border-left: 4px solid #6f4e37 !important;
        box-shadow: 0 2px 6px rgba(111, 78, 55, 0.12);
    }
    .top5-rank-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        font-size: 12px;
        flex-shrink: 0;
    }
    .top5-rank-1 { background-color: #f5eee8; color: #6f4e37; border: 1px solid #c49b63; }
    .top5-rank-2 { background-color: #f8f7f5; color: #615c54; border: 1px solid #ded7cf; }
    .top5-rank-3 { background-color: #faf5f0; color: #8c5b2f; border: 1px solid #edd5be; }
    .top5-rank-other { background-color: #fbfbfa; color: #8e8981; border: 1px solid #efede9; }
    .top5-thumb {
        width: 38px;
        height: 38px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
    }
    .top5-thumb-placeholder {
        width: 38px;
        height: 38px;
        border-radius: 6px;
        background-color: #f1f5f9;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        flex-shrink: 0;
    }
</style>

<!-- Biểu đồ & Danh sách Top 5 món bán chạy (chia 2 cột: trái hiện 5 món, phải là biểu đồ) -->
<div class="card stat-card mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="row">
            <!-- BÊN TRÁI: DANH SÁCH 5 MÓN BÁN CHẠY -->
            <div class="col-lg-4 col-md-5 mb-4 mb-md-0 border-right">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <h6 class="mb-0 font-weight-bold text-dark">
                        <i class="fas fa-crown text-warning mr-1"></i> Top 5 Món Bán Chạy
                    </h6>
                    <span class="badge badge-pill px-2 py-1" id="top5PeriodBadge" style="background-color: #6f4e37; color: #fff; font-size: 11px; font-weight: 600;">@periodLabel</span>
                </div>
                <p class="small text-muted mb-3">
                    <i class="fas fa-mouse-pointer mr-1 text-primary"></i> Nhấp vào món để xem biểu đồ chi tiết theo ngày.
                </p>
                <div id="top5ProductList" class="list-group list-group-flush pr-lg-2">
                    <div class="text-center py-4 text-muted small">
                        <div class="spinner-border spinner-border-sm text-primary mr-1" role="status"></div> Đang tải dữ liệu...
                    </div>
                </div>
            </div>

            <!-- BÊN PHẢI: BIỂU ĐỒ & ĐIỀU KHIỂN CHI TIẾT -->
            <div class="col-lg-8 col-md-7 pl-lg-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-2">
                    <div>
                        <h6 class="mb-1 font-weight-bold" id="productChartTitle">
                            <i class="fas fa-chart-bar text-primary mr-1"></i> Biểu Đồ Top 5 Món (@periodLabel)
                        </h6>
                        <small class="text-muted" id="productChartSubtitle">Bấm vào cột món trên biểu đồ hoặc danh sách bên trái để xem chi tiết theo ngày.</small>
                    </div>
                    <div class="d-flex align-items-center flex-wrap mt-2 mt-sm-0">
                        <!-- Nút quay lại xem Top 5 -->
                        <button type="button" class="btn btn-sm mr-2" id="btnBackToTop5" style="display: none; border: 1px solid #6f4e37; color: #6f4e37; background: #fff; font-size: 11.5px; padding: 3px 9px;" onclick="returnToTop5()">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại Top 5
                        </button>
                        <!-- Dropdown chuyển nhanh sang món khác -->
                        <div class="d-flex align-items-center mr-2">
                            <select id="productSelectFilter" class="form-control form-control-sm" style="max-width: 190px; height: 30px; font-size: 12px; padding: 2px 6px;" onchange="onSelectProductChange(this.value)">
                                <option value="">-- Xem món khác --</option>
                            </select>
                        </div>
                        <!-- Badge tổng số bán -->
                        <span class="badge py-1 px-2 font-weight-bold" id="chartTotalBadge" style="display: none; font-size: 11px; background-color: #23845b; color: #fff; border-radius: 4px;"></span>
                    </div>
                </div>

                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="productTopSalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card stat-card mb-4 admin-products-container">
    <div class="card-header bg-white table-card-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h5 class="mb-0 font-weight-bold">Danh Sách Món Uống &amp; Bánh Ngọt (@(((CoffeeShop.Business.ViewModels.PaginationViewModel)ViewBag.Pagination).TotalCount))</h5>
            <small class="text-muted">Số lượng bán tính theo đơn hoàn thành trong <strong>@periodLabel</strong>.</small>
        </div>
        <a asp-action="Create" class="button button-primary btn-add js-create-product">
            <i class="fas fa-plus mr-1"></i> Thêm sản phẩm
        </a>
    </div>

    @* Bộ lọc kỳ bán: chọn nhanh và lọc theo khoảng ngày A -> B *@
    <div class="card-body py-2 border-bottom bg-light">
        <form asp-action="Index" method="get" class="form-row align-items-center mb-0">
            <div class="col-auto mb-1">
                <span class="font-weight-bold text-muted small"><i class="fas fa-chart-line mr-1"></i>Lọc đã bán:</span>
            </div>
            <div class="col-auto mb-1">
                <div class="btn-group btn-group-sm" role="group">
                    <a href="?soldPeriod=day&page=@ViewBag.Pagination?.PageNumber"
                       class="btn btn-sm @(soldPeriod == "day" ? "btn-primary font-weight-bold" : "btn-outline-secondary")" style="font-size: 12px; padding: 3px 10px;">Hôm nay</a>
                    <a href="?soldPeriod=week&page=@ViewBag.Pagination?.PageNumber"
                       class="btn btn-sm @(soldPeriod == "week" ? "btn-primary font-weight-bold" : "btn-outline-secondary")" style="font-size: 12px; padding: 3px 10px;">Tuần</a>
                    <a href="?soldPeriod=month&page=@ViewBag.Pagination?.PageNumber"
                       class="btn btn-sm @(soldPeriod == "month" ? "btn-primary font-weight-bold" : "btn-outline-secondary")" style="font-size: 12px; padding: 3px 10px;">Tháng</a>
                    <a href="?soldPeriod=quarter&page=@ViewBag.Pagination?.PageNumber"
                       class="btn btn-sm @(soldPeriod == "quarter" ? "btn-primary font-weight-bold" : "btn-outline-secondary")" style="font-size: 12px; padding: 3px 10px;">Quý</a>
                    <a href="?soldPeriod=year&page=@ViewBag.Pagination?.PageNumber"
                       class="btn btn-sm @(soldPeriod == "year" ? "btn-primary font-weight-bold" : "btn-outline-secondary")" style="font-size: 12px; padding: 3px 10px;">Năm</a>
                </div>
            </div>
            <div class="col-auto mb-1 d-flex align-items-center flex-wrap">
                <span class="mx-2 text-muted small">hoặc từ ngày:</span>
                <input type="date" name="fromDate" class="form-control form-control-sm mr-1" style="width: 130px; height: 30px; font-size: 12px;" value="@fromDateVal" required />
                <span class="mr-1 text-muted small">đến:</span>
                <input type="date" name="toDate" class="form-control form-control-sm mr-2" style="width: 130px; height: 30px; font-size: 12px;" value="@toDateVal" required />
                <button type="submit" class="btn btn-sm btn-primary" style="font-size: 12px; padding: 3px 10px;">
                    <i class="fas fa-filter mr-1"></i> Lọc
                </button>
                @if (soldPeriod == "custom")
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary ml-1" title="Bỏ lọc khoảng ngày">
                        <i class="fas fa-times"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive" style="overflow-x: auto;">
            <table class="table table-hover mb-0 admin-data-table admin-table--products custom-admin-table">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 50px;">Mã</th>
                        <th style="width: 60px;">Ảnh</th>
                        <th>Tên Món</th>
                        <th style="width: 120px;">Danh Mục</th>
                        <th style="width: 80px;" class="text-center">Tồn Kho</th>
                        <th style="width: 110px;" class="text-center">Đã bán (@(soldPeriod == "custom" ? "kỳ lọc" : periodLabel))</th>
                        <th>Các Kích Cỡ &amp; Giá Bán</th>
                        <th style="width: 110px;" class="text-center">Trạng Thái</th>
                        <th style="width: 120px;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>
                                <td><span class="text-muted">#@product.MaSP</span></td>
                                <td>
                                    <img src="~/picture/@product.HinhAnh" alt="@product.TenSP" loading="lazy" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0;" />
                                </td>
                                <td><strong>@product.TenSP</strong></td>
                                <td><span class="badge badge-secondary">@product.TenLoaiSP</span></td>
                                <td class="text-center"><strong class="@(product.SoLuongTon > 0 ? "text-success" : "text-danger")">@product.SoLuongTon</strong></td>
                                <td class="text-center">
                                    <strong class="text-primary font-weight-bold" style="font-size: 15px;">@product.SoldInPeriod</strong>
                                </td>
                                <td>
                                    <div class="product-variant-badge-group">
                                        @foreach (var variant in product.Variants)
                                        {
                                            <span class="badge badge-light border">
                                                Size @variant.KichCo: @variant.GiaBan.ToString("N0") đ
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (product.TrangThai)
                                    {
                                        <span class="badge badge-success">Đang phục vụ</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Tạm ngưng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="table-actions">
                                        <a asp-action="Edit" asp-route-id="@product.MaSP" class="btn btn-sm btn-outline-primary js-edit-product" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@product.MaSP" />
                                            @if (product.TrangThai)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Ẩn món này">
                                                    <i class="fas fa-eye-slash"></i> Ẩn
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Hiển thị lại món">
                                                    <i class="fas fa-eye"></i> Hiện
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="ViewBag.Pagination" />
    </div>
</div>

<div class="modal fade" id="productEditModal" tabindex="-1" role="dialog" aria-labelledby="productEditModalLabel" aria-hidden="true"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        (function() {
            const activePeriod = '@soldPeriod';
            const activeFromDate = '@fromDateVal';
            const activeToDate = '@toDateVal';
            const activePeriodLabel = '@periodLabel';

            let currentPeriod = activePeriod;
            let currentProductId = null;
            let productChartInstance = null;
            let productsDropdownLoaded = false;

            const colorsTop5 = [
                '#c49b63', // Katinat gold
                '#6f4e37', // Katinat coffee brown
                '#23845b', // Matcha green
                '#3b82f6', // Ocean blue
                '#d97706'  // Warm amber
            ];

            async function fetchProductChartData(period, productId) {
                currentPeriod = period || currentPeriod;
                currentProductId = productId !== undefined ? productId : currentProductId;

                let url = `/Admin/Products/GetProductSalesChartData?period=${encodeURIComponent(currentPeriod)}`;
                if (activeFromDate && activeToDate) {
                    url += `&fromDate=${encodeURIComponent(activeFromDate)}&toDate=${encodeURIComponent(activeToDate)}`;
                }
                if (currentProductId) {
                    url += `&productId=${currentProductId}`;
                }
                
                try {
                    const res = await fetch(url);
                    if (!res.ok) throw new Error("Không thể tải dữ liệu biểu đồ.");
                    const data = await res.json();
                    renderChart(data);
                } catch (err) {
                    console.error("Lỗi tải biểu đồ:", err);
                }
            }

            function renderChart(data) {
                const canvas = document.getElementById('productTopSalesChart');
                if (!canvas) return;

                const titleEl = document.getElementById('productChartTitle');
                const subtitleEl = document.getElementById('productChartSubtitle');
                const backBtn = document.getElementById('btnBackToTop5');
                const badgeTotal = document.getElementById('chartTotalBadge');
                const selectEl = document.getElementById('productSelectFilter');
                const listEl = document.getElementById('top5ProductList');

                // Tự động nạp danh sách món vào select dropdown nếu chưa có
                if (data.allProducts && data.allProducts.length > 0 && !productsDropdownLoaded && selectEl) {
                    data.allProducts.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p.productId;
                        opt.textContent = p.productName;
                        selectEl.appendChild(opt);
                    });
                    productsDropdownLoaded = true;
                }

                if (productChartInstance) {
                    productChartInstance.destroy();
                    productChartInstance = null;
                }

                if (data.mode === 'top5') {
                    // Cập nhật danh sách 5 món bán chạy bên trái
                    if (listEl) {
                        if (!data.items || data.items.length === 0) {
                            listEl.innerHTML = '<div class="text-center py-4 text-muted small"><i class="fas fa-inbox mr-1"></i> Chưa có dữ liệu bán trong kỳ này.</div>';
                        } else {
                            let html = '';
                            data.items.forEach((item, idx) => {
                                const rank = idx + 1;
                                let rankClass = 'top5-rank-other';
                                let rankIcon = `#${rank}`;
                                if (rank === 1) {
                                    rankClass = 'top5-rank-1';
                                    rankIcon = '<i class="fas fa-crown"></i> 1';
                                } else if (rank === 2) {
                                    rankClass = 'top5-rank-2';
                                    rankIcon = '2';
                                } else if (rank === 3) {
                                    rankClass = 'top5-rank-3';
                                    rankIcon = '3';
                                }

                                const imgHtml = item.image
                                    ? `<img src="${item.image}" alt="${escapeHtml(item.productName)}" class="top5-thumb mr-2" onerror="this.outerHTML='<div class=\\\'top5-thumb-placeholder mr-2\\\'><i class=\\\'fas fa-coffee\\\'></i></div>'">`
                                    : `<div class="top5-thumb-placeholder mr-2"><i class="fas fa-coffee"></i></div>`;

                                html += `
                                    <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-2 mb-1 top5-item js-top5-item" data-id="${item.productId}" onclick="selectProductFromList(${item.productId})">
                                        <div class="d-flex align-items-center overflow-hidden mr-2">
                                            <span class="top5-rank-badge ${rankClass} mr-2 font-weight-bold">${rankIcon}</span>
                                            ${imgHtml}
                                            <div class="text-truncate">
                                                <div class="font-weight-bold text-dark text-truncate small">${escapeHtml(item.productName)}</div>
                                                <div class="text-muted" style="font-size: 11px;">${escapeHtml(item.categoryName || 'Món uống')}</div>
                                            </div>
                                        </div>
                                        <div class="text-right flex-shrink-0">
                                            <span class="badge badge-pill font-weight-bold" style="background-color: #f5eee8; color: #6f4e37; border: 1px solid #d8c7b8; font-size: 11px; padding: 3px 8px;">${item.totalSold} ly</span>
                                        </div>
                                    </a>
                                `;
                            });
                            listEl.innerHTML = html;
                        }
                    }

                    titleEl.innerHTML = `<i class="fas fa-crown text-warning mr-1"></i> Biểu Đồ Top 5 Món Bán Chạy (${activePeriodLabel})`;
                    subtitleEl.textContent = 'Bấm vào cột món trên biểu đồ hoặc danh sách bên trái để xem chi tiết theo ngày.';
                    if (backBtn) backBtn.style.display = 'none';
                    if (badgeTotal) badgeTotal.style.display = 'none';
                    if (selectEl) selectEl.value = '';

                    const labels = (data.items || []).map(x => x.productName);
                    const values = (data.items || []).map(x => x.totalSold);
                    const bgColors = labels.map((_, i) => colorsTop5[i % colorsTop5.length]);

                    productChartInstance = new Chart(canvas, {
                        type: 'bar',
                        data: {
                            labels: labels.length > 0 ? labels : ['Chưa có dữ liệu bán'],
                            datasets: [{
                                label: 'Số lượng bán (ly/món)',
                                data: values.length > 0 ? values : [0],
                                backgroundColor: bgColors,
                                borderRadius: 6,
                                maxBarThickness: 45
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(ctx) {
                                            return ` Đã bán: ${ctx.parsed.y} ly/món`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        precision: 0,
                                        stepSize: 1
                                    },
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.05)'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    }
                                }
                            },
                            onClick: function(evt, elements) {
                                if (elements && elements.length > 0) {
                                    const index = elements[0].index;
                                    const item = (data.items || [])[index];
                                    if (item && item.productId) {
                                        selectProductFromList(item.productId);
                                    }
                                }
                            },
                            onHover: function(evt, elements) {
                                evt.native.target.style.cursor = (elements && elements.length > 0) ? 'pointer' : 'default';
                            }
                        }
                    });
                } else if (data.mode === 'product_daily') {
                    // Tô sáng món được chọn trong danh sách bên trái
                    document.querySelectorAll('.js-top5-item').forEach(el => {
                        if (parseInt(el.getAttribute('data-id'), 10) === data.productId) {
                            el.classList.add('active-item');
                        } else {
                            el.classList.remove('active-item');
                        }
                    });

                    titleEl.innerHTML = `<i class="fas fa-chart-line text-success mr-1"></i> Số Lượng Bán Theo Ngày: <strong>${escapeHtml(data.productName)}</strong>`;
                    subtitleEl.textContent = `Xu hướng bán từng ngày của món trong kỳ (${activePeriodLabel}).`;
                    if (backBtn) backBtn.style.display = 'inline-block';
                    if (badgeTotal) {
                        badgeTotal.style.display = 'inline-block';
                        badgeTotal.textContent = `Tổng bán: ${data.totalSold} ly/món`;
                    }
                    if (selectEl) selectEl.value = data.productId;

                    const labels = (data.items || []).map(x => x.date);
                    const values = (data.items || []).map(x => x.count);

                    productChartInstance = new Chart(canvas, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Số lượng bán',
                                data: values,
                                backgroundColor: 'rgba(196, 155, 99, 0.8)',
                                hoverBackgroundColor: '#6f4e37',
                                borderColor: '#6f4e37',
                                borderWidth: 1,
                                borderRadius: 4,
                                maxBarThickness: 32
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        title: function(items) {
                                            if (!items || !items.length) return '';
                                            const idx = items[0].dataIndex;
                                            return data.items[idx]?.fullDate || items[0].label;
                                        },
                                        label: function(ctx) {
                                            return ` Đã bán: ${ctx.parsed.y} ly/món`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        precision: 0,
                                        stepSize: 1
                                    },
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.05)'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    }
                                }
                            }
                        }
                    });
                }
            }

            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            window.selectProductFromList = function(productId) {
                currentProductId = productId;
                fetchProductChartData(currentPeriod, currentProductId);
            };

            window.returnToTop5 = function() {
                currentProductId = null;
                // Bỏ highlight danh sách bên trái
                document.querySelectorAll('.js-top5-item').forEach(el => el.classList.remove('active-item'));
                fetchProductChartData(currentPeriod, null);
            };

            window.onSelectProductChange = function(val) {
                if (!val) {
                    window.returnToTop5();
                } else {
                    window.selectProductFromList(parseInt(val, 10));
                }
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => fetchProductChartData(activePeriod, null));
            } else {
                fetchProductChartData(activePeriod, null);
            }
        })();

        (function () {
            const modalElement = document.getElementById("productEditModal");
            const modal = $(modalElement);

            document.addEventListener("click", async function (event) {
                const link = event.target.closest(".js-edit-product, .js-create-product");
                if (!link) return;

                event.preventDefault();
                try {
                    const response = await fetch(link.href, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) throw new Error("Không tải được thông tin sản phẩm.");
                    modal.html(await response.text());
                    modal.modal("show");
                } catch (error) {
                    window.alert(error.message);
                }
            });

            modal.on("submit", ".product-edit-form", async function (event) {
                event.preventDefault();
                const form = event.currentTarget;
                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.disabled = true;

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    const contentType = response.headers.get("content-type") || "";
                    if (!response.ok) throw new Error("Không thể lưu sản phẩm. Vui lòng thử lại.");

                    if (contentType.includes("application/json")) {
                        modal.modal("hide");
                        window.location.reload();
                        return;
                    }

                    modal.html(await response.text());
                    modal.modal("show");
                } catch (error) {
                    window.alert(error.message);
                    submitButton.disabled = false;
                }
            });

            modal.on("click", ".js-add-product-variant", function () {
                const container = modal.find("#productVariants");
                const index = container.find(".product-variant-row").length;
                const row = `
                        <div class="form-row align-items-end product-variant-row">
                            <div class="form-group col-md-5">
                                <label>Kích cỡ</label>
                                <input name="Variants[${index}].KichCo" class="form-control" maxlength="20" required />
                            </div>
                            <div class="form-group col-md-5">
                                <label>Giá bán (đ)</label>
                                <input name="Variants[${index}].GiaBan" class="form-control" type="number" min="0.01" step="1000" required />
                            </div>
                            <div class="form-group col-md-2">
                                <button type="button" class="button button-small button-outline text-danger js-remove-product-variant">Xóa</button>
                            </div>
                        </div>`;
                container.append(row);
            });

            modal.on("click", ".js-remove-product-variant", function () {
                $(this).closest(".product-variant-row").remove();
                modal.find("#productVariants .product-variant-row").each(function (index) {
                    $(this).find("[name]").each(function () {
                        this.name = this.name.replace(/Variants\[\d+\]/, `Variants[${index}]`);
                    });
                });
            });

            modal.on("hidden.bs.modal", function () {
                modal.empty();
            });
        })();
    </script>
}
