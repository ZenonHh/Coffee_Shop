@model List<CoffeeShop.Business.ViewModels.VoucherListItemViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý Voucher";
    var editing = ViewBag.EditVoucher as CoffeeShop.Data.Entities.Voucher;
    string DateValue(DateTime? value) => value?.ToString("yyyy-MM-ddTHH:mm") ?? "";
    var isSingleUse = editing?.SoLuongToiDa == 1;
}
<style>
    .btn-active-coffee {
        background-color: #6f4e37 !important;
        border-color: #6f4e37 !important;
        color: #ffffff !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        padding: 4px 12px !important;
        box-shadow: 0 2px 4px rgba(111, 78, 55, 0.15) !important;
    }
    .btn-outline-coffee {
        background-color: #ffffff !important;
        border-color: #ded7cf !important;
        color: #615c54 !important;
        font-size: 12px !important;
        font-weight: 500 !important;
        padding: 4px 12px !important;
    }
    .btn-outline-coffee:hover {
        background-color: #fdfaf7 !important;
        border-color: #6f4e37 !important;
        color: #6f4e37 !important;
    }
    .voucher-type-btn-group .btn {
        min-height: 28px !important;
        line-height: 1.4 !important;
    }
</style>

<div class="welcome-row page-title-row"><div><div class="eyebrow">KHUYẾN MÃI</div><h1>Quản lý voucher</h1><p class="page-subtitle">Quản lý mã giảm giá dùng 1 lần hoặc nhiều lần, thời hạn, chương trình và điều kiện áp dụng.</p></div></div>
@if (ViewBag.FormError != null) { <div class="alert alert-danger">@ViewBag.FormError</div> }
<div class="dashboard-grid">
<section class="panel"><div class="panel-heading"><div><h2>@(editing == null ? "Tạo voucher mới" : "Chỉnh sửa voucher")</h2><p>Mã có thể dùng 1 lần duy nhất hoặc nhiều lần với số lượng tối đa.</p></div></div>
<form asp-action="@(editing == null ? "Create" : "Edit")" method="post" class="dialog-form px-0">
@Html.AntiForgeryToken()
@if (editing != null) { <input type="hidden" name="MaVoucher" value="@editing.MaVoucher" /> }
<label>Mã voucher<input name="MaCode" value="@(editing?.MaCode ?? "")" maxlength="50" required placeholder="VD: COFFEE10" /></label>
<label>Tên chương trình<input name="TenChuongTrinh" value="@(editing?.TenChuongTrinh ?? "")" maxlength="150" placeholder="VD: Khuyến mãi cuối tuần" /></label>

<div class="form-group mb-3">
    <label class="d-block font-weight-bold mb-1" style="font-size: 13px;">Loại voucher</label>
    <input type="hidden" id="usageTypeInput" name="usageType" value="@(isSingleUse ? "single" : "multi")" />
    <div class="btn-group btn-group-sm voucher-type-btn-group" role="group" aria-label="Loại sử dụng voucher">
        <button type="button" class="btn btn-sm js-type-btn @(isSingleUse ? "btn-active-coffee" : "btn-outline-coffee")" data-type="single" onclick="setUsageType('single')">
            <i class="fas fa-ticket-alt mr-1"></i> Dùng 1 lần
        </button>
        <button type="button" class="btn btn-sm js-type-btn @(!isSingleUse ? "btn-active-coffee" : "btn-outline-coffee")" data-type="multi" onclick="setUsageType('multi')">
            <i class="fas fa-sync-alt mr-1"></i> Dùng nhiều lần
        </button>
    </div>
</div>

<div class="dialog-fields"><label>Loại giảm<select name="PhanLoaiGiam"><option value="PERCENT" selected="@(editing?.PhanLoaiGiam == "PERCENT" || editing == null)">Phần trăm (%)</option><option value="AMOUNT" selected="@(editing?.PhanLoaiGiam == "AMOUNT")">Số tiền (đ)</option></select></label><label>Giá trị giảm<input name="GiaTriGiam" type="number" min="0" step="0.01" value="@(editing?.GiaTriGiam.ToString(CultureInfo.InvariantCulture) ?? "")" required /></label></div>
<div class="dialog-fields"><label>Bắt đầu<input name="NgayBatDau" type="datetime-local" value="@DateValue(editing?.NgayBatDau)" /></label><label>Kết thúc<input name="NgayKetThuc" type="datetime-local" value="@DateValue(editing?.NgayKetThuc)" /></label></div>
<label>Đơn tối thiểu (đ)<input name="DonToiThieu" type="number" min="0" step="1000" value="@(editing?.DonToiThieu.ToString(CultureInfo.InvariantCulture) ?? "0")" /></label>
<div class="dialog-fields">
    <label>Giảm tối đa (đ)<input name="GiamToiDa" type="number" min="0" step="1000" value="@(editing?.GiamToiDa?.ToString(CultureInfo.InvariantCulture) ?? "")" placeholder="Không bắt buộc" /></label>
    <label id="maxUsageWrapper">
        <span id="maxUsageTitle">Số lượt tối đa</span>
        <input id="soLuongToiDaInput" name="SoLuongToiDa" type="number" min="1" step="1" value="@(editing?.SoLuongToiDa.ToString(CultureInfo.InvariantCulture) ?? "100")" required />
        <small id="maxUsageHelp" class="text-muted d-block mt-1">
            @(isSingleUse ? "Voucher chỉ dùng được 1 lần duy nhất." : "Voucher có thể áp dụng cho nhiều đơn hàng đến khi hết số lượt.")
        </small>
    </label>
</div>
@if (editing != null) { <label class="d-flex flex-row align-items-center" style="gap:8px;"><input name="TrangThai" type="checkbox" value="true" checked="@editing.TrangThai" /> Đang hoạt động</label> }
else { <input type="hidden" name="TrangThai" value="true" /> }
<div class="dialog-actions">@if (editing != null) { <a asp-action="Index" class="button button-outline">Hủy</a> }<button class="button button-primary" type="submit">@(editing == null ? "Tạo voucher" : "Lưu thay đổi")</button></div>
</form></section>
<section class="panel"><div class="panel-heading"><div><h2>Quy tắc áp dụng</h2><p>Điều kiện được kiểm tra ngay tại giỏ hàng.</p></div></div>
<div class="category-note mt-4"><strong>🎟️ Voucher 1 lần:</strong> Các mã do khách hàng đổi từ điểm thưởng và mã do admin tạo chọn "Dùng 1 lần" chỉ xài được 1 lần duy nhất cho 1 đơn hàng, dùng xong tự động hết hiệu lực.</div>
<div class="category-note mt-3"><strong>🔁 Voucher nhiều lần:</strong> Mã do admin tạo với số lượt tối đa, cho phép nhiều đơn hàng áp dụng đến khi chạm số lượt tối đa.</div>
<div class="category-note mt-3"><strong>Giảm tự động:</strong> đơn từ 200.000đ giảm 5.000đ, từ 300.000đ giảm 15.000đ, từ 500.000đ giảm 30.000đ.</div>
<div class="category-note mt-3">Có thể sửa, bật/tắt hoặc xóa từng chương trình ở danh sách bên dưới.</div>
</section>
</div>
<section class="panel table-panel"><div class="panel-heading table-heading table-card-header"><div><h2>Danh sách voucher</h2><p>@(((CoffeeShop.Business.ViewModels.PaginationViewModel)ViewBag.Pagination).TotalCount) mã giảm giá trong hệ thống.</p></div></div><div class="table-scroll"><table class="data-table admin-data-table admin-table--vouchers custom-admin-table"><thead><tr><th>MÃ CODE</th><th>CHƯƠNG TRÌNH</th><th>LOẠI</th><th>GIẢM</th><th>THỜI HẠN</th><th>LƯỢT DÙNG</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach (var voucher in Model)
{
    var activeTime = (!voucher.NgayBatDau.HasValue || voucher.NgayBatDau <= DateTime.Now)
        && (!voucher.NgayKetThuc.HasValue || voucher.NgayKetThuc >= DateTime.Now);
    <tr>
        <td class="order-id col-center">@voucher.MaCode</td>
        <td>@(voucher.TenChuongTrinh ?? "—")</td>
        <td class="col-center">
            @if (voucher.IsSingleUse)
            {
                <span class="badge" style="background: #fdf6ed; color: #8c5b2f; border: 1px solid #edd5be; font-size: 11px; padding: 3px 8px; font-weight: 600; border-radius: 4px;">
                    🎟️ 1 Lần
                </span>
            }
            else
            {
                <span class="badge" style="background: #f5eee8; color: #4d3528; border: 1px solid #d8c7b8; font-size: 11px; padding: 3px 8px; font-weight: 600; border-radius: 4px;">
                    🔁 Nhiều Lần
                </span>
            }
        </td>
        <td class="money-cell">@voucher.GiaTriGiam.ToString("N0")@(voucher.PhanLoaiGiam == "PERCENT" ? "%" : " đ")</td>
        <td>
            @(voucher.NgayBatDau?.ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")
            <br />
            <span class="muted-cell">→ @(voucher.NgayKetThuc?.ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")</span>
        </td>
        <td class="col-center">
            @if (voucher.IsSingleUse)
            {
                if (voucher.SoLuongDaDung >= 1)
                {
                    <span class="text-danger font-weight-bold small">
                        <i class="fas fa-check-circle mr-1"></i>Đã dùng (1/1)
                    </span>
                }
                else
                {
                    <span class="text-success font-weight-bold small">
                        <i class="fas fa-clock mr-1"></i>Chưa dùng (0/1)
                    </span>
                }
            }
            else
            {
                <div><strong>@voucher.SoLuongDaDung / @voucher.SoLuongToiDa</strong></div>
                @if (voucher.SoLuongDaDung >= voucher.SoLuongToiDa)
                {
                    <span class="badge badge-secondary" style="font-size: 10px;">Hết lượt</span>
                }
                else
                {
                    <span class="muted-cell small">Còn @(voucher.SoLuongToiDa - voucher.SoLuongDaDung) lượt</span>
                }
            }
        </td>
        <td class="col-center">
            <span class="status @(voucher.TrangThai && activeTime ? "status-success" : "status-muted")">
                <i></i>@(voucher.TrangThai ? (activeTime ? "Đang áp dụng" : "Ngoài thời hạn") : "Đang tắt")
            </span>
        </td>
        <td>
            <div class="table-actions">
                <a asp-action="Index" asp-route-editId="@voucher.MaVoucher" class="button button-small button-outline">Sửa</a>
                <form asp-action="ToggleStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@voucher.MaVoucher" />
                    <button class="button button-small button-outline" type="submit">@(voucher.TrangThai ? "Tắt" : "Bật")</button>
                </form>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa voucher này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@voucher.MaVoucher" />
                    <button class="button button-small button-outline text-danger" type="submit">Xóa</button>
                </form>
            </div>
        </td>
    </tr>
}
@if (!Model.Any()) { <tr><td colspan="8" class="text-center py-4 muted-cell">Chưa có voucher nào.</td></tr> }
</tbody></table></div><partial name="_Pagination" model="ViewBag.Pagination" /></section>

<script>
    function setUsageType(val) {
        var hiddenInput = document.getElementById('usageTypeInput');
        var input = document.getElementById('soLuongToiDaInput');
        var help = document.getElementById('maxUsageHelp');
        if (hiddenInput) hiddenInput.value = val;

        document.querySelectorAll('.js-type-btn').forEach(function(btn) {
            if (btn.getAttribute('data-type') === val) {
                btn.classList.remove('btn-outline-coffee');
                btn.classList.add('btn-active-coffee');
            } else {
                btn.classList.remove('btn-active-coffee');
                btn.classList.add('btn-outline-coffee');
            }
        });

        if (!input) return;
        if (val === 'single') {
            input.value = 1;
            input.readOnly = true;
            input.style.backgroundColor = '#f1f5f9';
            if (help) help.textContent = 'Voucher chỉ dùng được 1 lần duy nhất.';
        } else {
            if (input.value == 1) input.value = 100;
            input.readOnly = false;
            input.style.backgroundColor = '#fff';
            if (help) help.textContent = 'Voucher có thể áp dụng cho nhiều đơn hàng đến khi hết số lượt.';
        }
    }
    document.addEventListener('DOMContentLoaded', function() {
        var currentType = document.getElementById('usageTypeInput')?.value || 'multi';
        if (currentType === 'single') {
            setUsageType('single');
        }
    });
</script>