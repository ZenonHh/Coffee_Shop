@model CoffeeShop.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập khách hàng - Katinat Coffee";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); height: 450px; min-height: 450px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 450px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Đăng Nhập Khách Hàng</h1>
                    <p class="breadcrumbs mb-0"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> <span>Đăng nhập</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section login-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6 ftco-animate">
                <div class="login-card">
                    <div class="text-center login-heading">
                        <span class="subheading">Tài Khoản Thành Viên</span>
                        <h3>Đăng Nhập Khách Hàng</h3>
                        <p>Chào mừng bạn quay trở lại Katinat Coffee</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                        </div>
                    }

                    <form asp-action="Login" method="post" class="login-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        
                        <div class="form-group">
                            <label asp-for="Username">Tên đăng nhập <span>*</span></label>
                            <input type="text" asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="username" required />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">Mật khẩu <span>*</span></label>
                            <input type="password" asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-group d-flex justify-content-between align-items-center login-options">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" asp-for="RememberMe" class="custom-control-input" id="rememberMe">
                                <label class="custom-control-label text-light" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary login-submit">Đăng Nhập</button>

                        <div class="text-center login-register">
                            Chưa có tài khoản? <a asp-action="Register" class="text-primary font-weight-bold">Đăng ký thành viên ngay</a>
                        </div>
                    </form>
                    <div class="text-center login-admin-link"><a asp-area="Admin" asp-controller="Account" asp-action="Login">Đăng nhập khu vực quản trị</a></div>
                </div>
            </div>
        </div>
    </div>
</section>
