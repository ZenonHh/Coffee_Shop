@model List<CoffeeShop.Models.ViewModels.ProfileOrderViewModel>
@{
    ViewData["Title"] = "Lịch sử đơn hàng - Katinat Coffee";
}

<section class="ftco-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-white mb-1">Lịch sử đơn hàng</h2>
                <p class="text-muted mb-0">Theo dõi các đơn hàng bạn đã đặt tại cửa hàng.</p>
            </div>
            <a asp-action="Profile" class="btn btn-outline-primary mt-3 mt-md-0">Thông tin cá nhân</a>
        </div>

        <div class="p-3 p-md-4 bg-dark border border-secondary rounded">
            @if (Model.Count > 0)
            {
                <div class="table-responsive order-history-table">
                    <table class="table text-white text-center">
                        <thead class="thead-primary">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày tạo</th>
                                <th>Món đã đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var code = $"#HD{order.MaHD:D4}";
                                <tr>
                                    <td>
                                        <div class="order-hover-container">
                                            <a asp-controller="Checkout" asp-action="Success" asp-route-id="@order.MaHD" class="font-weight-bold text-primary" style="text-decoration: underline;">
                                                @code
                                            </a>
                                            <div class="order-hover-card">
                                                <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom" style="border-color: rgba(255,255,255,0.15) !important;">
                                                    <strong style="color: #c49b63; font-size: 13px;">Đơn hàng @code</strong>
                                                    <span class="badge badge-primary">@order.TrangThai</span>
                                                </div>
                                                <div class="mb-1 text-muted small">Thời gian: @order.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                                                <div class="p-2 rounded mb-2" style="background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.08); font-size: 11.5px;">
                                                    <div class="text-muted mb-1 font-weight-bold">Món đã đặt:</div>
                                                    @foreach (var detail in order.OrderDetails)
                                                    {
                                                        <div class="text-truncate">• @detail.TenSP x @detail.SoLuong</div>
                                                    }
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
                                                    <div>
                                                        <span class="text-muted small">Tổng:</span>
                                                        <strong style="color: #ffc107; font-size: 13px;">@order.TongTien.ToString("N0") đ</strong>
                                                    </div>
                                                    <a asp-controller="Checkout" asp-action="Success" asp-route-id="@order.MaHD" class="btn btn-sm btn-primary py-1 px-2" style="font-size: 11px;">
                                                        Xem chi tiết &rarr;
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-left small">
                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            <div>• @detail.TenSP x @detail.SoLuong</div>
                                        }
                                    </td>
                                    <td class="text-warning font-weight-bold">@order.TongTien.ToString("N0") đ</td>
                                    <td>
                                        <span class="badge @(order.TrangThai == "Đã hủy" ? "badge-danger" : "badge-info")">@order.TrangThai</span>
                                        @if (order.TrangThai == "Đã hủy" && !string.IsNullOrWhiteSpace(order.LyDoHuy))
                                        {
                                            <div class="small text-danger mt-1">@order.LyDoHuy</div>
                                        }
                                        else if (order.TrangThai != "Đã hủy")
                                        {
                                            <div class="small text-muted mt-1">@order.TrackerText</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-3">Bạn chưa có đơn hàng nào tại cửa hàng.</p>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-sm">Đặt món ngay</a>
                </div>
            }
        </div>
    </div>
</section>
