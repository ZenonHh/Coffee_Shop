@model CoffeeShop.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Trang Cá Nhân & Điểm Tích Lũy - Katinat Coffee";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); height: 670px; min-height: 670px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 670px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Hồ Sơ Khách Hàng</h1>
                    <p class="breadcrumbs mb-0"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> <span>Tài khoản</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <!-- Thẻ Hội viên & Điểm tích lũy -->
            <div class="col-lg-4 mb-4 ftco-animate">
                <div class="p-4 rounded text-center" style="background: #171412; border: 1.5px solid rgba(196, 155, 99, 0.4); box-shadow: 0 8px 25px rgba(0,0,0,0.5);">
                    <div class="rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 80px; height: 80px; background: rgba(196, 155, 99, 0.15); border: 1.5px solid #c49b63;">
                        <span class="icon-person" style="font-size: 40px; color: #c49b63;"></span>
                    </div>
                    <h4 class="text-white mb-1 font-weight-bold">@Model.Customer.HoTen</h4>
                    <p class="text-muted mb-3 small">Tài khoản: @@(@Model.Customer.TaiKhoan)</p>

                    <div class="p-3 rounded mb-3" style="background: #201a15; border: 1px solid rgba(196, 155, 99, 0.25);">
                        <span class="text-muted d-block small" style="letter-spacing: 1px;">HẠNG THÀNH VIÊN</span>
                        <h3 class="font-weight-bold mb-0" style="color: #c49b63;">@Model.Customer.HangTV</h3>
                    </div>

                    <div class="p-3 rounded" style="background: #201a15; border: 1px solid rgba(196, 155, 99, 0.25);">
                        <span class="text-muted d-block small" style="letter-spacing: 1px;">ĐIỂM TÍCH LŨY HIỆN CÓ</span>
                        <h2 class="font-weight-bold mb-0" style="color: #c49b63;">@Model.Customer.DiemTichLuy <small style="font-size: 16px;">điểm</small></h2>
                        <small class="text-muted d-block mt-1">(Tích lũy 1 điểm mỗi 10.000 đ đơn hàng)</small>
                    </div>
                </div>

                <!-- Lịch sử điểm -->
                <div class="p-4 rounded mt-4" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.25);">
                    <h5 class="text-white mb-3 font-weight-bold" style="color: #c49b63 !important;">Biến Động Điểm Gần Đây</h5>
                    @if (Model.PointHistories.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var point in Model.PointHistories)
                            {
                                <li class="border-bottom border-secondary pb-2 mb-2 text-light small d-flex justify-content-between">
                                    <div>
                                        <div>@point.LyDo</div>
                                        <div class="text-muted" style="font-size: 11px;">@point.NgayThucHien.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                    <span class="text-success font-weight-bold">+@point.DiemThayDoi</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Chưa có lịch sử cộng điểm nào.</p>
                    }
                </div>
            </div>

            <!-- Cập nhật thông tin & Lịch sử đơn hàng -->
            <div class="col-lg-8 ftco-animate">
                <div id="profileReadView" class="p-4 bg-dark border border-secondary rounded mb-4 @(ViewBag.ShowProfileEdit == true ? "d-none" : string.Empty)">
                    <h4 class="text-white mb-4">Thông Tin Cá Nhân</h4>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Họ và tên</span>
                            <strong class="text-white">@Model.Customer.HoTen</strong>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Tên đăng nhập</span>
                            <strong class="text-white">@Model.Customer.TaiKhoan</strong>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Số điện thoại</span>
                            <strong class="text-white">@Model.Customer.Sdt</strong>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Email</span>
                            <strong class="text-white">@(string.IsNullOrWhiteSpace(Model.Customer.Email) ? "Chưa cập nhật" : Model.Customer.Email)</strong>
                        </div>
                        <div class="col-12 mb-3">
                            <span class="text-muted d-block small">Địa chỉ mặc định</span>
                            <strong class="text-white">@(string.IsNullOrWhiteSpace(Model.Customer.DiaChi) ? "Chưa cập nhật" : Model.Customer.DiaChi)</strong>
                        </div>
                    </div>
                    <button id="showProfileEdit" type="button" class="btn btn-primary py-2 px-4">Chỉnh sửa thông tin</button>
                </div>

                <div id="profileEditView" class="p-4 bg-dark border border-secondary rounded mb-4 @(ViewBag.ShowProfileEdit == true ? string.Empty : "d-none")">
                    <h4 class="text-white mb-4">Chỉnh Sửa Thông Tin</h4>
                    <form asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="text-white">Họ và tên</label>
                                <input asp-for="EditProfile.FullName" class="form-control" autocomplete="name" required />
                                <span asp-validation-for="EditProfile.FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="text-white">Số điện thoại</label>
                                <input asp-for="EditProfile.Phone" class="form-control" type="tel" inputmode="numeric" autocomplete="tel" maxlength="10" required />
                                <span asp-validation-for="EditProfile.Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="text-white">Email</label>
                                <input asp-for="EditProfile.Email" class="form-control" type="email" autocomplete="email" />
                                <span asp-validation-for="EditProfile.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="text-white">Địa chỉ mặc định</label>
                                <input asp-for="EditProfile.Address" class="form-control" autocomplete="street-address" />
                                <span asp-validation-for="EditProfile.Address" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="text-white">Tên đăng nhập</label>
                            <input class="form-control" value="@Model.Customer.TaiKhoan" readonly aria-readonly="true" />
                        </div>
                        <button type="submit" class="btn btn-primary py-2 px-4 mt-2">Lưu thay đổi</button>
                        <button id="cancelProfileEdit" type="button" class="btn btn-outline-primary py-2 px-4 mt-2 ml-2">Hủy bỏ</button>
                    </form>
                </div>

                <!-- Đơn hàng đã đặt -->
                <div class="p-4 bg-dark border border-secondary rounded">
                    <h4 class="text-white mb-4">Lịch Sử Đơn Hàng Đã Đặt (@Model.RecentOrders.Count)</h4>
                    @if (Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table text-white text-center">
                                <thead class="thead-primary">
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Ngày tạo</th>
                                        <th>Món đã đặt</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        var code = $"#HD{order.MaHD:D4}";
                                        <tr>
                                            <td>
                                                <div class="order-hover-container">
                                                    <a asp-controller="Checkout" asp-action="Success" asp-route-id="@order.MaHD" class="font-weight-bold text-primary" style="text-decoration: underline;">
                                                        @code
                                                    </a>
                                                    <div class="order-hover-card">
                                                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom" style="border-color: rgba(255,255,255,0.15) !important;">
                                                            <strong style="color: #c49b63; font-size: 13px;">Đơn hàng @code</strong>
                                                            <span class="badge badge-primary">@order.TrangThai</span>
                                                        </div>
                                                        <div class="mb-1 text-muted small">Thời gian: @order.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                                                        <div class="p-2 rounded mb-2" style="background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.08); font-size: 11.5px;">
                                                            <div class="text-muted mb-1 font-weight-bold">Món đã đặt:</div>
                                                            @foreach (var detail in order.OrderDetails)
                                                            {
                                                                <div class="text-truncate">• @detail.TenSP x @detail.SoLuong</div>
                                                            }
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
                                                            <div>
                                                                <span class="text-muted small">Tổng:</span>
                                                                <strong style="color: #ffc107; font-size: 13px;">@order.TongTien.ToString("N0") đ</strong>
                                                            </div>
                                                            <a asp-controller="Checkout" asp-action="Success" asp-route-id="@order.MaHD" class="btn btn-sm btn-primary py-1 px-2" style="font-size: 11px;">
                                                                Xem chi tiết &rarr;
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@order.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-left small">
                                                @foreach (var detail in order.OrderDetails)
                                                {
                                                    <div>• @detail.TenSP x @detail.SoLuong</div>
                                                }
                                            </td>
                                            <td class="text-warning font-weight-bold">@order.TongTien.ToString("N0") đ</td>
                                            <td>
                                                <span class="badge @(order.TrangThai == "Đã hủy" ? "badge-danger" : "badge-info")">@order.TrangThai</span>
                                                @if (order.TrangThai == "Đã hủy" && !string.IsNullOrWhiteSpace(order.LyDoHuy))
                                                {
                                                    <div class="small text-danger mt-1">@order.LyDoHuy</div>
                                                }
                                                else if (order.TrangThai != "Đã hủy")
                                                {
                                                    <div class="small text-muted mt-1">@order.TrackerText</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Bạn chưa có đơn hàng nào tại cửa hàng.</p>
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-sm">Đặt món ngay</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
        const readView = document.getElementById("profileReadView");
        const editView = document.getElementById("profileEditView");
        document.getElementById("showProfileEdit")?.addEventListener("click", () => {
            readView?.classList.add("d-none");
            editView?.classList.remove("d-none");
        });
        document.getElementById("cancelProfileEdit")?.addEventListener("click", () => {
            editView?.classList.add("d-none");
            readView?.classList.remove("d-none");
        });
    })();
</script>
