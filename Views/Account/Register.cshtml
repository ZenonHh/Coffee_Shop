@model CoffeeShop.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Thành Viên - Katinat Coffee";
}

<div class="register-page">
<section class="home-slider owl-carousel">
    <div class="slider-item register-banner" style="background-image: url(/images/bg_3.jpg);">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Đăng Ký Thành Viên</h1>
                    <p class="breadcrumbs mb-0"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> <span>Đăng ký</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section register-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 ftco-animate">
                <div class="register-card rounded" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.35); box-shadow: 0 4px 25px rgba(0,0,0,0.45);">
                    <div class="text-center mb-4">
                        <span class="subheading" style="color: #c49b63; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700;">Gia Nhập Katinat Coffee</span>
                        <h3 class="text-white mt-1" style="font-family: 'Josefin Sans', sans-serif;">Tạo Tài Khoản Thành Viên</h3>
                    </div>
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0" })
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="form-group mb-3">
                            <label class="text-white">Họ và tên *</label>
                            <input type="text" asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A..." required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-white">Tên đăng nhập *</label>
                            <input type="text" asp-for="Username" class="form-control" placeholder="username123..." required />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-white">Số điện thoại *</label>
                            <input type="tel" asp-for="Phone" class="form-control" placeholder="0909xxxxxx..." required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-white">Email (Tùy chọn)</label>
                            <input type="email" asp-for="Email" class="form-control" placeholder="email@gmail.com..." />
                        </div>

                        <div class="form-group mb-3">
                            <label class="text-white">Mật khẩu *</label>
                            <input type="password" asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự..." required />
                        </div>

                        <div class="form-group mb-4">
                            <label class="text-white">Xác nhận mật khẩu *</label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu..." required />
                        </div>

                        <button type="submit" class="btn btn-primary py-3 px-4 w-100">Hoàn Tất Đăng Ký</button>

                        <div class="text-center mt-4 text-light">
                            Đã có tài khoản? <a asp-action="Login" class="text-primary font-weight-bold">Đăng nhập tại đây</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
