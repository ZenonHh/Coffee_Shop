@model CoffeeShop.Models.Entities.Order
@{
    ViewData["Title"] = "Đặt Hàng Thành Công - Coffee Blend";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); height: 350px; min-height: 350px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 350px;">
                <div class="col-md-7 col-sm-12 text-center ftco-animate">
                    <h1 class="mb-3 mt-5 bread">Đặt Hàng Thành Công</h1>
                    <p class="breadcrumbs"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> <span>Hoàn tất</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center ftco-animate">
                <div class="p-5 bg-dark border border-success rounded">
                    <div class="mb-4">
                        <span class="icon-check_circle text-success" style="font-size: 80px;"></span>
                    </div>
                    <h2 class="text-white mb-3">Cảm ơn bạn đã đặt hàng!</h2>
                    <p class="lead text-light">Mã đơn hàng của bạn là: <strong class="text-primary">#@Model.MaHD</strong></p>
                    <p class="text-muted">Chúng tôi đã tiếp nhận đơn và đang chuẩn bị những ly đồ uống thơm ngon nhất cho bạn. Nhân viên giao hàng sẽ liên hệ với bạn trong ít phút qua số điện thoại <strong>@Model.SdtNguoiNhan</strong>.</p>
                    
                    <div class="card bg-secondary text-left text-white my-4 p-4 border-0">
                        <h5>Thông tin giao nhận</h5>
                        <p class="mb-1"><strong>Người nhận:</strong> @Model.HoTenNguoiNhan</p>
                        <p class="mb-1"><strong>Số điện thoại:</strong> @Model.SdtNguoiNhan</p>
                        <p class="mb-1"><strong>Địa chỉ giao:</strong> @Model.DiaChiGiao</p>
                        <p class="mb-1"><strong>Tổng thanh toán:</strong> <span class="text-warning font-weight-bold">@Model.TongTien.ToString("N0") đ</span></p>
                        <p class="mb-0"><strong>Trạng thái:</strong> <span class="badge badge-primary">@Model.TrangThai</span></p>
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary py-3 px-4 mr-2">Tiếp tục mua sắm</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-white py-3 px-4">Xem lịch sử đơn</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
