@model List<CoffeeShop.Models.ViewModels.HomeCategoryViewModel>
@{
    ViewData["Title"] = "Bài Viết & Khám Phá Món Mới - Katinat Coffee";

    var descriptionTemplates = new Dictionary<string, string>
    {
        { "Cà Phê", "Hạt Robusta & Arabica rang mộc nguyên chất, đậm đà vị truyền thống." },
        { "Cold Brew", "Ủ lạnh chậm trong 16 giờ giúp hương vị thanh mát, chua nhẹ và êm dịu." },
        { "Trà Trái Cây", "Trà thượng hạng kết hợp trái cây tươi mọng nước, giải nhiệt ngày dài." },
        { "Trà Sữa", "Trà thơm đậm vị quyện cùng sữa béo ngậy chuẩn công thức độc quyền." },
        { "Matcha", "Matcha nguyên chất chuẩn Nhật Bản, hương thơm thanh tao và béo nhẹ." },
        { "Bánh Ngọt", "Bánh nướng mới mỗi ngày, mềm xốp và hòa quyện tuyệt vời cùng đồ uống." }
    };
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); min-height: 670px; height: 670px;">
        <div class="overlay"></div>
        <div class="container">
            <!-- Thêm padding-top để chữ không bị đè bởi navbar và căn giữa đẹp mắt -->
            <div class="row slider-text justify-content-center align-items-center" style="height: 670px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Khám Phá Món Mới</h1>
                    <p class="breadcrumbs mb-2">
                        <span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> 
                        <span>Khám phá món</span>
                    </p>
                    <p class="text-white-50" style="max-width: 600px; margin: 0 auto;">
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Menu Sáng Tạo</span>
                <h2 class="mb-4">Bộ Sưu Tập Món Mới</h2>
                <p>Mỗi món uống là một câu chuyện về hương vị, được chúng tôi tuyển chọn và pha chế tỉ mỉ mỗi ngày.</p>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="row justify-content-center">
                <div class="col-md-8 text-center">
                    <p class="text-muted">Hiện chưa có món mới nào được cập nhật. Quý khách vui lòng quay lại sau.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var category in Model)
            {
                var activeProducts = category.Products;
                if (activeProducts == null || !activeProducts.Any())
                {
                    continue;
                }

                string desc = "Một trải nghiệm hương vị mới mẻ và độc đáo dành riêng cho bạn hôm nay.";
                foreach (var pair in descriptionTemplates)
                {
                    if (!string.IsNullOrEmpty(category.TenLoaiSP) && category.TenLoaiSP.Contains(pair.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        desc = pair.Value;
                        break;
                    }
                }

                <div class="mb-5 pb-3">
                    <div class="row justify-content-center mb-4">
                        <div class="col-md-8 heading-section text-center">
                            <h3 class="text-primary font-weight-bold" style="letter-spacing: 1px;">@category.TenLoaiSP</h3>
                            <p class="text-muted small">@desc</p>
                        </div>
                    </div>

                    <div class="row d-flex blog-product-grid">
                        @foreach (var product in activeProducts)
                        {
                            var imagePath = !string.IsNullOrEmpty(product.HinhAnh) 
                                ? (product.HinhAnh.StartsWith("/") ? product.HinhAnh : $"/picture/{product.HinhAnh}") 
                                : "/images/menu-1.jpg";

                            <div class="col-md-6 col-lg-4 d-flex blog-product-card ftco-animate">
                                <div class="blog-entry align-self-stretch w-100 position-relative" 
                                     style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; overflow: hidden; margin-bottom: 30px;">
                                    
                                    <!-- Badge Món Mới -->
                                    <span class="badge badge-warning position-absolute" 
                                          style="top: 15px; left: 15px; z-index: 2; padding: 6px 12px; font-weight: 600; font-size: 11px; letter-spacing: 0.5px;">
                                        MỚI
                                    </span>

                                    <!-- Ảnh món -->
                                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP" class="block-20 d-block" 
                                       style="background-image: url('@imagePath'); height: 260px; background-size: cover; background-repeat: no-repeat; background-position: center; background-color: #12100e;">
                                    </a>

                                    <div class="text py-4 px-3 d-block text-center">
                                        <div class="meta mb-2">
                                            <span class="text-muted small" style="text-transform: uppercase; letter-spacing: 1px;">@product.TenLoaiSP</span>
                                        </div>

                                        <!-- Tên món -->
                                        <h3 class="heading mt-1 mb-2">
                                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP" style="color: #fff; font-size: 20px; font-weight: 600;">
                                                @product.TenSP
                                            </a>
                                        </h3>

                                        <!-- Giá bán -->
                                        <div class="price mb-2">
                                            <span class="text-primary font-weight-bold" style="font-size: 18px;">
                                                @(product.GiaBan.HasValue ? product.GiaBan.Value.ToString("N0") + " ₫" : "Liên hệ")
                                            </span>
                                        </div>

                                        <!-- Mô tả hương vị -->
                                        <p class="text-muted small mb-3" style="min-height: 40px; line-height: 1.5;">
                                            Hương vị độc quyền pha chế theo tiêu chuẩn Barista của quán, thơm ngon tròn vị.
                                        </p>

                                        <!-- Nút thao tác -->
                                        <p class="mt-2 mb-0">
                                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP" class="btn btn-primary btn-outline-primary btn-sm px-3 py-2">
                                                Xem chi tiết & Đặt món
                                            </a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

<style>
    .blog-product-card .blog-entry {
        transition: transform 250ms ease, box-shadow 250ms ease;
    }

    .blog-product-card .blog-entry:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
    }

    @@media (prefers-reduced-motion: reduce) {
        .blog-product-card .blog-entry {
            transition: none;
            transform: none;
        }
    }
</style>