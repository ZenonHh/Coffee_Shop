@{
    ViewData["Title"] = "Liên Hệ - Coffee Blend";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); height: 450px; min-height: 450px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 450px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Liên Hệ Với Chúng Tôi</h1>
                    <p class="breadcrumbs mb-0"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> <span>Liên hệ</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section contact-section">
    <div class="container mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #a3e9b7;">
                <i class="icon-check_circle mr-2"></i> @TempData["Success"]
                <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="background: rgba(220, 53, 69, 0.2); border: 1px solid #dc3545; color: #f8b4b9;">
                <i class="icon-exclamation-triangle mr-2"></i> @TempData["Error"]
                <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row block-9">
            <div class="col-md-5 contact-info ftco-animate mb-4">
                <div class="p-4 p-md-5 rounded h-100" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.35); box-shadow: 0 4px 20px rgba(0,0,0,0.4);">
                    <div class="mb-4">
                        <span class="subheading" style="color: #c49b63; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700;">Kết Nối Ngay</span>
                        <h2 class="h3 text-white mt-1 mb-3" style="font-family: 'Josefin Sans', sans-serif;">Thông Tin Cửa Hàng</h2>
                        <p class="text-muted small">Chúng tôi luôn lắng nghe mọi ý kiến đóng góp, phản hồi hoặc yêu cầu hợp tác từ Quý khách hàng.</p>
                    </div>

                    <div class="mb-4 d-flex align-items-start">
                        <div class="mr-3" style="width: 42px; height: 42px; border-radius: 50%; background: rgba(196, 155, 99, 0.15); display: flex; align-items: center; justify-content: center; color: #c49b63; font-size: 18px; flex-shrink: 0;">
                            <span class="icon-map-marker"></span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Địa chỉ cửa hàng</span>
                            <span class="text-white font-weight-bold">120 Yên Lãng, Thịnh Quang, Đống Đa, Hà Nội</span>
                        </div>
                    </div>

                    <div class="mb-4 d-flex align-items-start">
                        <div class="mr-3" style="width: 42px; height: 42px; border-radius: 50%; background: rgba(196, 155, 99, 0.15); display: flex; align-items: center; justify-content: center; color: #c49b63; font-size: 18px; flex-shrink: 0;">
                            <span class="icon-phone"></span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Hotline tư vấn &amp; đặt hàng</span>
                            <a href="tel:0909090909" class="font-weight-bold" style="color: #c49b63; font-size: 16px;">0909 090 909</a>
                        </div>
                    </div>

                    <div class="mb-4 d-flex align-items-start">
                        <div class="mr-3" style="width: 42px; height: 42px; border-radius: 50%; background: rgba(196, 155, 99, 0.15); display: flex; align-items: center; justify-content: center; color: #c49b63; font-size: 18px; flex-shrink: 0;">
                            <span class="icon-envelope"></span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Email hỗ trợ khách hàng</span>
                            <a href="mailto:contact@coffeeblend.com" class="text-white">contact@coffeeblend.com</a>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="mr-3" style="width: 42px; height: 42px; border-radius: 50%; background: rgba(196, 155, 99, 0.15); display: flex; align-items: center; justify-content: center; color: #c49b63; font-size: 18px; flex-shrink: 0;">
                            <span class="icon-clock-o"></span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Khung giờ mở cửa</span>
                            <span class="text-white font-weight-bold">07:00 - 22:30</span>
                            <span class="text-muted small d-block">(Tất cả các ngày trong tuần)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-7 ftco-animate mb-4">
                <div class="p-4 p-md-5 rounded h-100" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.35); box-shadow: 0 4px 20px rgba(0,0,0,0.4);">
                    <div class="mb-4">
                        <span class="subheading" style="color: #c49b63; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700;">Hộp Thư Góp Ý</span>
                        <h3 class="text-white mt-1 mb-2" style="font-family: 'Josefin Sans', sans-serif;">Gửi Lời Nhắn Đến Ban Quản Lý</h3>
                        <p class="text-muted small mb-0">Lời nhắn của bạn sẽ được gửi về ban Chăm sóc khách hàng của Coffee Blend để hồi đáp chu đáo.</p>
                    </div>

                    <form asp-controller="Home" asp-action="Contact" method="post" class="contact-form">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="text-white small font-weight-bold mb-1">Họ và tên của bạn *</label>
                                    <input type="text" name="name" class="form-control" placeholder="Nguyễn Văn A..." required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="text-white small font-weight-bold mb-1">Email nhận phản hồi *</label>
                                    <input type="email" name="email" class="form-control" placeholder="email@example.com..." required />
                                </div>
                            </div>
                        </div>
                        <div class="form-group mb-3">
                            <label class="text-white small font-weight-bold mb-1">Chủ đề lời nhắn</label>
                            <input type="text" name="subject" class="form-control" placeholder="VD: Góp ý dịch vụ bàn, phản hồi về món uống mới..." />
                        </div>
                        <div class="form-group mb-4">
                            <label class="text-white small font-weight-bold mb-1">Nội dung chi tiết *</label>
                            <textarea name="message" cols="30" rows="5" class="form-control" placeholder="Hãy cho chúng tôi biết trải nghiệm hoặc đề xuất của bạn..." required></textarea>
                        </div>
                        <div class="form-group mb-0">
                            <button type="submit" class="btn btn-primary py-3 px-5 font-weight-bold" style="border-radius: 6px;">
                                <i class="icon-paper-plane mr-2"></i> Gửi Tin Nhắn Ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
