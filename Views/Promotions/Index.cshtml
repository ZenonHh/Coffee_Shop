@model CoffeeShop.Models.ViewModels.PromotionsPageViewModel
@{
    ViewData["Title"] = "Chương Trình Ưu Đãi & Điểm Thưởng - Katinat Coffee";
}

<!-- BANNER ĐẦU TRANG -->
<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); height: 670px; min-height: 670px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 670px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Chương Trình Ưu Đãi</h1>
                    <p class="breadcrumbs mb-0">
                        <span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> 
                        <span>Ưu đãi &amp; Điểm thưởng</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section pt-5 pb-5">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #a3e9b7;">
                <i class="icon-check_circle mr-2"></i> @TempData["Success"]
                <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="background: rgba(220, 53, 69, 0.2); border: 1px solid #dc3545; color: #f8b4b9;">
                <i class="icon-exclamation-triangle mr-2"></i> @TempData["Error"]
                <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- THẺ THÔNG TIN THÀNH VIÊN VÀ ĐIỂM TÍCH LŨY HIỆN CÓ -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="p-4 rounded d-flex flex-wrap align-items-center justify-content-between" style="background: linear-gradient(135deg, #1f1b16 0%, #15120f 100%); border: 1.5px solid rgba(196, 155, 99, 0.4); box-shadow: 0 4px 20px rgba(0,0,0,0.4);">
                    @if (Model.CurrentCustomer != null)
                    {
                        <div class="d-flex align-items-center mb-3 mb-md-0">
                            <div class="avatar mr-3" style="width: 55px; height: 55px; border-radius: 50%; background: rgba(196, 155, 99, 0.2); border: 2px solid #c49b63; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #c49b63;">
                                ☕
                            </div>
                            <div>
                                <span class="text-muted small d-block">Xin chào quý khách,</span>
                                <h4 class="text-white mb-0 font-weight-bold">@Model.CurrentCustomer.HoTen</h4>
                                <div class="mt-1">
                                    <span class="badge badge-gold-outline mr-2">Hạng: @Model.CurrentCustomer.HangTV</span>
                                    <span class="text-white small">Điểm tích lũy: <strong style="color: #ffc107; font-size: 15px;">@Model.CurrentCustomer.DiemTichLuy</strong> điểm</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap" style="gap: 10px;">
                            <a href="#redeem" class="btn btn-primary py-2 px-3 font-weight-bold" style="border-radius: 6px; font-size: 13px;">
                                🎁 Đổi Điểm Lấy Ưu Đãi
                            </a>
                            <a asp-controller="Survey" asp-action="Index" class="btn btn-outline-primary py-2 px-3 font-weight-bold" style="border-radius: 6px; font-size: 13px;">
                                📋 Làm Khảo Sát Nhận +50 Điểm
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-3 mb-md-0">
                            <div class="avatar mr-3" style="width: 55px; height: 55px; border-radius: 50%; background: rgba(196, 155, 99, 0.15); display: flex; align-items: center; justify-content: center; font-size: 24px; color: #c49b63;">
                                👑
                            </div>
                            <div>
                                <h4 class="text-white mb-1 font-weight-bold">Tham Gia Thành Viên Katinat Coffee</h4>
                                <p class="text-muted small mb-0">Tích điểm mỗi hóa đơn, thăng hạng nhận chiết khấu đến 15% và nhận ngay 50 điểm thưởng khi làm khảo sát.</p>
                            </div>
                        </div>
                        <div>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Promotions" class="btn btn-primary py-2 px-4 font-weight-bold" style="border-radius: 6px;">
                                Đăng Nhập / Đăng Ký
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- PHẦN 1: CÁC MÃ ƯU ĐÃI ĐÃ CÓ & SẮP CÓ (VOUCHERS) -->
        <div class="row justify-content-center mb-4">
            <div class="col-md-8 text-center ftco-animate">
                <span class="d-inline-block text-warning font-weight-bold text-uppercase mb-2" style="letter-spacing: 2.5px; font-size: 13px;">Kho Ưu Đãi</span>
                <h2 class="mb-3 text-white font-weight-bold" style="letter-spacing: 1px; font-size: 32px;">Mã Khuyến Mãi Đã Có &amp; Sắp Mở</h2>
                <p class="text-muted small">Sao chép mã voucher và nhập tại bước thanh toán để được giảm giá trực tiếp.</p>
            </div>
        </div>

        <!-- MÃ ĐANG DIỄN RA -->
        <div class="row mb-5">
            <div class="col-12 mb-3">
                <h4 class="text-white border-left pl-3" style="border-color: #c49b63 !important; font-size: 18px;">
                    🔥 Đang Diễn Ra (@Model.ActiveVouchers.Count mã sẵn sàng)
                </h4>
            </div>

            @if (Model.ActiveVouchers.Any())
            {
                foreach (var v in Model.ActiveVouchers)
                {
                    var isPercent = v.PhanLoaiGiam.Equals("PERCENT", StringComparison.OrdinalIgnoreCase);
                    var discountText = isPercent ? $"-{v.GiaTriGiam:0}%" : $"-{v.GiaTriGiam:N0}đ";

                    <div class="col-md-4 mb-4 ftco-animate">
                        <div class="p-4 rounded h-100 d-flex flex-column justify-content-between" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.35); box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge badge-warning font-weight-bold" style="font-size: 14px; padding: 5px 10px;">@discountText</span>
                                    <span class="badge badge-gold-outline">Đang áp dụng</span>
                                </div>
                                <h5 class="text-white font-weight-bold mb-2">@(string.IsNullOrWhiteSpace(v.TenChuongTrinh) ? "Mã giảm giá đơn hàng" : v.TenChuongTrinh)</h5>
                                <p class="text-muted small mb-2">• Đơn tối thiểu: <strong>@v.DonToiThieu.ToString("N0") đ</strong></p>
                                @if (isPercent && v.GiamToiDa.HasValue)
                                {
                                    <p class="text-muted small mb-2">• Giảm tối đa: <strong>@v.GiamToiDa.Value.ToString("N0") đ</strong></p>
                                }
                                <p class="text-muted small mb-3">• Hạn dùng: @(v.NgayKetThuc.HasValue ? v.NgayKetThuc.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")</p>
                            </div>

                            <div class="pt-3 border-top d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.08) !important;">
                                <div>
                                    <span class="text-muted small d-block">Mã giảm giá:</span>
                                    <code class="font-weight-bold" style="color: #c49b63; font-size: 14px; background: rgba(196, 155, 99, 0.1); padding: 2px 6px; border-radius: 4px;">@v.MaCode</code>
                                </div>
                                <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-primary font-weight-bold" style="border-radius: 4px;">
                                    Đặt món ngay
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">Hiện tại chưa có mã voucher công khai. Hãy tham gia khảo sát để nhận voucher riêng!</p>
                </div>
            }
        </div>

        <!-- MÃ SẮP RA MẮT -->
        @if (Model.UpcomingVouchers.Any())
        {
            <div class="row mb-5">
                <div class="col-12 mb-3">
                    <h4 class="text-white border-left pl-3" style="border-color: #17a2b8 !important; font-size: 18px;">
                        ⏳ Sắp Ra Mắt (@Model.UpcomingVouchers.Count mã)
                    </h4>
                </div>
                @foreach (var v in Model.UpcomingVouchers)
                {
                    var isPercent = v.PhanLoaiGiam.Equals("PERCENT", StringComparison.OrdinalIgnoreCase);
                    var discountText = isPercent ? $"-{v.GiaTriGiam:0}%" : $"-{v.GiaTriGiam:N0}đ";

                    <div class="col-md-4 mb-4 ftco-animate">
                        <div class="p-4 rounded h-100 d-flex flex-column justify-content-between" style="background: rgba(23, 20, 18, 0.7); border: 1px dashed rgba(255, 255, 255, 0.2);">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge badge-secondary" style="font-size: 13px;">@discountText</span>
                                    <span class="badge badge-info">Sắp diễn ra</span>
                                </div>
                                <h5 class="text-white font-weight-bold mb-2">@(string.IsNullOrWhiteSpace(v.TenChuongTrinh) ? "Khuyến mãi tuần lễ mới" : v.TenChuongTrinh)</h5>
                                <p class="text-muted small mb-2">• Đơn tối thiểu: <strong>@v.DonToiThieu.ToString("N0") đ</strong></p>
                                <p class="text-muted small mb-3">• Mở từ ngày: <strong class="text-white">@v.NgayBatDau?.ToString("dd/MM/yyyy HH:mm")</strong></p>
                            </div>
                            <div class="pt-3 border-top text-muted small" style="border-color: rgba(255,255,255,0.08) !important;">
                                Mã sẽ tự động kích hoạt khi đến thời gian chương trình.
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- PHẦN 2: MUA ĐƠN HÀNG BAO NHIÊU PHẦN TRĂM SẼ ĐƯỢC KHUYẾN MÃI (TỰ ĐỘNG THEO ĐƠN) -->
        <div class="row justify-content-center mb-4 mt-5">
            <div class="col-md-8 text-center ftco-animate">
                <span class="d-inline-block text-warning font-weight-bold text-uppercase mb-2" style="letter-spacing: 2.5px; font-size: 13px;">Ưu Đãi Tự Động</span>
                <h2 class="mb-3 text-white font-weight-bold" style="letter-spacing: 1px; font-size: 32px;">Giảm Giá Theo Giá Trị Đơn Hàng</h2>
                <p class="text-muted small">Mua càng nhiều - Giảm càng sâu! Hệ thống tự động trừ tiền ngay tại giỏ hàng mà không cần nhập mã.</p>
            </div>
        </div>

        <div class="row mb-5">
            @foreach (var rule in Model.OrderDiscountRules)
            {
                <div class="col-md-3 col-sm-6 mb-4 ftco-animate">
                    <div class="p-4 rounded text-center h-100" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.35); box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
                        <div class="mb-3" style="font-size: 36px;">@rule.Icon</div>
                        <span class="badge badge-warning mb-2 font-weight-bold" style="font-size: 12px; padding: 4px 10px;">@rule.BadgeText</span>
                        <h5 class="text-white font-weight-bold mb-2">@rule.Title</h5>
                        <p class="text-muted small mb-3" style="line-height: 1.5;">@rule.Description</p>
                        <div class="pt-2 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                            <span class="text-warning small font-weight-bold">Tự động áp dụng tại giỏ hàng</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PHẦN 3: ĐẶC QUYỀN HẠNG THÀNH VIÊN -->
        <div class="row justify-content-center mb-4 mt-5">
            <div class="col-md-8 text-center ftco-animate">
                <span class="d-inline-block text-warning font-weight-bold text-uppercase mb-2" style="letter-spacing: 2.5px; font-size: 13px;">Hạng Thành Viên</span>
                <h2 class="mb-3 text-white font-weight-bold" style="letter-spacing: 1px; font-size: 32px;">Đặc Quyền Dành Cho Từng Hạng Thẻ</h2>
                <p class="text-muted small">Tích lũy điểm khi mua sắm hoặc hoàn thành khảo sát để nâng tầm trải nghiệm với ưu đãi riêng biệt.</p>
            </div>
        </div>

        <div class="row mb-5">
            @foreach (var tier in Model.MemberTiers)
            {
                <div class="col-lg-3 col-md-6 mb-4 ftco-animate">
                    <div class="p-4 rounded h-100 d-flex flex-column justify-content-between" 
                         style="background: #171412; border: @(tier.IsCurrent ? "2px solid #ffc107" : "1px solid rgba(196, 155, 99, 0.35)"); box-shadow: @(tier.IsCurrent ? "0 0 20px rgba(255, 193, 7, 0.25)" : "none");">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span style="font-size: 32px;">@tier.Icon</span>
                                @if (tier.IsCurrent)
                                {
                                    <span class="badge badge-warning font-weight-bold" style="font-size: 11px;">Hạng của bạn</span>
                                }
                            </div>
                            <h5 class="font-weight-bold text-white mb-1">@tier.TierName</h5>
                            <span class="text-muted small d-block mb-3">Mức điểm: <strong style="color: @tier.BadgeColor;">@tier.RequiredPoints</strong></span>
                            
                            <div class="p-2 rounded mb-3" style="background: rgba(196, 155, 99, 0.1); border: 1px dashed rgba(196, 155, 99, 0.3);">
                                <span class="text-white small font-weight-bold">Quyền lợi chính:</span>
                                <div class="font-weight-bold" style="color: #c49b63; font-size: 14px;">@tier.DiscountRate</div>
                            </div>

                            <ul class="list-unstyled small text-muted mb-4 pl-0">
                                @foreach (var perk in tier.Perks)
                                {
                                    <li class="mb-2 d-flex align-items-start">
                                        <span class="mr-2" style="color: #28a745;">✓</span>
                                        <span>@perk</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PHẦN 4: ĐỔI ĐIỂM LẤY ƯU ĐÃI (POINT REDEEM) -->
        <div id="redeem" class="row justify-content-center mb-4 mt-5">
            <div class="col-md-8 text-center ftco-animate">
                <span class="d-inline-block text-warning font-weight-bold text-uppercase mb-2" style="letter-spacing: 2.5px; font-size: 13px;">Đổi Quà Tích Lũy</span>
                <h2 class="mb-3 text-white font-weight-bold" style="letter-spacing: 1px; font-size: 32px;">Đổi Điểm Lấy Voucher Ưu Đãi</h2>
                <p class="text-muted small">Sử dụng điểm tích lũy của bạn để đổi lấy các mã giảm giá hấp dẫn hoặc ly nước miễn phí ngay lập tức.</p>
            </div>
        </div>

        <div class="row mb-5">
            @foreach (var reward in Model.RedeemRewards)
            {
                var canRedeem = Model.CurrentCustomer != null && Model.CurrentCustomer.DiemTichLuy >= reward.PointsRequired;

                <div class="col-md-3 col-sm-6 mb-4 ftco-animate">
                    <div class="p-4 rounded text-center h-100 d-flex flex-column justify-content-between" style="background: #171412; border: 1px solid rgba(196, 155, 99, 0.35); box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
                        <div>
                            <div class="mb-2" style="font-size: 34px;">@reward.Icon</div>
                            <span class="badge badge-warning font-weight-bold mb-2" style="font-size: 13px; padding: 5px 12px;">
                                @reward.PointsRequired Điểm
                            </span>
                            <h5 class="text-white font-weight-bold mt-2 mb-2">@reward.Title</h5>
                            <p class="text-muted small mb-3">@reward.Description</p>
                        </div>

                        <div class="pt-3 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                            @if (Model.CurrentCustomer == null)
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Promotions#redeem" class="btn btn-outline-primary btn-block btn-sm py-2">
                                    Đăng nhập để đổi
                                </a>
                            }
                            else if (canRedeem)
                            {
                                <form asp-action="RedeemPoints" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn dùng @reward.PointsRequired điểm để đổi @reward.Title?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="pointsRequired" value="@reward.PointsRequired" />
                                    <input type="hidden" name="discountAmount" value="@reward.DiscountAmount" />
                                    <input type="hidden" name="minOrder" value="@reward.MinOrder" />
                                    <input type="hidden" name="rewardTitle" value="@reward.Title" />
                                    <button type="submit" class="btn btn-primary btn-block btn-sm py-2 font-weight-bold">
                                        Đổi Ngay
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-block btn-sm py-2" disabled style="opacity: 0.6; cursor: not-allowed;">
                                    Cần thêm @(reward.PointsRequired - Model.CurrentCustomer.DiemTichLuy) điểm
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PHẦN 5: BANNER KHẢO SÁT TÍCH ĐIỂM THƯỞNG -->
        <div class="row mb-4 mt-4">
            <div class="col-12 ftco-animate">
                <div class="p-4 p-md-5 rounded" style="background: radial-gradient(circle at top left, #292017 0%, #171412 100%); border: 1.5px solid #c49b63; box-shadow: 0 6px 30px rgba(0,0,0,0.5);">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <span class="badge badge-warning font-weight-bold mb-2" style="font-size: 13px; padding: 6px 12px;">+50 ĐIỂM THƯỞNG NGAY</span>
                            <h3 class="text-white font-weight-bold mb-2" style="font-family: 'Josefin Sans', sans-serif;">
                                Làm Khảo Sát Trải Nghiệm - Tích Ngay 50 Điểm Thưởng
                            </h3>
                            <p class="text-muted mb-md-0" style="font-size: 14px; line-height: 1.6;">
                                Chúng tôi vô cùng trân quý những góp ý chân thành của bạn. Chỉ với 1 phút hoàn thành bài khảo sát trải nghiệm dịch vụ, hệ thống sẽ tự động cộng ngay <strong>50 điểm thưởng tích lũy</strong> vào tài khoản của bạn để đổi voucher giảm giá.
                            </p>
                        </div>
                        <div class="col-md-4 text-md-right mt-3 mt-md-0">
                            <a asp-controller="Survey" asp-action="Index" class="btn btn-primary py-3 px-4 font-weight-bold" style="border-radius: 6px; font-size: 14px; box-shadow: 0 4px 15px rgba(196, 155, 99, 0.4);">
                                Làm Khảo Sát Nhận Điểm Ngay &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
