@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var title = ViewData["Title"] ?? "Coffee Blend - Thưởng thức cà phê & trà";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <title>@title</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Josefin+Sans:400,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Great+Vibes" rel="stylesheet">

    <link rel="stylesheet" href="~/css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/css/magnific-popup.css">
    <link rel="stylesheet" href="~/css/aos.css">
    <link rel="stylesheet" href="~/css/ionicons.min.css">
    <link rel="stylesheet" href="~/css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="~/css/jquery.timepicker.css">
    <link rel="stylesheet" href="~/css/flaticon.css">
    <link rel="stylesheet" href="~/css/icomoon.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/product-reviews.css">
</head>
<body>
    <nav class="navbar navbar-expand-xl navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Coffee<small>Blend</small></a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="oi oi-menu"></span> Menu
            </button>
            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a></li>
                    <li class="nav-item"><a asp-controller="Shop" asp-action="Index" class="nav-link">Thực đơn</a></li>
                    <li class="nav-item"><a asp-controller="Home" asp-action="Blog" class="nav-link">Bài viết</a></li>
                    <li class="nav-item"><a asp-controller="Home" asp-action="Contact" class="nav-link">Liên hệ</a></li>
                    <li class="nav-item"><a asp-controller="Feedback" asp-action="Index" class="nav-link">Đánh giá</a></li>
                    
                    <li class="nav-item cart">
                        <a asp-controller="Cart" asp-action="Index" class="nav-link">
                            <span class="icon icon-shopping_cart"></span>
                            <span class="bag d-flex justify-content-center align-items-center">
                                <small id="cartBadgeCount">0</small>
                            </span>
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="dropdownUser" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="icon icon-person"></span> @User.Identity.Name
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownUser">
                                @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                {
                                    <a class="dropdown-item text-warning" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="icon-dashboard"></i> Trang Quản Trị
                                    </a>
                                    <div class="dropdown-divider"></div>
                                }
                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Thông tin cá nhân & Điểm</a>
                                <a class="dropdown-item" asp-controller="Survey" asp-action="Index">Khảo sát ý kiến</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a asp-controller="Account" asp-action="Login" class="nav-link">Đăng nhập</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <!-- END nav -->

    <main role="main">
        @RenderBody()
    </main>

    <footer class="ftco-footer ftco-section img">
        <div class="overlay"></div>
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-3 col-md-6 mb-5 mb-md-5">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Về chúng tôi</h2>
                        <p>Coffee Blend mang đến hương vị cà phê đích thực, trà tươi và các món bánh hảo hạng phục vụ bạn mỗi ngày.</p>
                        <a asp-controller="Shop" asp-action="Index" class="py-2 d-block text-primary">Khám phá thực đơn &rarr;</a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 mb-5 mb-md-5">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Mua sắm</h2>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Shop" asp-action="Index" class="py-2 d-block">Tất cả sản phẩm</a></li>
                            <li><a asp-controller="Cart" asp-action="Index" class="py-2 d-block">Giỏ hàng</a></li>
                            <li><a asp-controller="Account" asp-action="Profile" class="py-2 d-block">Tài khoản & Điểm tích lũy</a></li>
                            <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="py-2 d-block text-warning"><i class="icon-cog"></i> Cổng Quản Trị Viên (Admin)</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-5 mb-md-5">
                    <div class="ftco-footer-widget mb-4 ml-md-4">
                        <h2 class="ftco-heading-2">Khám phá</h2>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Home" asp-action="Blog" class="py-2 d-block">Khám phá món ngon</a></li>
                            <li><a asp-controller="Shop" asp-action="Index" class="py-2 d-block">Xem thực đơn</a></li>
                            <li><a asp-controller="Home" asp-action="Contact" class="py-2 d-block">Liên hệ cửa hàng</a></li>
                            <li><a asp-controller="Feedback" asp-action="Index" class="py-2 d-block">Đánh giá món</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-5 mb-md-5">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Liên hệ</h2>
                        <div class="block-23 mb-3">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Contact"><span class="icon icon-map-marker"></span><span class="text">120 Yên Lãng, Đống Đa, Hà Nội</span></a></li>
                                <li><a href="tel:0909090909"><span class="icon icon-phone"></span><span class="text">0909 090 909</span></a></li>
                                <li><a href="mailto:contact@coffeeblend.com"><span class="icon icon-envelope"></span><span class="text">contact@coffeeblend.com</span></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-center">
                    <p>Bản quyền &copy; @DateTime.Now.Year Coffee Blend - Nền tảng ASP.NET Core (.NET 8) & Microsoft SQL Server.</p>
                </div>
            </div>
        </div>
    </footer>

    <div id="ftco-loader" class="show fullscreen">
        <svg class="circular" width="48px" height="48px">
            <circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee"/>
            <circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00"/>
        </svg>
    </div>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.easing.1.3.js"></script>
    <script src="~/js/jquery.waypoints.min.js"></script>
    <script src="~/js/jquery.stellar.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/aos.js"></script>
    <script src="~/js/jquery.animateNumber.min.js"></script>
    <script src="~/js/bootstrap-datepicker.js"></script>
    <script src="~/js/jquery.timepicker.min.js"></script>
    <script src="~/js/scrollax.min.js"></script>
    <script src="~/js/main.js"></script>

    <script>
        function updateCartBadge() {
            $.get('@Url.Action("GetCartCount", "Cart")', function(res) {
                if (res && res.count !== undefined) {
                    $('#cartBadgeCount').text(res.count);
                }
            });
        }
        $(document).ready(function() {
            updateCartBadge();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
