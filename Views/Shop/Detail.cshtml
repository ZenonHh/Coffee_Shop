@model CoffeeShop.Models.ViewModels.ProductDetailViewModel
@{
    ViewData["Title"] = $"{Model.Product.TenSP} - Coffee Blend";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(/images/bg_3.jpg); height: 350px; min-height: 350px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 350px;">
                <div class="col-md-7 col-sm-12 text-center ftco-animate">
                    <h1 class="mb-3 mt-5 bread">Chi Tiết Món Uống</h1>
                    <p class="breadcrumbs"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span> <span class="mr-2"><a asp-controller="Shop" asp-action="Index">Thực đơn</a></span> <span>@Model.Product.TenSP</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-5 ftco-animate">
                <div class="border rounded p-3 text-center bg-dark">
                    <img src="~/picture/@Model.Product.HinhAnh" class="img-fluid" style="max-height: 450px;" alt="@Model.Product.TenSP">
                </div>
            </div>
            <div class="col-lg-6 product-details pl-md-5 ftco-animate">
                <h2 class="text-white">@Model.Product.TenSP</h2>
                <div class="rating d-flex mb-3">
                    <p class="text-left mr-4">
                        <a href="#reviews" class="mr-2 text-warning font-weight-bold">@Model.AverageRating.ToString("0.0") <i class="icon-star"></i></a>
                        <span class="text-muted">(@Model.TotalReviews đánh giá)</span>
                    </p>
                    <p class="text-left"><span class="badge badge-primary">@Model.Product.Category?.TenLoaiSP</span></p>
                </div>

                <p class="price"><span id="displayPrice" class="h3 text-primary">0 đ</span></p>

                <!-- Form tùy chọn đặt món -->
                <form id="addToCartForm" class="mt-4">
                    <input type="hidden" name="productId" value="@Model.Product.MaSP" />

                    <!-- Chọn Kích cỡ (Size) -->
                    <div class="form-group mb-4">
                        <label class="text-white font-weight-bold">1. Chọn Kích Cỡ (Size):</label>
                        <div class="d-flex flex-wrap gap-3">
                            @for (int i = 0; i < Model.Variants.Count; i++)
                            {
                                var variant = Model.Variants[i];
                                <div class="custom-control custom-radio mr-4">
                                    <input type="radio" id="variant_@variant.MaBienThe" name="variantId" value="@variant.MaBienThe" 
                                           data-price="@variant.GiaBan" class="custom-control-input variant-radio" @(i == 0 ? "checked" : "")>
                                    <label class="custom-control-label text-white" for="variant_@variant.MaBienThe">
                                        Size @variant.KichCo (@variant.GiaBan.ToString("N0") đ)
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Chọn Topping -->
                    @if (Model.AvailableToppings.Any())
                    {
                        <div class="form-group mb-4">
                            <label class="text-white font-weight-bold">2. Thêm Topping Yêu Thích:</label>
                            <div class="row">
                                @foreach (var top in Model.AvailableToppings)
                                {
                                    var topPrice = top.Variants.FirstOrDefault()?.GiaBan ?? 10000;
                                    <div class="col-md-6 mb-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" id="top_@top.MaSP" name="toppingIds" value="@top.MaSP" 
                                                   data-price="@topPrice" class="custom-control-input topping-check">
                                            <label class="custom-control-label text-white" for="top_@top.MaSP">
                                                @top.TenSP (+@topPrice.ToString("N0") đ)
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Số lượng -->
                    <div class="form-group mb-4 row align-items-center">
                        <label class="col-md-3 text-white font-weight-bold">3. Số lượng:</label>
                        <div class="col-md-4">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <button class="btn btn-outline-secondary text-white btn-qty-minus" type="button">-</button>
                                </div>
                                <input type="number" id="productQuantity" name="quantity" class="form-control text-center" value="1" min="1" max="50">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary text-white btn-qty-plus" type="button">+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <p>
                        <button type="submit" id="btnAddToCart" class="btn btn-primary py-3 px-5">
                            <i class="icon-shopping_cart mr-2"></i> Thêm vào giỏ hàng
                        </button>
                    </p>
                    <div id="addToCartAlert" class="alert alert-success d-none mt-3"></div>
                </form>
            </div>
        </div>

        <!-- Đánh giá món uống -->
        <div id="reviews" class="row mt-5 pt-4 border-top">
            <div class="col-md-12">
                <h3 class="text-white mb-4">Đánh giá từ khách hàng (@Model.TotalReviews)</h3>
                @if (Model.Reviews.Any())
                {
                    <div class="row">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="p-3 bg-dark rounded border border-secondary">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="text-white mb-0">@(review.Customer?.HoTen ?? "Khách hàng")</h5>
                                        <span class="text-warning">
                                            @for (int s = 1; s <= (review.DanhGia ?? 5); s++) { <i class="icon-star"></i> }
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-2">@review.NgayGui.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p class="text-light mb-0">@review.NoiDung</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">Chưa có đánh giá nào cho món này. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!</p>
                }
            </div>
        </div>
    </div>
        <div class="row mt-4 pt-4 border-top">
            <div class="col-md-8 mx-auto"><div class="p-4 bg-dark rounded border border-secondary">
                <h4 class="text-white mb-3">Đánh giá món này</h4>
                <form asp-controller="Feedback" asp-action="SubmitFeedback" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Product.MaSP" />
                    <div class="form-group"><label class="text-white">Mức độ hài lòng</label><select name="rating" class="form-control"><option value="5">★★★★★ - Rất hài lòng</option><option value="4">★★★★ - Hài lòng</option><option value="3">★★★ - Bình thường</option><option value="2">★★ - Chưa hài lòng</option><option value="1">★ - Không hài lòng</option></select></div>
                    <div class="form-group"><label class="text-white">Nhận xét của bạn</label><textarea name="content" class="form-control" rows="4" required placeholder="Chia sẻ cảm nhận về món này..."></textarea></div>
                    <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                </form>
            </div></div>
        </div></section>

@section Scripts {
<script>
    function calculateTotalPrice() {
        var basePrice = parseFloat($('input[name="variantId"]:checked').data('price')) || 0;
        var toppingTotal = 0;
        $('.topping-check:checked').each(function() {
            toppingTotal += parseFloat($(this).data('price')) || 0;
        });
        var qty = parseInt($('#productQuantity').val()) || 1;
        var unitPrice = basePrice + toppingTotal;
        var total = unitPrice * qty;

        $('#displayPrice').text(unitPrice.toLocaleString('vi-VN') + ' đ');
    }

    $(document).ready(function() {
        calculateTotalPrice();

        $('input[name="variantId"], .topping-check').on('change', function() {
            calculateTotalPrice();
        });

        $('.btn-qty-plus').click(function() {
            var val = parseInt($('#productQuantity').val()) || 1;
            $('#productQuantity').val(val + 1);
            calculateTotalPrice();
        });

        $('.btn-qty-minus').click(function() {
            var val = parseInt($('#productQuantity').val()) || 1;
            if (val > 1) {
                $('#productQuantity').val(val - 1);
                calculateTotalPrice();
            }
        });

        $('#addToCartForm').submit(function(e) {
            e.preventDefault();
            var formData = $(this).serialize();
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: formData,
                success: function(res) {
                    if (res.success) {
                        $('#addToCartAlert').removeClass('d-none alert-danger').addClass('alert-success').text(res.message);
                        updateCartBadge();
                    } else {
                        $('#addToCartAlert').removeClass('d-none alert-success').addClass('alert-danger').text(res.message);
                    }
                },
                error: function() {
                    $('#addToCartAlert').removeClass('d-none alert-success').addClass('alert-danger').text('Lỗi kết nối khi thêm giỏ hàng.');
                }
            });
        });
    });
</script>
}
