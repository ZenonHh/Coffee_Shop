@model CoffeeShop.Models.ViewModels.ShopViewModel
@{
    ViewData["Title"] = "Thực đơn - Katinat Coffee";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url('/images/bg_3.jpg'); height: 450px; min-height: 450px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 450px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Thực Đơn Cửa Hàng</h1>
                    <p class="breadcrumbs mb-0"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span><span>Thực đơn</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-7 col-md-9">
                <form asp-action="Index" method="get" class="search-form shop-search-form">
                    @if (Model.SelectedCategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId.Value" />
                    }
                    <div class="shop-search-control">
                        <span class="icon-search shop-search-icon" aria-hidden="true"></span>
                        <input type="search" name="keyword" value="@Model.Keyword" class="form-control shop-search-input" placeholder="Tìm món uống yêu thích..." aria-label="Tìm kiếm món uống" />
                        <button type="submit" class="btn btn-primary shop-search-submit">
                            <span class="d-none d-sm-inline">Tìm kiếm</span>
                            <span class="icon-search d-inline d-sm-none" aria-hidden="true"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-12 text-center">
                <p class="mb-2">
                    <a asp-action="Index" asp-route-keyword="@Model.Keyword" class="btn btn-sm @(Model.SelectedCategoryId == null ? "btn-primary" : "btn-outline-primary") m-1">Tất cả</a>
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@category.MaLoaiSP" asp-route-keyword="@Model.Keyword" class="btn btn-sm @(Model.SelectedCategoryId == category.MaLoaiSP ? "btn-primary" : "btn-outline-primary") m-1">@category.TenLoaiSP</a>
                    }
                </p>
            </div>
        </div>

        <div class="row">
            @if (Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    var isOutOfStock = product.SoLuongTon <= 0;
                    var imageUrl = Url.Content("~/picture/" + (product.HinhAnh ?? string.Empty));
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex">
                        <div class="menu-entry w-100 d-flex flex-column">
                            <div class="position-relative">
                                <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP"
                                   class="block-20 d-block"
                                   style="height:auto; aspect-ratio:1/1; background-image:url('@imageUrl'); background-size:contain; background-repeat:no-repeat; background-position:center; background-color:#171717; @(isOutOfStock ? "filter:opacity(.55);" : "")"
                                   aria-label="@product.TenSP"></a>
                                @if (isOutOfStock)
                                {
                                    <span class="badge badge-danger position-absolute" style="top:12px; right:12px;">HẾT HÀNG</span>
                                }
                            </div>
                            <div class="text text-center pt-3 d-flex flex-column flex-grow-1">
                                <h3 class="mb-1"><a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP">@product.TenSP</a></h3>
                                <p class="text-muted small mb-2">@product.TenLoaiSP</p>
                                <p class="price mt-auto mb-3"><span>@(product.GiaBan?.ToString("N0") ?? "Liên hệ") đ</span></p>
                                @if (isOutOfStock)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm disabled-stock-btn" data-name="@product.TenSP" aria-disabled="true">Hết hàng</button>
                                }
                                else
                                {
                                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP" class="btn btn-primary btn-outline-primary btn-sm">Chọn mua</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <h4>Không tìm thấy món uống phù hợp.</h4>
                    <a asp-action="Index" class="btn btn-primary mt-3">Xem toàn bộ thực đơn</a>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.disabled-stock-btn').forEach(function (button) {
            button.addEventListener('click', function () {
                alert('Món ' + this.dataset.name + ' hiện đã hết hàng. Vui lòng chọn món khác.');
            });
        });
    </script>
}
