@model CoffeeShop.Models.ViewModels.ShopViewModel
@{
    ViewData["Title"] = "Thực đơn - Katinat Coffee";
}

<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url('/images/bg_3.jpg'); height: 670px; min-height: 670px;">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center" style="height: 670px; padding-top: 90px;">
                <div class="col-md-8 col-sm-12 text-center ftco-animate">
                    <span class="subheading" style="font-family: 'Great Vibes', cursive; font-size: 40px; color: #c49b63; display: block; margin-bottom: 5px;">Hương vị tuyệt hảo</span>
                    <h1 class="mb-3 bread" style="font-size: 38px; letter-spacing: 2px; font-weight: 700; text-transform: uppercase;">Thực Đơn Cửa Hàng</h1>
                    <p class="breadcrumbs mb-0"><span class="mr-2"><a asp-controller="Home" asp-action="Index">Trang chủ</a></span><span>Thực đơn</span></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-7 col-md-9">
                <form asp-action="Index" method="get" class="search-form shop-search-form">
                    <input type="hidden" id="shopSelectedCategoryId" name="categoryId" value="@Model.SelectedCategoryId" />
                    <div class="shop-search-control">
                        <span class="icon-search shop-search-icon" aria-hidden="true"></span>
                        <input type="search" name="keyword" value="@Model.Keyword" class="form-control shop-search-input" placeholder="Tìm món uống yêu thích..." aria-label="Tìm kiếm món uống" />
                        <button type="submit" class="btn btn-primary shop-search-submit">
                            <span class="d-none d-sm-inline">Tìm kiếm</span>
                            <span class="icon-search d-inline d-sm-none" aria-hidden="true"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-12 text-center">
                <p class="mb-2">
                 <!--   <a asp-action="Index" asp-route-keyword="@Model.Keyword" class="btn btn-sm @(Model.SelectedCategoryId == null ? "btn-primary" : "btn-outline-primary") m-1">Tất cả</a> -->
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@category.MaLoaiSP" asp-route-keyword="@Model.Keyword" class="btn btn-sm shop-category-link @(Model.SelectedCategoryId == category.MaLoaiSP ? "btn-primary" : "btn-outline-primary") m-1" aria-current="@(Model.SelectedCategoryId == category.MaLoaiSP ? "true" : null)">@category.TenLoaiSP</a>
                    }
                </p>
            </div>
        </div>

        <div id="shopFilterError" class="alert alert-danger d-none" role="alert">
            Không thể tải danh sách món. Vui lòng thử lại.
        </div>
        <div id="shopProductGrid" aria-live="polite" aria-busy="false">
            @await Html.PartialAsync("_ProductGrid", Model)
        </div>
    </div>
</section>

<style>
    .shop-product-card .menu-entry {
        transition: transform 250ms ease, box-shadow 250ms ease;
    }

    .shop-product-card .menu-entry:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
    }

    #shopProductGrid {
        transition: opacity 180ms ease;
    }

    #shopProductGrid.is-loading {
        opacity: 0.55;
        pointer-events: none;
    }

    .shop-product-grid.is-entering .shop-product-card {
        opacity: 0;
        transform: translateY(18px);
        animation: shop-product-enter 420ms ease forwards;
        animation-delay: var(--shop-card-delay, 0ms);
    }

    .shop-product-grid.is-entering .shop-product-card:nth-child(4n + 2) {
        --shop-card-delay: 60ms;
    }

    .shop-product-grid.is-entering .shop-product-card:nth-child(4n + 3) {
        --shop-card-delay: 120ms;
    }

    .shop-product-grid.is-entering .shop-product-card:nth-child(4n + 4) {
        --shop-card-delay: 180ms;
    }

    @@keyframes shop-product-enter {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .shop-product-card .menu-entry,
        #shopProductGrid,
        .shop-product-grid.is-entering .shop-product-card {
            transition: none;
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>

@section Scripts {
    <script>
        (function() {
            var grid = document.getElementById('shopProductGrid');
            var categoryLinks = document.querySelectorAll('.shop-category-link');
            var categoryInput = document.getElementById('shopSelectedCategoryId');
            var filterError = document.getElementById('shopFilterError');
            var activeRequest = null;

            function setActiveCategory(selectedLink) {
                categoryLinks.forEach(function(link) {
                    var isActive = link === selectedLink;
                    link.classList.toggle('btn-primary', isActive);
                    link.classList.toggle('btn-outline-primary', !isActive);
                    if (isActive) {
                        link.setAttribute('aria-current', 'true');
                    } else {
                        link.removeAttribute('aria-current');
                    }
                });
                if (categoryInput) {
                    var selectedUrl = selectedLink ? new URL(selectedLink.href) : null;
                    categoryInput.value = selectedUrl ? selectedUrl.searchParams.get('categoryId') || '' : '';
                }
            }

            async function loadProducts(url, selectedLink, updateHistory) {
                if (activeRequest) activeRequest.abort();
                var request = new AbortController();
                activeRequest = request;
                grid.classList.add('is-loading');
                grid.setAttribute('aria-busy', 'true');
                filterError.classList.add('d-none');

                try {
                    var response = await fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        signal: request.signal
                    });
                    if (!response.ok) throw new Error('Không tải được danh sách sản phẩm.');

                    var html = await response.text();
                    if (request.signal.aborted) return;

                    grid.innerHTML = html;
                    grid.querySelectorAll('.ftco-animate').forEach(function(element) {
                        element.classList.add('ftco-animated');
                    });
                    var productGrid = grid.querySelector('.shop-product-grid');
                    if (productGrid) productGrid.classList.add('is-entering');
                    setActiveCategory(selectedLink);
                    if (updateHistory) window.history.pushState({ shop: true }, '', url);
                } catch (error) {
                    if (error.name !== 'AbortError') {
                        console.error(error);
                        filterError.classList.remove('d-none');
                    }
                } finally {
                    if (activeRequest === request) {
                        activeRequest = null;
                        grid.classList.remove('is-loading');
                        grid.setAttribute('aria-busy', 'false');
                    }
                }
            }

            categoryLinks.forEach(function(link) {
                link.addEventListener('click', function(event) {
                    if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                    event.preventDefault();
                    loadProducts(link.href, link, true);
                });
            });

            document.addEventListener('click', function(event) {
                var button = event.target.closest('.disabled-stock-btn');
                if (button) {
                    alert('Món ' + button.dataset.name + ' hiện đã hết hàng. Vui lòng chọn món khác.');
                }
            });

            window.addEventListener('popstate', function() {
                var currentUrl = new URL(window.location.href);
                var categoryId = currentUrl.searchParams.get('categoryId');
                var selectedLink = Array.prototype.find.call(categoryLinks, function(link) {
                    var linkUrl = new URL(link.href);
                    return linkUrl.searchParams.get('categoryId') === categoryId;
                });
                if (!categoryId) {
                    selectedLink = Array.prototype.find.call(categoryLinks, function(link) {
                        return link.textContent.trim().toLowerCase().includes('espresso');
                    });
                }
                loadProducts(window.location.href, selectedLink, false);
            });
        })();
    </script>
}
