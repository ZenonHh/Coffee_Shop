@model CoffeeShop.Models.ViewModels.ShopViewModel
@if (!string.IsNullOrWhiteSpace(Model.SearchError))
{
    <div class="alert alert-warning" role="alert">@Model.SearchError</div>
}
<div class="row shop-product-grid">
    @if (Model.Products.Any())
    {
        foreach (var product in Model.Products)
        {
            var isOutOfStock = product.SoLuongTon <= 0;
            var selectedVariant = product.Variants.FirstOrDefault(variant => variant.MaBienThe == product.SelectedVariantId)
                ?? product.Variants.FirstOrDefault();
            var imageUrl = Url.Content("~/picture/" + (product.HinhAnh ?? string.Empty));
            var isBanhNgot = string.Equals(product.TenLoaiSP, "Bánh Ngọt", StringComparison.OrdinalIgnoreCase)
                || product.TenLoaiSP.Contains("Bánh", StringComparison.OrdinalIgnoreCase);
            var hasOnlyDefaultVariant = product.Variants.All(v => string.Equals(v.KichCo, "Mặc định", StringComparison.OrdinalIgnoreCase));
            var showSizeOptions = product.Variants.Any() && !isBanhNgot && !hasOnlyDefaultVariant;
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex shop-product-card ftco-animate">
                <div class="menu-entry w-100 d-flex flex-column">
                    <div class="shop-product-image-frame position-relative">
                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP"
                           class="shop-product-image-link d-block"
                           aria-label="@product.TenSP">
                            <img src="@imageUrl" class="shop-product-image" alt="@product.TenSP"
                                 loading="lazy" style="@(isOutOfStock ? "filter:opacity(.55);" : "")" />
                        </a>
                        @if (isOutOfStock)
                        {
                            <span class="badge badge-danger position-absolute" style="top:12px; right:12px;">HẾT HÀNG</span>
                        }
                    </div>
                    <div class="text text-center pt-3 d-flex flex-column flex-grow-1">
                        <h3 class="shop-product-name mb-1"><a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.MaSP">@product.TenSP</a></h3>
                        <p class="text-muted small mb-2">@product.TenLoaiSP</p>
                        <form class="shop-card-cart-form mt-auto" asp-controller="Cart" asp-action="AddToCart" method="post" asp-antiforgery="false">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.MaSP" />
                            <input type="hidden" name="quantity" value="1" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Shop")" />
                            @if (showSizeOptions)
                            {
                                <fieldset class="shop-card-size-options mb-2">
                                    <legend class="sr-only">Chọn kích cỡ cho @product.TenSP</legend>
                                    @foreach (var variant in product.Variants)
                                    {
                                        var isSelected = variant.MaBienThe == selectedVariant?.MaBienThe;
                                        <label class="shop-card-size-option">
                                            <input type="radio" name="variantId" value="@variant.MaBienThe"
                                                   data-price="@variant.GiaBan" checked="@isSelected" />
                                            <span>@variant.KichCo</span>
                                        </label>
                                    }
                                </fieldset>
                            }
                            else
                            {
                                <input type="hidden" name="variantId" value="@(selectedVariant?.MaBienThe ?? product.Variants.FirstOrDefault()?.MaBienThe ?? 0)" />
                            }
                            <p class="price shop-card-price mb-3">
                                <span class="shop-card-current-price">@(selectedVariant == null ? "Liên hệ" : selectedVariant.GiaBan.ToString("N0") + " đ")</span>
                            </p>
                            <button type="submit"
                                    class="btn btn-primary btn-outline-primary btn-sm shop-card-add-button"
                                    disabled="@(isOutOfStock || selectedVariant == null)"
                                    aria-label="@(isOutOfStock ? $"Món {product.TenSP} hết hàng" : selectedVariant == null ? $"Món {product.TenSP} chưa có giá bán" : $"Thêm {product.TenSP} vào giỏ hàng")">
                                @if (isOutOfStock)
                                {
                                    <span>Hết hàng</span>
                                }
                                else if (selectedVariant == null)
                                {
                                    <span>Chưa có giá</span>
                                }
                                else
                                {
                                    <i class="icon-shopping_cart mr-1" aria-hidden="true"></i>
                                    <span>Thêm vào giỏ</span>
                                }
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <h4>Không có món phù hợp.</h4>
            <a asp-action="Index" class="btn btn-primary mt-3">Xem toàn bộ thực đơn</a>
        </div>
    }
</div>
