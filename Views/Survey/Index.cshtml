@model List<CoffeeShop.Models.Entities.Survey>
@{
    ViewData["Title"] = "Khảo sát ý kiến khách hàng";
}

<section class="ftco-section survey-page">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-8 text-center">
                <div class="survey-intro">
                    <span class="survey-eyebrow">Lắng nghe và thấu hiểu</span>
                    <h1>Khảo sát ý kiến khách hàng</h1>
                    <p>Hoàn thành khảo sát để nhận <strong>50 điểm tích lũy</strong>.</p>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="survey-empty-state text-center">
                <span class="survey-empty-icon icon ion-ios-chatbubbles-outline" aria-hidden="true"></span>
                <h3>Hiện không có khảo sát dành cho bạn</h3>
                <p>Các khảo sát mới sẽ xuất hiện tại đây khi được mở.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Khám phá thực đơn</a>
            </div>
        }
        else
        {
            @foreach (var survey in Model)
            {
                <section class="survey-card">
                    <span class="badge badge-gold-outline survey-deadline">Đang mở đến @survey.NgayKetThuc.ToString("dd/MM/yyyy HH:mm")</span>
                    <h2>@survey.TieuDe</h2>
                    @if (!string.IsNullOrWhiteSpace(survey.MoTa))
                    {
                        <p class="survey-description">@survey.MoTa</p>
                    }
                    <form asp-action="SubmitSurvey" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="surveyId" value="@survey.MaKhaoSat" />
                        @for (var index = 0; index < survey.Questions.Count; index++)
                        {
                            var question = survey.Questions.OrderBy(item => item.ThuTu).ElementAt(index);
                            <fieldset class="survey-question">
                                <legend>Câu @(index + 1): @question.NoiDungCauHoi</legend>
                                @if (question.LoaiCauHoi == "SAO")
                                {
                                    var ratingDescriptionId = $"survey-rating-description-{survey.MaKhaoSat}-{question.MaCauHoi}";
                                    <div class="survey-rating" role="radiogroup" aria-describedby="@ratingDescriptionId">
                                        <div class="survey-rating-options">
                                            @for (var rating = 1; rating <= 5; rating++)
                                            {
                                                <label class="survey-rating-option">
                                                    <input type="radio" name="answers[@question.MaCauHoi]" value="@rating" required aria-label="@rating trên 5" />
                                                    <span class="survey-rating-choice">
                                                        <span class="survey-rating-number">@rating</span>
                                                        <span class="survey-rating-star" aria-hidden="true">★</span>
                                                    </span>
                                                </label>
                                            }
                                        </div>
                                        <div class="survey-rating-endpoints" id="@ratingDescriptionId">
                                            <span>Rất không hài lòng</span>
                                            <span>Rất hài lòng</span>
                                        </div>
                                    </div>
                                }
                                else if (question.LoaiCauHoi == "TU_LUAN")
                                {
                                    <textarea name="answers[@question.MaCauHoi]" class="form-control" rows="3" maxlength="4000" required placeholder="Nhập câu trả lời"></textarea>
                                }
                                else
                                {
                                    @foreach (var option in question.Options.OrderBy(item => item.ThuTu))
                                    {
                                        var inputType = question.LoaiCauHoi == "NHIEU_LUA_CHON" ? "checkbox" : "radio";
                                        <label class="survey-answer-option">
                                            <input type="@inputType" name="answers[@question.MaCauHoi]" value="@option.NoiDung" @(question.LoaiCauHoi == "NHIEU_LUA_CHON" ? "" : "required") />
                                            <span>@option.NoiDung</span>
                                        </label>
                                    }
                                }
                            </fieldset>
                        }
                        <div class="survey-submit-row">
                            <button type="submit" class="btn btn-primary py-2 px-4">Gửi câu trả lời</button>
                            <span class="survey-submit-note">Ý kiến của bạn giúp chúng tôi phục vụ tốt hơn.</span>
                        </div>
                    </form>
                </section>
            }
        }
    </div>
</section>

<script>
    document.querySelectorAll('form[action*="SubmitSurvey"]').forEach(form => form.addEventListener('submit', event => {
        const groups = new Map();
        form.querySelectorAll('input[type="checkbox"]').forEach(input => {
            if (!groups.has(input.name)) groups.set(input.name, []);
            groups.get(input.name).push(input);
        });
        for (const [name, inputs] of groups) {
            if (!inputs.some(input => input.checked)) {
                event.preventDefault();
                inputs[0].focus();
                alert('Vui lòng chọn ít nhất một đáp án cho mỗi câu hỏi nhiều lựa chọn.');
                break;
            }
        }
    }));
</script>
