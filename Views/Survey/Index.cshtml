@model List<CoffeeShop.Models.Entities.Survey>
@{
    ViewData["Title"] = "Khảo sát ý kiến khách hàng";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-8 text-center">
                <span class="subheading" style="color:#c49b63">Lắng nghe và thấu hiểu</span>
                <h1 class="text-white">Khảo sát ý kiến khách hàng</h1>
                <p class="text-muted">Hoàn thành khảo sát để nhận 50 điểm tích lũy.</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h3 class="text-white">Hiện không có khảo sát dành cho bạn</h3>
                <p class="text-muted">Các khảo sát mới sẽ xuất hiện tại đây khi được mở.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Khám phá thực đơn</a>
            </div>
        }
        else
        {
            @foreach (var survey in Model)
            {
                <section class="p-4 p-md-5 mb-4 rounded" style="background:#171412;border:1px solid rgba(196,155,99,.35)">
                    <span class="badge badge-gold-outline">Đang mở đến @survey.NgayKetThuc.ToString("dd/MM/yyyy HH:mm")</span>
                    <h2 class="text-white mt-3">@survey.TieuDe</h2>
                    @if (!string.IsNullOrWhiteSpace(survey.MoTa))
                    {
                        <p class="text-muted">@survey.MoTa</p>
                    }
                    <form asp-action="SubmitSurvey" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="surveyId" value="@survey.MaKhaoSat" />
                        @for (var index = 0; index < survey.Questions.Count; index++)
                        {
                            var question = survey.Questions.OrderBy(item => item.ThuTu).ElementAt(index);
                            <fieldset class="form-group py-3" style="border-bottom:1px solid rgba(255,255,255,.1)">
                                <legend class="text-white" style="font-size:1rem">Câu @(index + 1): @question.NoiDungCauHoi</legend>
                                @if (question.LoaiCauHoi == "SAO")
                                {
                                    <div class="d-flex flex-wrap" style="gap:12px">
                                        @for (var rating = 5; rating >= 1; rating--)
                                        {
                                            <label class="text-white">
                                                <input type="radio" name="answers[@question.MaCauHoi]" value="@rating" required />
                                                <span style="color:#ffc107">@(new string('★', rating))</span> @rating/5
                                            </label>
                                        }
                                    </div>
                                }
                                else if (question.LoaiCauHoi == "TU_LUAN")
                                {
                                    <textarea name="answers[@question.MaCauHoi]" class="form-control" rows="3" maxlength="4000" required placeholder="Nhập câu trả lời"></textarea>
                                }
                                else
                                {
                                    @foreach (var option in question.Options.OrderBy(item => item.ThuTu))
                                    {
                                        var inputType = question.LoaiCauHoi == "NHIEU_LUA_CHON" ? "checkbox" : "radio";
                                        <label class="d-block text-white mb-2">
                                            <input type="@inputType" name="answers[@question.MaCauHoi]" value="@option.NoiDung" @(question.LoaiCauHoi == "NHIEU_LUA_CHON" ? "" : "required") />
                                            @option.NoiDung
                                        </label>
                                    }
                                }
                            </fieldset>
                        }
                        <button type="submit" class="btn btn-primary py-2 px-4">Gửi câu trả lời</button>
                    </form>
                </section>
            }
        }
    </div>
</section>

<script>
    document.querySelectorAll('form[action*="SubmitSurvey"]').forEach(form => form.addEventListener('submit', event => {
        const groups = new Map();
        form.querySelectorAll('input[type="checkbox"]').forEach(input => {
            if (!groups.has(input.name)) groups.set(input.name, []);
            groups.get(input.name).push(input);
        });
        for (const [name, inputs] of groups) {
            if (!inputs.some(input => input.checked)) {
                event.preventDefault();
                inputs[0].focus();
                alert('Vui lòng chọn ít nhất một đáp án cho mỗi câu hỏi nhiều lựa chọn.');
                break;
            }
        }
    }));
</script>
